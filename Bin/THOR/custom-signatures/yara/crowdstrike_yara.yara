        $conf = {d0 01 00 00 02 28 ?? 00 00 0a 6f ?? 00 00 0a 25 6f ?? 00 00 0a 0a 06 6f ?? 00 00 0a 16 31 0d 06 16 6f ?? 00 00 0a 1f 3c fe 01 2b 01 16 0b 28 ?? 00 00 0a 28 ?? 00 00 0a 0c}
        $reg = "UnRegisterClass"
        $bypass = "Bypass"
        $a1 = "Sleep"
        $a2 = "Invoke"
        $a3 = "MemoryStream"
        $a4 = "InitializeArray"
        $a5 = "VirtualProtect"
        $a6 = "Load"
        $a7 = "Write"
        $a8 = "SuppressIldasmAttribute"
        $a9 = "BlockCopy"
        $a10 = "FailFast"
        $a11 = "get_IsAlive"
        $a12 = "ReadByte"
        $a13 = "DebuggingModes"
        $b1 = "FromBase64String"
