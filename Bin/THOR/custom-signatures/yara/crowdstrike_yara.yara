        malware_family = "PhishingLureShortcutLNK"
    strings:
        $tuple1_mac = {50 e0 85 b9 fd ed}
        $tuple1_serial = {9b 9f bd e2}
        $tuple2_mac = {08 00 27 ba 4c bc}
        $tuple2_serial = {aa 0c 92 fc}
        $tuple3_mac = {b4 2e 99 bd 98 2c}
        $tuple3_serial = {ef 0a f5 30}
        $tuple4_mac = {08 00 27 6b f6 a6}
        $tuple4_serial = {45 6c 76 3c}
        $tuple5_mac = {08 00 27 2e 05 1d}
        $tuple5_serial = {7d 5e 8c 5a}
        $tuple6_mac = {08 00 27 ca 0e 17}
        $tuple6_serial = {35 e6 49 10}
        $tuple7_mac = {08 00 27 e6 09 27}
        $tuple7_serial = {e0 8f fa 8c}
    condition:
