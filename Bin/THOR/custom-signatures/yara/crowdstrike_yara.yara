rule CrowdStrike_CSA_230383_01 : alphv alphv_sphynx blackcat ransomware rust 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Windows 32-bit version of ALPHA SPIDER's ALPHV Sphynx Ransomware"
        reports = "CSA-230383"
        version = "202304241709"
        last_modified = "2023-04-24"
        actor = "ALPHA SPIDER"
        malware_family = "AlphvSphynx"
    strings:
        $rustc = "rustc"
        $zstd = "zstd/lib"
        /*
        6a 00           push    0
        6a 00           push    0
        6a 03           push    3 // RPC_C_IMP_LEVEL_IMPERSONATE
        6a 03           push    3 // RPC_C_AUTHN_LEVEL_CALL
        6a 00           push    0
        6a 00           push    0
        6a 0a           push    0x0a // RPC_C_AUTHN_WINNT
        50              push    eax
        e8 ?? ?? ?? ??  call    j_combase_CoSetProxyBlanket
        */
        $CoSetProxyBlanket_call = {
        6a 00
        6a 00
        6a 03
        6a 03
        6a 00
        6a 00
        6a 0a
        }
        /*
        52              push    edx
        6a 00           push    0
        6a 00           push    0
        68 80 00 00 00  push    0x80
        6a 00           push    0
        6a 00           push    0
        6a 00           push    0
        57              push    edi
        50              push    eax
        ff 51 0c        call    dword ptr [ecx+0x0C]
        */
        $ConnectServer_call = {
        6a 00
        6a 00
        68 80 00 00 00
        6a 00
        6a 00
        6a 00
        }
        /*
        8d 44 24 ??      lea     eax, [esp+<phNewToken>]
        50               push    eax             ; phNewToken
        6a 02            push    2               ; TokenType
        6a 03            push    3               ; ImpersonationLevel
        6a 00            push    0               ; lpTokenAttributes
        6a 02            push    2               ; dwDesiredAccess
        ff 74 24 70      push    [esp+<hExistingToken>] ; hExistingToken
        e8 ?? ?? ?? ??   call    DuplicateTokenEx
        */
        $DuplicateTokenEx_call = {
        6a 02
        6a 03
        6a 00
        6a 02
        }
        $lsa_import_0 = "LsaLogonUser"
        $lsa_import_1 = "LsaLookupAuthenticationPackage"
        $lsa_import_2 = "LsaConnectUntrusted"
        $shadow_copy = "SELECT * FROM Win32_ShadowCopy" xor
    condition:
        $rustc and $zstd
        and 3 of ($CoSetProxyBlanket_call, $ConnectServer_call, $DuplicateTokenEx_call, $lsa_import_*, $shadow_copy)
        and filesize > 5MB
}

