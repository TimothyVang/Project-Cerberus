        last_modified = "2024-07-03"
        actor = "DEMON SPIDER"
        malware_family = "Matanbuchus"
    strings:
        // FNV1a hash (0xa1f07e4c) of Windows CoCreateInstance() function
        $fnv1a_function_cocreateinstance = {
        4c 7e f0 a1
        }
        // FNV1a hash (0x48FA5D5C) of Windows VariantInit() function
        $fnv1a_function_variantinit = {
        5c 5d fa 48
        }
        // FNV1a hash (0x4268688F) of Windows GetLocalTime() function
        $fnv1a_function_getlocaltime = {
        8f 68 68 42
        }
        // FNV1a hash (0xf642e4f7) of Windows ExpandEnvironmentStringsW() function
        $fnv1a_function_expandenvironmentstringsw = {
        f7 e4 42 f6
        }
        // FNV1a hash (0x93CD611A) of Windows StrSpnA function
        $fnv1a_function_strspna = {
        1a 61 cd 93
        }
        // FNV1a hash (0x61621C06) of Windows IsBadReadPtr function
        $fnv1a_function_isbadreadptr = {
        06 1c 62 61
        }
        // FNV1a hash (0x0AFCF12AA) of Windows PathIsDirectoryW function
        $fnv1a_function_pathisdirectoryw = {
        aa 12 cf af
        }
        // FNV1a hash (0x960CB4C6) of Windows InternetReadFile function
        $fnv1a_function_internetreadfile = {
        c6 b4 0c 96
        }
        // Regular expression for PDB path
        $pdb_str_1 = /B:\\LoadDll\\Release\\[0-9]{4}.pdb/ ascii
        // PDB path observed with unique typo
        $pdb_str_2 = "B:\\LoadDll\\Release\\BELIAL].pdb" ascii
        // DllRegisterServer export
        $export_dllregisterserver = "DllRegisterServer" ascii
        // DllUnregisterServer export
        $export_dllunregisterserver = "DllUnregisterServer" ascii
        // RegisterDLL export
        $export_registerdll = "RegisterDll" ascii
        // UnregisterDll export
        $export_unregisterdll = "UnregisterDll" ascii
        // DllInstall export
        $export_dllinstall = "DllInstall" ascii
        // CPlApplet (Windows Control Panel Item) export
        $export_cplapplet = "CPlApplet" ascii
        // CheckLicense export
        $export_checklicense = "CheckLicense" ascii
        // InitModule export
        $export_initmodule = "InitModule" ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        (4 of ($fnv1a_*) and 2 of ($export_*)) or
        (3 of ($fnv1a_*) and 1 of ($export_*) and 1 of ($pdb_str_*))
}

