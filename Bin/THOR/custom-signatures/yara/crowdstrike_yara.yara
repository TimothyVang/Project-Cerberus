import "elf"

rule CrowdStrike_CSA_240441_04 : lightbasin sshd toxicshot 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Dynamically linked ELF files modified by ToxicShot"
        reports = "CSA-240441"
        version = "202504040946"
        last_modified = "2025-04-04"
    condition:
        elf.type == elf.ET_DYN
        and elf.entry_point < filesize
        and elf.number_of_sections > 0
        and elf.dynamic_section_entries >= 2
        and for any i in (1..elf.dynamic_section_entries-1):
        (
        elf.dynamic[i].type == elf.DT_NEEDED
        and elf.dynamic[i].val > 0
        and elf.dynamic[i].val == elf.dynamic[0].val - 3
        )
}

