rule CrowdStrike_LightBasin_sparc_shellcode : lightbasin 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Embedded SPARC shellcode from a Solaris 10/11 remote SunSSHD exploit"
        version = "202408011137"
        last_modified = "2024-08-01"
        activity_cluster = "LightBasin"
    strings:
        /*
        and     %l7, %l7, %l3
        and     %l7, %l7, %o0
        and     %l6, %l6, %o1
        mov     0x10, %l5
        and     %l6, %l6, %o2
        st      %l5, [%o2+%l5]
        mov     1, %o3
        mov     0xF3, %g1
        ta      8
        */
        $ = { a6 0d c0 17 90 0d c0 17 92 0d 80 16 aa 10 20 10 94 0d 80 16 ea 22 80 15 96 10 20 01 82 10 20 f3 91 d0 20 08 }
        /*
        and     %l3, %l3, %o0
        add     %sp, %l6, %o1
        mov     0xFF, %o2
        mov     4, %g1
        ta      8
        */
        $ = { 90 0c c0 13 92 03 80 16 94 10 20 ff 82 10 20 04 91 d0 20 08 }
        /*
        inc     -1, %l7
        cmp     %l7, 1
        bne     loc_88
        btog    %o1, %o1
        and     %l3, %l3, %o0
        mov     9, %o1
        xor     %l7, %l7, %o2
        mov     0x3E, %g1 ! '>'
        ta      8
        */
        $ = { ae 05 ff ff 80 a5 e0 01 12 bf ff f9 92 1a 40 09 90 0c c0 13 92 10 20 09 94 1d c0 17 82 10 20 3e 91 d0 20 08 }
        /*
        and     %l3, %l3, %o0
        mov     9, %o1
        mov     1, %o2
        ta      8
        */
        $ = { 90 0c c0 13 92 10 20 09 94 10 20 01 91 d0 20 08 }
        /*
        and     %l3, %l3, %o0
        mov     9, %o1
        mov     2, %o2
        ta      8
        */
        $ = { 90 0c c0 13 92 10 20 09 94 10 20 02 91 d0 20 08 }
        /*
        mov     0x2A, %l7 ! '*'
        and     %l7, %l7, %o0
        mov     6, %g1
        ta      8
        */
        $ = { ae 10 20 2a 90 0d c0 17 82 10 20 06 91 d0 20 08 }
    condition:
        4 of them
}

