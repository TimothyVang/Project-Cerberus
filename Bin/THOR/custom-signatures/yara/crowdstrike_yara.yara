rule CrowdStrike_CSA_230495_01 : downloader macos p_df_unfolder pdf_unfolder stardust_chollima 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Malicious MacOS PDF reader. Expects to read a PDF crafted in a certain format, then download from an encoded URL embedded in the PDF"
        reports = "CSA-230495"
        version = "202411121722"
        last_modified = "2024-11-12"
        actor = "STARDUST CHOLLIMA"
        malware_family = "PDFUnfolder"
    strings:
        $macho_magic_number_single_arch_64 = { cf fa ed fe } // MH_MAGIC_64, 64-bit with same endianness as host
        $macho_magic_number_multi_arch = { ca fe ba be } // Mach-O universal binary with multiple architectures
        $objc_pdfkit_0 = "setDisplayMode"
        $objc_pdfkit_1 = "setAutoresizingMask"
        $objc_pdfkit_2 = "scrollPoint:"
        $objc_pdfkit_3 = "_OBJC_CLASS_$_PDFView"
        $objc_http_0 = "setValue:forHTTPHeaderField:"
        $objc_http_1 = "setHTTPBody:"
        $xor_key_x86_64_0 = { 34 db 4a 18 }
        $xor_key_x86_64_1 = { 40 3d a8 47 }
        $xor_key_x86_64_2 = { 32 67 ec a5 }
        $xor_key_x86_64_3 = { 8f 8d 73 14 }
        $xor_key_x86_64_4 = { 0a fd 89 c5 }
        $xor_key_arm64_0 = { ?? 66 9b 52 ?? 09 a3 72 } // MOV Wn, #0x184adb34
        $xor_key_arm64_1 = { ?? a8 87 52 ?? f5 a8 72 } // MOV Wn, #0x47a83d40
        $xor_key_arm64_2 = { ?? e6 8c 52 ?? bd b4 72 } // MOV Wn, #0xa5ec6732
        $xor_key_arm64_3 = { ?? b1 91 52 ?? 8e a2 72 } // MOV Wn, #0x14738d8f
        $xor_key_arm64_4 = { ?? a1 9f 52 ?? b1 b8 72 } // MOV Wn, #0xc589fd0a
    condition:
        ($macho_magic_number_single_arch_64 at 0 or $macho_magic_number_multi_arch at 0)
        and 4 of ($objc_pdfkit_*, $objc_http_*)
        and (3 of ($xor_key_x86_64_*) or 3 of ($xor_key_arm64_*))
}

