        last_modified = "2025-05-21"
        malware_family = "LummaStealer"
    strings:
        $win1 = "Windows 2000" fullword ascii
        $win2 = "Windows XP 32" fullword ascii
        $win3 = "Windows XP Professional 64" fullword ascii
        $win4 = "Windows Server 2003" fullword ascii
        $win5 = "Windows Vista" fullword ascii
        $win6 = "Windows 7" fullword ascii
        $win7 = "Windows Server 2008 R2" fullword ascii
        $win8 = "Windows 8" fullword ascii
        $win9 = "Windows Server 2012" fullword ascii
        $win10 = "Windows 8.1" fullword ascii
        $win11 = "Windows Server 2012 R2" fullword ascii
        $win12 = "Windows 10" fullword ascii
        $win13 = "Windows Server 2016" fullword ascii
        $b1 = {fe 05 2e 8e }  // NtQueryInformationFile in ntdll.dll
        $b2 = {fe fa 6a 7c }  // NtReadFile in ntdll.dll
        $b3 = {41 f1 81 ee }  // ZwClose in ntdll.dll
        $b4 = {05 f5 28 73 }  // GetEnvironmentStringsW in kernel32.dll
        $b5 = {6c 77 87 ab }  // LoadLibraryW in kernel32.dll
        $b6 = {c1 a0 68 e2 }  // WinHttpSetTimeouts in Winhttp.dll
        $b7 = {c2 48 70 50 }  // WinHttpOpenRequest in Winhttp.dll
        $b8 = {40 9f ca b5 }  // NtCreateFile in ntdll.dll
        $b9 = {9f 80 bf 77 }  // RtlNtStatusToDosError in ntdll.dll
    condition:
        uint16(0) == 0x5a4d and
        (5 of($b*) or all of($win*)) and filesize < 1MB
}

