rule CrowdStrike_CSIT_23357_01 : blinding_dart lightbasin stealthproxy 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "RC4-drop implementation of BlindingDart and StealthProxy"
        reports = "CSIT-23357"
        version = "202410210845"
        last_modified = "2024-10-21"
        malware_family = "BlindingDart"
        activity_cluster = "LightBasin"
    strings:
        /*
        Filling buffer with 0x505 "W" characters
        49 bd 57 57 57 57 57 57 mov     r13, 5757575757575757h
        57 57
        4c 89 7c 24 f8          mov     [rsp+var_8], r15
        48 81 ec 28 02 00 00    sub     rsp, 228h
        4c 89 e8                mov     rax, r13
        49 89 fc                mov     r12, rdi
        48 89 e7                mov     rdi, rsp
        41 89 d7                mov     r15d, edx
        f3 48 ab                rep stosq
        */
        $ = {49 bd 57 57 57 57 57 57 57 57 4c 89 7c 24 f8 48 81 ec 28 02 00 00 4c 89 e8 49 89 fc 48 89 e7 41 89 d7 f3 48 ab }
        /*
        Beginning of RC4 KSA code
        41 56                   push    r14
        b9 81 00 00 00          mov     ecx, 81h
        31 c0                   xor     eax, eax
        49 89 fe                mov     r14, rdi
        41 55                   push    r13
        f3 48 ab                rep stosq
        41 54                   push    r12
        55                      push    rbp
        89 f5                   mov     ebp, esi
        53                      push    rbx
        48 89 d3                mov     rbx, rdx
        31 d2                   xor     edx, edx
        */
        $ = {41 56 b9 81 00 00 00 31 c0 49 89 fe 41 55 f3 48 ab 41 54 55 89 f5 53 48 89 d3 31 d2 }
        /*
        Beginning of RC4 PRGA/encrypt code
        41 55                   push    r13
        48 89 f0                mov     rax, rsi
        49 89 f9                mov     r9, rdi
        48 c1 e8 03             shr     rax, 3
        49 89 d3                mov     r11, rdx
        41 54                   push    r12
        85 c0                   test    eax, eax
        41 89 c5                mov     r13d, eax
        55                      push    rbp
        48 89 f5                mov     rbp, rsi
        53                      push    rbx
        48 89 cb                mov     rbx, rcx
        44 8b 07                mov     r8d, [rdi]
        8b 7f 04                mov     edi, [rdi+4]
        */
        $ = {41 55 48 89 f0 49 89 f9 48 c1 e8 03 49 89 d3 41 54 85 c0 41 89 c5 55 48 89 f5 53 48 89 cb 44 8b 07 8b 7f 04 }
    condition:
        uint32(0) == 0x464c457f
        and 2 of them and
        filesize < 50MB
}

