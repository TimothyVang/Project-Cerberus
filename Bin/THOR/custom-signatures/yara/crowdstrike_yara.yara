rule CrowdStrike_TaurusStealer_APIHash : infostealer stealer taurusstealer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "CRC32 API hash logic and constants used by the Taurus Project Infostealer and similar stealer variants"
        version = "202503111353"
        last_modified = "2025-03-11"
        malware_family = "TaurusStealer"
    strings:
        // CRC32 logic used in API hash function
        // 0F BE C0              movsx   eax, al
        // 33 C7                 xor     eax, edi
        // C1 EF 08              shr     edi, 8
        // 0F B6 C0              movzx   eax, al
        // 33 3C 85 B0 0C 42 00  xor     edi, ds:dword_420CB0[eax*4]
        // 42                    inc     edx
        // 8A 02                 mov     al, [edx]
        // 84 C0                 test    al, al
        // 75 E7                 jnz     short loc_40171E
        $api_hash_crc32_instructions = { 0F BE C0 33 C7 C1 EF 08 0F B6 C0 33 [6] 42 8A 02 84 C0 75 }
        // CRC32 logic with alternate registers
        // 0F BE C0                                movsx   eax, al
        // 33 C2                                   xor     eax, edx
        // C1 EA 08                                shr     edx, 8
        // 0F B6 C0                                movzx   eax, al
        // 33 14 85 B0 FC 42 00                    xor     edx, ds:dword_42FCB0[eax*4]
        // 41                                      inc     ecx
        // 8A 01                                   mov     al, [ecx]
        // 84 C0                                   test    al, al
        // 75 E7                                   jnz     short loc_401E2B
        $api_hash_crc32_instructions_alt = { 0F BE C0 33 C2 C1 EA 08 0F B6 C0 33 [6] 41 8A 01 84 C0 75 }
        // CRC32 table for API hashing
        $api_hash_crc32_table = { 00 00 00 00 6A 7A 04 41 D4 F4 08 82 BE 8E 0C C3 DF EF 60 DF B5 95 64 9E 0B 1B 68 5D 61 61 6C 1C C9 D9 B0 65 A3 A3 B4 24 1D 2D B8 E7 77 57 BC A6 16 36 D0 BA 7C 4C D4 FB C2 C2 D8 38 A8 B8 DC 79 92 B3 61 CB F8 C9 65 8A 46 47 69 49 2C 3D 6D 08 4D 5C 01 14 27 26 05 55 99 A8 09 96 F3 D2 0D D7 5B 6A D1 AE 31 10 D5 EF 8F 9E D9 2C E5 E4 DD 6D 84 85 B1 71 EE FF B5 30 50 71 B9 F3 3A 0B BD B2 53 61 B2 4D 39 1B B6 0C 87 95 BA CF ED EF BE 8E 8C 8E D2 92 E6 F4 D6 D3 58 7A DA 10 32 00 DE 51 9A B8 02 28 F0 C2 06 69 4E 4C 0A AA 24 36 0E EB 45 57 62 F7 2F 2D 66 B6 91 A3 6A 75 FB D9 6E 34 C1 D2 D3 86 AB A8 D7 C7 15 26 DB 04 7F 5C DF 45 1E 3D B3 59 74 47 B7 18 CA C9 BB DB A0 B3 BF 9A 08 0B 63 E3 62 71 67 A2 DC FF 6B 61 B6 85 6F 20 D7 E4 03 3C BD 9E 07 7D 03 10 0B BE 69 6A 0F FF A6 C2 64 9B CC B8 60 DA 72 36 6C 19 18 4C 68 58 79 2D 04 44 13 57 00 05 AD D9 0C C6 C7 A3 08 87 6F 1B D4 FE 05 61 D0 BF BB EF DC 7C D1 95 D8 3D B0 F4 B4 21 DA 8E B0 60 64 00 BC A3 0E 7A B8 E2 34 71 05 50 5E 0B 01 11 E0 85 0D D2 8A FF 09 93 EB 9E 65 8F 81 E4 61 CE 3F 6A 6D 0D 55 10 69 4C FD A8 B5 35 97 D2 B1 74 29 5C BD B7 43 26 B9 F6 22 47 D5 EA 48 3D D1 AB F6 B3 DD 68 9C C9 D9 29 F5 A3 D6 D6 9F D9 D2 97 21 57 DE 54 4B 2D DA 15 2A 4C B6 09 40 36 B2 48 FE B8 BE 8B 94 C2 BA CA 3C 7A 66 B3 56 00 62 F2 E8 8E 6E 31 82 F4 6A 70 E3 95 06 6C 89 EF 02 2D 37 61 0E EE 5D 1B 0A AF 67 10 B7 1D 0D 6A B3 5C B3 E4 BF 9F D9 9E BB DE B8 FF D7 C2 D2 85 D3 83 6C 0B DF 40 06 71 DB 01 AE C9 07 78 C4 B3 03 39 7A 3D 0F FA 10 47 0B BB 71 26 67 A7 1B 5C 63 E6 A5 D2 6F 25 CF A8 6B 64 3B 83 B8 ED 51 F9 BC AC EF 77 B0 6F 85 0D B4 2E E4 6C D8 32 8E 16 DC 73 30 98 D0 B0 5A E2 D4 F1 F2 5A 08 88 98 20 0C C9 26 AE 00 0A 4C D4 04 4B 2D B5 68 57 47 CF 6C 16 F9 41 60 D5 93 3B 64 94 A9 30 D9 26 C3 4A DD 67 7D C4 D1 A4 17 BE D5 E5 76 DF B9 F9 1C A5 BD B8 A2 2B B1 7B C8 51 B5 3A 60 E9 69 43 0A 93 6D 02 B4 1D 61 C1 DE 67 65 80 BF 06 09 9C D5 7C 0D DD 6B F2 01 1E 01 88 05 5F 68 E2 0A A0 02 98 0E E1 BC 16 02 22 D6 6C 06 63 B7 0D 6A 7F DD 77 6E 3E 63 F9 62 FD 09 83 66 BC A1 3B BA C5 CB 41 BE 84 75 CF B2 47 1F B5 B6 06 7E D4 DA 1A 14 AE DE 5B AA 20 D2 98 C0 5A D6 D9 FA 51 6B 6B 90 2B 6F 2A 2E A5 63 E9 44 DF 67 A8 25 BE 0B B4 4F C4 0F F5 F1 4A 03 36 9B 30 07 77 33 88 DB 0E 59 F2 DF 4F E7 7C D3 8C 8D 06 D7 CD EC 67 BB D1 86 1D BF 90 38 93 B3 53 52 E9 B7 12 9D 41 DC 76 F7 3B D8 37 49 B5 D4 F4 23 CF D0 B5 42 AE BC A9 28 D4 B8 E8 96 5A B4 2B FC 20 B0 6A 54 98 6C 13 3E E2 68 52 80 6C 64 91 EA 16 60 D0 8B 77 0C CC E1 0D 08 8D 5F 83 04 4E 35 F9 00 0F 0F F2 BD BD 65 88 B9 FC DB 06 B5 3F B1 7C B1 7E D0 1D DD 62 BA 67 D9 23 04 E9 D5 E0 6E 93 D1 A1 C6 2B 0D D8 AC 51 09 99 12 DF 05 5A 78 A5 01 1B 19 C4 6D 07 73 BE 69 46 CD 30 65 85 A7 4A 61 C4 CE 20 6E 3B A4 5A 6A 7A 1A D4 66 B9 70 AE 62 F8 11 CF 0E E4 7B B5 0A A5 C5 3B 06 66 AF 41 02 27 07 F9 DE 5E 6D 83 DA 1F D3 0D D6 DC B9 77 D2 9D D8 16 BE 81 B2 6C BA C0 0C E2 B6 03 66 98 B2 42 5C 93 0F F0 36 E9 0B B1 88 67 07 72 E2 1D 03 33 83 7C 6F 2F E9 06 6B 6E 57 88 67 AD 3D F2 63 EC 95 4A BF 95 FF 30 BB D4 41 BE B7 17 2B C4 B3 56 4A A5 DF 4A 20 DF DB 0B 9E 51 D7 C8 F4 2B D3 89 }
        // Hardcoded table of DLL names used in API resolution
        $dll_string0 = "Kernel32.dll"
        $dll_string1 = "Shell32.dll"
        $dll_string2 = "Crypt32.dll"
        $dll_string3 = "Wininet.dll"
        $dll_string4 = "Advapi32.dll"
        $dll_string5 = "gdiplus.dll"
        $dll_string6 = "Gdi32.dll"
        $dll_string7 = "User32.dll"
        $dll_string8 = "Ole32.dll"
        $dll_string9 = "Bcrypt.dll"
        $dll_string10 = "Urlmon.dll"
        $dll_string11 = "Vaultcli.dll"
    condition:
        uint16(0) == 0x5A4D and
        ($api_hash_crc32_instructions or $api_hash_crc32_instructions_alt) and
        $api_hash_crc32_table and
        5 of ($dll_string*)
}

import "pe"

rule CrowdStrike_SFXPK : packer sfx 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects 7zip SFX footer followed immediately by ZIP file header, followed later by 7zip header"
        version = "202202181450"
        last_modified = "2022-02-18"
    strings:
        $sfx0 = "!Require Windows"
        $sfx1 = ";!@Install@!"
        $sfx2 = "7z SFX: "
        $sfx3 = "GUIMode=\"2\""
        $sfx4 = "RunProgram="
        $install_footer = ";!@InstallEnd@!\x0d\x0aPK\x03\x04"
        $archive_header = {377ABCAF271C}
    condition:
        all of them
        and $sfx0 at 0x4D
        and @install_footer > pe.overlay.offset
        and @install_footer < pe.overlay.offset + 0x400
        and @archive_header > @install_footer + 0x200
}

rule CrowdStrike_SevenZipStealer_01 : downloader infostealer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "narrow rule for strings from information stealer utilizing 7zip code to package exfiltrated data"
        version = "202202181450"
        last_modified = "2022-02-18"
        malware_family = "SevenZipStealer"
    strings:
        $sz_ins_crypto_rand = {0FB6C003470469C00584080840}
        $sz_ins_crypto_seed = {
        C7 [1-2] 89 67 45 23
        C7 [1-2] 78 56 34 12
        C7 [1-2] 90 78 56 34
        }
        $sz_ins_01 = {C1E00533C8B8FF7F000023C8}
        $sz_ins_02 = {B9F7FF00006623C1}
        $sz_str_00 = "ct_init: length != 256"
        $sz_str_01 = "ct_init: dist != 256"
        $sz_str_02 = "ct_init: 256+dist != 512"
        $sz_str_03 = "inconsistent bit counts"
        $sz_str_04 = "not enough codes"
        $sz_str_05 = "too many codes"
        $sz_str_06 = "bad compressed size"
        $sz_str_07 = "ct_tally: bad match"
        $sz_str_08 = "bad d_code"
        $sz_str_09 = "invalid length"
        $sz_str_10 = "output buffer too small for in-memory compression"
        $api_01 = "URLDownloadToFile"
        $api_02 = "CryptUnprotectData"
        $api_03 = "ExpandEnvironmentStrings"
        $api_04 = "HttpSendRequest"
        $chrome_cookie_decrypt_1 = "encrypted_key"
        $chrome_cookie_decrypt_2 = "os_crypt"
        $post1 = "Content-Disposition: form-data; name=\"file\"; filename=\"%lu.zip\""
        $post2 = "Content-Type: multipart/form-data; boundary=---------------------------%lu"
        $post3 = "\x0D\x0A-----------------------------%lu--\x0D\x0A"
        $info_str_01 = "UserName [ComputerName]: " wide
        $info_str_02 = "Data [Time]:             " wide
        $info_str_03 = "OS:                      " wide
        $info_str_04 = "Keyboard Languages:      " wide
        $info_str_05 = "CPU:                     " wide
        $info_str_06 = "RAM:                     " wide
        $info_str_07 = "GPU:                     " wide
        $info_str_08 = "Display Resolution:      " wide
    condition:
        any of them
        and all of ($chrome_cookie_decrypt*)
        and 2 of ($post*)
        and 5 of ($info_str*)
        and (
        2 of ($sz_ins*) or
        5 of ($sz_str*))
        and all of ($api*)
}

