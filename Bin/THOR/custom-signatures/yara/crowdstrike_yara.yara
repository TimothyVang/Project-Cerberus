        $dex_header = { 64 65 78 0a 30 ?? ?? 00 } // dex\n0??\0
        // uninstall message in plain ascii or base64 encoded, prepended whitespaces or EoL indicators removal have been observed
        $uninstall_1 = "After the cancellation will affect the stability of the system!"
        $uninstall_2 = "QWZ0ZXIgdGhlIGNhbmNlbGxhdGlvbiB3aWxsIGFmZmVjdCB0aGUgc3RhYmlsaXR5IG9mIHRoZSBzeXN0ZW0h" // base64 without EoL
