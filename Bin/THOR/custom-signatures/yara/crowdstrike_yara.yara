rule CrowdStrike_SlyShopLoader_01 : downloader sly_shop_loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "opcode sequences from heavily obfuscated downloader and likely information stealer malware"
        reports = "CSA-241410"
        version = "202411291413"
        last_modified = "2024-11-29"
        malware_family = "SlyShopLoader"
    strings:
        $ = {
        41 b8 00 00 00 00           // mov     r8d, 0
        ba 01 00 00 00              // mov     edx, 1
        b9 02 00 00 00              // mov     ecx, 2
        48 8b 05 ?? ?? ?? ??        // mov     rax, socket
        ff d0                       // call    rax
        48 83 f8 ff                 // cmp     rax, -1
        0f 84 ?? ?? ?? ??           // jz      SOCKET_FAILED
        48 89 05 ?? ?? ?? ??        // mov     cs:SOCKET, rax
        }
        $= {
        e8 ?? ?? ??                 // call    rand
        (?? 99 | ??)                // cdq
        f7 3d ?? ?? ?? ??           // idiv    C2_COUNT
        48 8d 0d ?? ?? ?? ??        // lea     rcx, C2_ARRAY
        8b 0c 91                    // mov     ecx, [rcx+rdx*4]
        66 c7 85 ?? ?? ff ff 02 00  // mov     word ptr [rbp-??], 2
        66 c7 85 ?? ?? ff ff 01 bb  // mov     word ptr [rbp-??], 0BB01h
        89 8d ?? ?? ff ff           // mov     [rbp-??], ecx
        }
    condition:
        all of them
}

