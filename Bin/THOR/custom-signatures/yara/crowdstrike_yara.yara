rule CrowdStrike_CSA_230387_01 : driver labyrinth_chollima syn_pool 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects strings and byte sequences in SynPool malware used by LABYRINTH CHOLLIMA"
        reports = "CSA-230387"
        version = "202411121722"
        last_modified = "2024-11-12"
        actor = "LABYRINTH CHOLLIMA"
        malware_family = "SynPool"
    strings:
        /*
        BA 64 61 45 64  mov edx, 0x64456164 // 'dEad'
        */
        $kernel_deallocate_memory_pool_tag_0 = { ba 64 61 45 64 }
        $fltmgr_driver_0 = "fltmgr.sys"
        $fltmgr_driver_1 = "FltGetRoutineAddress"
        $fltmgr_driver_2 = "FltEnumerateFilters"
        $fltmgr_driver_3 = "FltGetFilterInformation"
        $fltmgr_driver_4 = "FltObjectDereference"
        $fltmgr_driver_5 = "FltUnregisterFilter"
        $catroot_path_0 = "catroot2\\" wide
        $catroot_path_1 = "edbres.log" wide
        /*
        B8 25 02 00 C0  mov eax, 0x0C0000225
        */
        $retcode_ntstatus_STATUS_NOT_FOUND = { b8 25 02 00 c0 }
    condition:
        $kernel_deallocate_memory_pool_tag_0
        and any of ($fltmgr_driver_*, $catroot_path_*)
