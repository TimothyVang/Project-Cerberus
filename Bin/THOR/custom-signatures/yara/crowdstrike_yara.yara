rule CrowdStrike_CSIT_25187_01 : cve_2025_29824 exploit 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Control Codes and API Functions needed to exploit CVE-2025-29824"
        reports = "CSIT-25187"
        version = "202508150714"
        last_modified = "2025-08-15"
    strings:
        // ensure it's operating with a log file
        $file_substr = "LOG:" ascii wide
        // API calls necessary to exploit the race condition
        $api_SetThreadAffinityMask = "SetThreadAffinityMask\x00" ascii wide
        $api_CreateThread = "CreateThread\x00" ascii wide
        $api_CloseHandle = "CloseHandle\x00" ascii wide
        $api_DeviceIoControl = "DeviceIoControl\x00" ascii wide
        // control codes that trigger this vuln
        $deviceio_1 = {ba 28 70 07 80} //mov edx, 0x80077028
        $deviceio_2 = {ba 56 68 07 80} //mov edx, 0x80076856
    condition:
