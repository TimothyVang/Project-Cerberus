rule CrowdStrike_CSIT_23243_01 : loader pika_bot 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "PikaBot function and anti-analysis code"
        reports = "CSIT-23243"
        version = "202311071651"
        last_modified = "2023-11-07"
        malware_family = "PikaBot"
    strings:
        $code_1 = { 55 8b ec 83 ec 14 53 56 8b f2 57 ff 75 08 8b f9 0f b7 46 14 }
        $code_2 = { 8b 01 40 69 c0 15 cd 5b 07 89 01 c3 }
        $anti_ntflag = { 33 c0 64 a1 30 00 00 00 8b 40 68 83 e0 70 }
        /*
        .text:004088C3 8A 1C 08            mov     bl, [eax+ecx]
        .text:004088C6 8D 43 20            lea     eax, [ebx+20h]
        .text:004088C9 0F B6 C8            movzx   ecx, al
        .text:004088CC 8D 53 BF            lea     edx, [ebx-41h]
        .text:004088CF 80 FA 19            cmp     dl, 19h
        .text:004088D2 0F B6 C3            movzx   eax, bl
        .text:004088D5 0F 47 C8            cmova   ecx, eax
        .text:004088D8 8B 45 FC            mov     eax, [ebp+var_4]
        .text:004088DB 6B F6 05            imul    esi, 5
        .text:004088DE 0F BE C9            movsx   ecx, cl
        .text:004088E1 03 F1               add     esi, ecx
        .text:004088E3 8B 4D F8            mov     ecx, [ebp+var_8]
        .text:004088E6 40          inc     eax
        .text:004088E7 89 45 FC            mov     [ebp+var_4], eax
        .text:004088EA 3B C7               cmp     eax, edi
        .text:004088EC 72 D5               jb      short loc_4088C3
        .text:004088EE 5B          pop     ebx
        */
        $hash_function = {8a 1c 08 8d 43 20 0f b6 c8 8d 53 bf 80 fa 19 0f b6 c3 0f 47 c8 8b 45 fc 6b f6 05 0f be c9 03 f1 8b 4d f8 40 89 45 fc 3b c7 72 d5 5b}
        /*
        .text:004089FE 64 A1 30 00 00 00         mov     eax, large fs:30h
        .text:00408A04 8B 40 0C                  mov     eax, [eax+0Ch]
        .text:00408A07 8B 40 0C                  mov     eax, [eax+0Ch]
        .text:00408A0A 8B 00                     mov     eax, [eax]
        .text:00408A0C 8B 00                     mov     eax, [eax]
        .text:00408A0E 8B 40 18                  mov     eax, [eax+18h]
        .text:00408A11 C3                        retn
        */
        $get_kernel32 = {64 a1 30 00 00 00 8b 40 0c 8b 40 0c 8b 00 8b 00 8b 40 18 c3}
    condition:
        uint16(0) == 0x5a4d and (
        (any of ($code_*) and $anti_ntflag) or
        ($hash_function and $get_kernel32)
        )
}

