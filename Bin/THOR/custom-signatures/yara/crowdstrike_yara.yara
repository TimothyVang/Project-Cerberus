        // FNV1a hash (0x5258823f) of the Windows InternetCheckConnectionA() function for dynamic resolution
        $fnv1a_function_internetcheckconnectiona = { 3f 82 58 52 }
        // FNV1a hash (0xf642e4f7) of Windows ExpandEnvironmentStringsA() function for dynamic resolution
        $fnv1a_function_expandenvironmentstringsa = { f7 e4 42 f6 }
        // FNV1a hash (0x7f07c44a) of Windows WriteFile() function
        $fnv1a_function_writefile = { 4a c4 07 7f }
        // XOR string decoding algorithm for strings initialized in separate functions
        $xor_string_decode_separate = { 33 c1 88 44 24 ?? 48 8b  84 24 [4] 48 8b 8c 24 [4] 48 8D 44 08 01 }
        // XOR string decoding algorithm for strings initialized in-line
        $xor_string_decode_inline = { 33 c1 88 44 24 ?? 48 8b  84 24 [4] 48 8d 84 04 [4] 48 89 84 24 }
        // ShellExecuteA import for executing payload
        $str_shellexeca = "ShellExecuteA"
        // ShellExecuteA verb "open"
        $str_shellexeca_verb = "open"
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        (3 of ($fnv1a_*) and 2 of ($str_*) and 1 of ($xor_*)) or
        (#xor_string_decode_separate > 1 and #xor_string_decode_inline > 1)
}

