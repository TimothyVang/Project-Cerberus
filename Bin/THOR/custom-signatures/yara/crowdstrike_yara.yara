        malware_family = "MoriAgent"
        /*
        DISASSEMBLY:
        mov     ebx, [esi+14h]
        mov     eax, ebx
        mov     cl, [edi]
        mov     edx, [esi+10h]
        sub     cl, 5
        sub     eax, edx
        mov     byte ptr [ebp+var_11], cl
