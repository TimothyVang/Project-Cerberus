        $net1 = "SOCK_DGRAM"
        $net2 = "SOCK_RAW"
        $net3 = "PF_INET"
    condition:
        // `#!/usr/bin/perl\n`
        uint32be(0) == 0x23212f75 and
        uint32be(4) == 0x73722f62 and
        uint32be(8) == 0x696e2f70 and
        uint32be(12) == 0x65726c0a and
        (2 of ($cmd*)) and
        (2 of ($func*)) and
        (2 of ($irc*)) and
        (1 of ($proc*)) and
        (2 of ($feat*)) and
        (2 of ($net*))
}

