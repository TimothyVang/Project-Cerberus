rule CrowdStrike_CSIT_24247_02 : ecrime script uuloader vbs 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings used in vbs scripts deployed by malicious Microsoft installers to install and execute UULoader downloader"
        reports = "CSA-241297,CSIT-24247"
        version = "202411031928"
        last_modified = "2024-11-03"
        malware_family = "UULoader"
    strings:
        /* Operators for junk arithmetic used as obfuscation */
        $arithm_0 = "addResult" ascii
        $arithm_1 = "subResult" ascii
        $arithm_2 = "mulResult" ascii
        $arithm_3 = "divResult" ascii
        $arithm_4 = "modResult" ascii
        /* Object creation variables and specifiers */
        $objs_0 = "objFSO" ascii
        $objs_1 = "WshShell" ascii
        $objs_2 = "\"Scripting.FileSystemObject\"" ascii
        $objs_3 = "\"WScript.Shell\"" ascii
        /* File copy objects and commands */
        $cpy_cmds_0 = "objFSO.CopyFile" ascii
        $cpy_cmds_1 = "WshShell.Run" ascii
        $cpy_cmds_2 = "cmd.exe /c copy /b /y" ascii
        /* Hardcoded command-line parameters for launching Go loaders */
        $cmd_line_0 = "-number 105 -file file3 -mode mode3 -flag flag3" ascii
        /* Variable names for archive extraction versions */
        $7z_var_0 = "zipPackName" ascii
        $7z_var_1 = "runFileName1" ascii
        $7z_var_2 = "runFileName2" ascii
        $7z_var_3 = "extractToPath" ascii
        /* Hardcoded installation paths for files */
        $install_path_0 = "C:\\Program Files (x86)\\Microsoft Thunder\\" ascii
        $install_path_1 = "C:\\Program Files\\Windows Defenderr\\" ascii
        $install_path_2 = "C:\\Program Files\\DevelopBlissfulDealer" ascii
    condition:
        (1 of ($install_path_*)) and
        3 of ($arithm_*) and 3 of ($objs_*) and
        ((2 of ($cpy_cmds_*)) or (1 of ($cmd_line_*) and 2 of ($7z_var_*))) and
        filesize < 6KB
}

