        $str4 = /["']\|V\|["']/
        $link = /https?:\/\//
        $cmd1 = /['"]Cl['"]/
        $cmd2 = /['"]Sc['"]/
        $cmd3 = /['"]Ex['"]/
        $cmd4 = /['"]Rn['"]/
        $cmd5 = /['"]Up['"]/
        $cmd6 = /['"]Un['"]/
        $cmd7 = /['"]RF['"]/
    condition:
        2 of ($str*) and
        6 of ($cmd*) and
        $link and
        filesize < 100KB
}

