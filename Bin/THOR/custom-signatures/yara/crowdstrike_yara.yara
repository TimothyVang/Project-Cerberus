rule CrowdStrike_CSIT_23354_01 : ecrime prophet_spider prophxy proxy unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings and code sequences unique to Prophxy proxy"
        reports = "CSIT-23354"
        version = "202405201644"
        last_modified = "2024-05-20"
        actor = "PROPHET SPIDER"
        malware_family = "Prophxy"
    strings:
        /*
        IP address decoding algorithm from newer
        builds
        */
        $ip_decode = {
        0f b6 [2] 0f b6 [2] 89 d?  28 c? 89 c? 88 [2] 0f b6
        [2] 30 [2] 0f b6 [2] 0f b6  [2] 8d [2] 88 [2] 8b [2] 48
        98 48 [2] 48 03
        }
        /*
        Enum checks in a custom callback function used to
        process operations on the listening socket
        */
        $sock_callback = {
        89 7d ?? 48 89 75 [1-9] 83  7d ?? 03 75 [1-13] 83 7d ??
        01 75 [1-6] e8
        }
        /*
        Proxy connection and authentication headers
        used in newer builds
        */
        $proxy_hdr_0 = "CONNECT %s:%d HTTP/1.0\r\nProxy-Authorization: Basic %s\r\nProxy-Connection: Keep-Alive\r\n\r\n" ascii
        $proxy_hdr_1 = "CONNECT %s:%d HTTP/1.0\r\nProxy-Connection: Keep-Alive\r\n\r\n" ascii
        /*
        Function names from older samples that
        do not have symbols stripped from the binary
        */
        $func_name_0 = "process_data_from_tunnel" ascii
        $func_name_1 = "SendToTunnel" ascii
        $func_name_2 = "update_tunnel_descriptors" ascii
        $func_name_3 = "tunnel_descsCount" ascii
        $func_name_4 = "get_next_basic_auth_credentials" ascii
        /*
        Global variable names for authentication credentials
        and tunnel descriptors in older samples that do not
        have symbols stripped
        */
        $global_creds = "g_proxy_creds" ascii
        $global_desc = "tunnel_descs" ascii
    condition:
        ($ip_decode and all of ($proxy_hdr_*)) or
        ($ip_decode and $sock_callback) or
        (4 of ($func_name_*) and 1 of ($global_*))
}

