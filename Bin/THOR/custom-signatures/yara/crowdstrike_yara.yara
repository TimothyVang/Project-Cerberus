        64 fd ff ?? 48 8b 53 ??  48 8b cb 48 83 c2 1c 48
        89 43 ?? e8 80 fe ff ??  8b d0 48 8b cb e8 46 fd
        ff ?? 48 8b 53 ?? 48 8b  cb 48 83 c2 24 48 89 43
        ?? e8 62 fe ff ?? 8b d0  48 8b cb e8 28 fd ff ??
        48 8b 53 ?? 48 8b cb 48  83 c2 18 48 89 43 ?? e8
        44 fe ff ?? 89 43 ??
        }
        $code_PE_create_common_4 = {
        8b d0 48 8b cb e8 ec fc  ff ?? 48 8b cb 48 89 83
        88 00 00 ?? 48 8d 50 ??  e8 09 fe ff ?? 83 f8 02
        75
        }
        $code_GetEtwThreatInt_ProviderEnableInfoAddress_2 = {
        e8 32 09 ?? ?? 4c 8d 44  24 ?? b9 08 00 00 00 48
        8d 14 03 e8 4f fc ff ??  48 8b 5c 24 ?? 48 8d 0d
        ?? ?? ?? ?? 48 8b d3 e8  2b 16 ?? ?? 48 85 db 75
        }
        $code_GetEtwThreatInt_ProviderEnableInfoAddress_3 = {
        e8 d9 15 ?? ?? 33 c0 48  8b 4c 24 ?? 48 33 cc e8
        6a 91 03 ?? 48 83 c4 ??  5b c3
        }
        $code_DisableETWThreatIntelProvider_1 = {
        45 33 c9 48 8d 15 ?? ??  ?? ?? 4c 8b c0 48 8d 0d
        ?? ?? ?? ?? e8 85 15 ??  ?? 4c 8d 44 24 ?? c6 44
        24 20 ?? 48 8b d3 b9 01  00 00 00 e8 2e fd ff ??
        48 8d 15 ?? ?? ?? ?? 48  8d 0d ?? ?? ?? ?? e8 5b
        15
        }
        $string_1 = "[+] [NotifyRoutines]        Found callback belonging to EDR driver %s" ascii wide
        $string_2 = "[+] [NotifyRoutines]    No EDR driver(s) found!" ascii wide
        $string_3 = "[+] [NotifyRoutines]    Found a total of %llu EDR / security products driver(s)" ascii wide
        $string_4 = "[+] [NotifyRoutines]    %s callback of EDR driver \"%s\" [callback addr: 0x%I64x | callback struct: 0x%I64x | callback function: 0x%I64x]" ascii wide
        $string_5 = "[!] Required driver file not present at %s" ascii wide
        $string_6 = "[+] Vulnerable driver is already running!" ascii wide
        $string_7 = "[+] Installing vulnerable driver..." ascii wide
        $string_8 = "[!] An error occurred while installing the vulnerable driver" ascii wide
        $string_9 = "[!] New uninstall / install attempt failed, make sure that there is no trace of the driver left..." ascii wide
        $string_10 = "[!] Required driver file not present at %s" ascii wide
        $string_11 = "[+] Evil driver is already running!" ascii wide
        $string_12 = "[+] Installing evil driver..." ascii wide
        $string_13 = "[!] An error occurred while installing the evil driver" ascii wide
        $string_14 = "[*] Uninstalling vulnerable driver..." ascii wide
        $string_15 = "[!] An error occured while attempting to uninstall the vulnerable driver" ascii wide
        $string_16 = "[+] The vulnerable driver was successfully uninstalled!" ascii wide
        $string_17 = "[!] 0x00000005 - Access Denied when attempting to install the driver - Did you run as administrator?" ascii wide
        $string_18 = "[!] The evil service should be manually deleted when you are done with it: " ascii wide
        $string_19 = "[!] ERROR DriverInstaller::uninstallEvilDriver ; ServiceUninstall (0x%08x)" ascii wide
        $string_20 = "[!] ERROR DriverInstaller::serviceInstall ; API(Advapi32, CreateServiceW) (0x%08x)" ascii wide
        $string_21 = "[!] ERROR DriverInstaller::serviceInstall ; API(Advapi32, OpenServiceW) (0x%08x)" ascii wide
        $string_22 = "[!] ERROR DriverInstaller::serviceInstall ; API(Advapi32, StartServiceW) (0x%08x)" ascii wide
        $string_23 = "[!] ERROR DriverInstaller::serviceInstall ; API(Advapi32, OpenSCManagerW)(create) (0x%08x)" ascii wide
        $string_24 = "[!] ERROR DriverInstaller::serviceUninstall ; ServiceUninstall (0x%08x)" ascii wide
        $string_25 = "[!] ERROR DriverInstaller::isDriverRunning ; API(Advapi32, OpenSCManagerW)(create) (0x%08x)" ascii wide
        $string_26 = "[!] 0x00000005 - Access Denied when attempting to install the driver - Did you run as administrator?" ascii wide
        $string_27 = "[!] ERROR DriverInstaller::uninstallVulnerableDriver ; ServiceUninstall (0x%08x)" ascii wide
        $string_28 = "[!] Unable to obtain a handle to the vulnerable driver, exiting..." ascii wide
        $string_29 = "[!] Could not resolve driver for 0x%I64x, an EDR driver might be missed" ascii wide
        $string_30 = "[!] Couldn't allocate memory to store the driver name" ascii wide
        $string_31 = "[!] Could not resolve driver for 0x%I64x, an EDR driver might be missed" ascii wide
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550
        and (
        4 of ($code_*) or
        ($get_peb and $enum_drivers)
        )
        or 8 of ($string_*)
}

