        48 8b 1d ?? ?? ?? ??          mov rbx, ??
        48 85 db                      test rbx, rbx
        74 ??                         je ??
        66 83 3b 00                   cmp word ptr [rbx], 0
        74 ??                         je ??
        33 d2                         xor edx, edx
        48 8b Cb                      mov rcx, rbx
        8b c2                         mov eax, edx
        90                            nop
        66 89 11                      mov word ptr [rcx], dx
        48 8d 40 ??                   lea rax, [rax + 1]
        66 39 14 43                   cmp word ptr [rbx + rax*2], dx
