rule CrowdStrike_CSA_220311_01 : smoke_bot smoky_spider 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Specific check for Ukrainian keyboard layout found in Smoke instances"
        reports = "CSA-220311"
        version = "202203251725"
        last_modified = "2022-03-25"
        actor = "SMOKY SPIDER"
        malware_family  = "Smoke Bot"
    strings:
        /*
        004020CA | 01F6                 | add esi,esi
        004020CC | 89F1                 | mov ecx,esi
        004020CE | B8 22040000          | mov eax,422
        004020D3 | F266:AF              | repne scasw
        004020D6 | 74 16                | je smoke.4020EE
        004020D8 | 8B7D F4              | mov edi,dword ptr ss:[ebp-C]
        004020DB | 89F1                 | mov ecx,esi
        004020DD | B8 19040000          | mov eax,419
        004020E2 | F266:AF              | repne scasw
        */
        $chunk1 = "\x01\xf6\x89\xf1\xb8\x22\x04\x00\x00\xf2\x66\xaf\x74\x16\x8b\x7d" xor
        $chunk2 = "\x89\xf1\xb8\x19\x04\x00\x00\xf2\x66\xaf" xor
    condition:
        all of them and filesize < 300KB
}

rule CrowdStrike_CSA_220258_01 : repeatingumbra 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "HTM files dropped by CHM lures used in recent RepeatingUmbra campaigns"
        reports = "CSA-220258"
        version = "202312261734"
        last_modified = "2023-12-26"
        activity_cluster = "RepeatingUmbra"
    strings:
        $start = /^<!DOCTYPE html>/
        $a1 = "<head> <meta name=ProgId content=htafile>"
        $a2 = "<hta:application id=x>"
        $a3 = "<script language=\"vbscript\">"
        $a4 = "<script language=\"javascript\">"
        $a5 = "try { if (x.commandLine != \"\")"
        $a6 = "new ActiveXObject('WScript.Shell')"
        $b1 = "CreateFolder" nocase
        $b2 = "CreateTextFile" nocase
        $b3 = "FileExists" nocase
        $b4 = "DeleteFile" nocase
        $b5 = "WriteLine" nocase
        $b6 = "certutil" nocase
        $b7 = "TVNDRgAAAAD" nocase
        $b8 = "<> True Then" nocase
    condition:
        $start and all of ($a*) and 3 of ($b*) and filesize < 1MB
}

rule CrowdStrike_MimicryDotNet_Packer : mimicry packer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects large amount of types associated with various .NET protection tools; the packers are usually not protected by any of them"
        reports = "CSA-220517"
        version = "202205171815"
        last_modified = "2022-05-17"
    strings:
        $mimicry_01 = "BabelObfuscatorAttribute"
        $mimicry_02 = "ProtectedWithCryptoObfuscator"
        $mimicry_03 = "DotfuscatorAttribute"
        $mimicry_04 = "DotNetPatcherPackerAttribute"
        $mimicry_05 = "dotNetProtector"
        $mimicry_06 = "NetGuard"
        $mimicry_07 = "NineRays.Obfuscator"
        $mimicry_08 = "ObfuscatedByGoliath"
        $mimicry_09 = "SmartAssembly"
        $mimicry_10 = "Xenocode.Client"
        $mimicry_11 = "YanoAttribute"
        $dot_net_01 = "BSJB"
        $dot_net_02 = "#Strings"
        $ldr_str_01 = "{ await =" wide
        $ldr_str_02 = "Select * from Win32_ComputerSystem" wide
        $ldr_str_03 = "Manufacturer" wide
        $ldr_str_04 = "microsoft corporation" wide
    condition:
        5 of ($mimicry*)
