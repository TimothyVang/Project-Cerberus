rule CrowdStrike_CSA_250062_01 : dotnet ice_tusk iis webshell 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Exposed methods of the .NET in-memory post-exploitation framework IceTusk"
