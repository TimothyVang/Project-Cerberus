rule CrowdStrike_CSA_221066_02 : downloader ecrime lightning_spider satacom unpacked vult 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings for parsing Satacom JSON task configurations as well as artifacts of the statically linked Al-Khaser environment testing framework"
        reports = "CSA-221066,CSIT-22211"
        version = "202501312122"
        last_modified = "2025-01-31"
        actor = "LIGHTNING SPIDER"
        malware_family = "Satacom"
    strings:
        /* Labels from Satacom task configurations defining HTTP
        communications paths for confirming receipt and download
        & execute task details
        */
        $task_config_0 = "crypto_domain" wide ascii
        $task_config_1 = "moderation" wide ascii
        $task_config_2 = "int_point" wide ascii
        $task_config_3 = "fuck_you" wide ascii
        $task_config_4 = "file_ext" wide ascii
        $task_config_5 = "postback_url" wide ascii
        $task_config_6 = "postback_path" wide ascii
        $task_config_7 = "postback_id" wide ascii
        $task_config_8 = "powershell" wide ascii
        // Sum and delta constants used in TEA algorithms
        $tiny_encryption_algorithm_constant_0 = { 47 86 c8 61 }
        $tiny_encryption_algorithm_constant_1 = { b9 79 37 9e }
        /* Registry keys for virtualization software checks
        included in the statically linked Al-Khaser framework
        code - NOTE - Satacom does not actually use these checks
        */
        $registry_key_0 = "Software\\fuckyou\\" wide ascii
        $registry_key_1 = "SYSTEM\\ControlSet001\\Services\\VBoxService" wide ascii
        $registry_key_2 = "SYSTEM\\ControlSet001\\Services\\VBoxMouse" wide ascii
        $registry_key_3 = "SYSTEM\\ControlSet001\\Control\\SystemInformation" wide ascii
        $registry_key_4 = "SOFTWARE\\Oracle\\VirtualBox Guest Additions" wide ascii
        /* Various sandbox service, analysis tool process, and
        virtualization service names included in the statically
        linked Al-Khaser framework code - NOTE - Satacom builds
        have actually used only one of these checks to date
        */
        $anti_analysis_0 = "avghookx.dll" wide ascii
        $anti_analysis_1 = "xenservice.exe" wide ascii
        $anti_analysis_2 = "qemu-ga.exe" wide ascii
        $anti_analysis_3 = "VMware Tools" wide ascii
        $anti_analysis_4 = "Checking reg key %s " wide ascii
        $anti_analysis_5 = "windbg.exe" wide ascii
        $anti_analysis_6 = "joeboxcontrol.exe" wide ascii
        $anti_analysis_7 = "joeboxserver.exe" wide ascii
        $anti_analysis_8 = "joeboxserver.exe" wide ascii
        $anti_analysis_9 = "x32dbg.exe" wide ascii
        $anti_analysis_10 = "x64dbg.exe" wide ascii
        $anti_analysis_11 = "SbieCtrl.exe" wide ascii
        $anti_analysis_12 = "SbieSvc.exe" wide ascii
        $anti_analysis_13 = "SandboxieDcomLaunch.exe" wide ascii
        $anti_analysis_14 = "SandboxieRpcSs.exe" wide ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550
        and all of ($tiny_encryption_algorithm_constant_*) and 3 of ($registry_key_*) and 5 of ($task_config_*) and 10 of ($anti_analysis_*)
}

