rule CrowdStrike_NeoReGeorg_01
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic code fragments of the neo-ReGeorg tunnel template"
        version = "202507110811"
        last_modified = "2025-07-11"
        malware_family = "Neo-reGeorg"
        reference = "https://github.com/L-codes/Neo-reGeorg/blob/master/templates/tunnel.php"
    strings:
        $php = "<?php"
        $s1 = "[$STATUS]"
        $s2 = "[$ERROR]"
        $c1 = "case \"CONNECT\":"
        $c2 = "case \"DISCONNECT\":"
        $c3 = "case \"READ\":"
        $c4 = "case \"FORWARD\":"
        $ = "\x0A$en = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";"
        $ = "\x0A$de = \""
        $ = ", substr($data, $i, 5));"
        $ = "unpack(\"c1N1\","
        $ = "unpack(\"c1b/N1l\","
        $ = "unpack(\"cb/Nl\","
        $ = /blv_(en|de)code/
        $ = "$sayhello"
        $ = "$FORCEREDIRECT"
        $ = "$REDIRECTURL"
        $ = "$RESPONSETEMPLATE"
        $ = "$res = fsockopen($target, $port, $errno, $errstr, 3);"
        $ = "$rinfo[$ERROR] = 'TCP session is closed';"
    condition:
        #php == 1
        and @php < 30
        and (8 of them or 3 of ($c*) and 2 of ($s*))
        and filesize < 20KB
}

