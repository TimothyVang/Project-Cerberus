rule CrowdStrike_NHASReverseSSH_02 : backdoor nhas_reverse_ssh proxy 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "a low prevalence version of the malware which contains a custom encrypted config; patterns match on the explicit x64 opcodes used for decryption"
        version = "202504040628"
        last_modified = "2025-04-04"
        malware_family = "NHASReverseSSH"
    strings:
        $cfg_copy = {
        48 8D 15 [4]    // lea     rdx, CONFIG
        0F B6 34 0A     // movzx   esi, byte ptr [rdx+rcx]
        40 88 34 08     // mov     [rax+rcx], sil
        48 FF C1        // inc     rcx
        }
        $cfg_decrypt = {
        0F B6 34 32     // movzx   esi, byte ptr [rdx+rsi]
        44 31 C6        // xor     esi, r8d
        40 88 34 38     // mov     [rax+rdi], sil
        40 84 F6        // test    sil, sil
        }
        // movzx   r8d, byte ptr [rdx+rdi+OFFSET]
        // ...
        // movzx   esi, byte ptr [rdx+rsi]
        // xor     esi, r8d
        // mov     [rax+rdi], sil
        $cfg01 = {44 0F B6 84 3A 62 02 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg02 = {44 0F B6 84 3A 62 02 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg03 = {44 0F B6 84 3A E2 02 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg04 = {44 0F B6 84 3A E1 03 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg05 = {44 0F B6 84 3A E1 05 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg06 = {44 0F B6 84 3A 21 06 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg07 = {44 0F B6 84 3A 67 06 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg08 = {44 0F B6 84 3A 67 07 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg09 = {44 0F B6 84 3A 67 08 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg10 = {44 0F B6 84 3A 68 09 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg11 = {44 0F B6 84 3A 68 29 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
        $cfg12 = {44 0F B6 84 3A 4D 3A 00 00 [8-16] 0F B6 34 32  44 31 C6  40 88 34 38}
    condition:
        $cfg_copy and 10 of them
}

