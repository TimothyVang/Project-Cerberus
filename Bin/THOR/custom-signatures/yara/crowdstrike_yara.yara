rule CrowdStrike_CSIT_22103_01 : ishdar loader splinteredenvoy 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "SplinteredEnvoy Ishdar loader based on stack strings, characteristic MZ header fixes, and file system paths"
        reports = "CSIT-22103"
        version = "202212090935"
        last_modified = "2022-12-09"
        malware_family = "Ishdar"
        activity_cluster = "SplinteredEnvoy"
    strings:
        // Fixing up the PE header
        // mov     dword ptr [rsp+0B8h+var_28], 905A4Dh
        $fixup1 = {c7 84 24 ?? 00 00 00 4d 5a 90 00}
        // mov     dword ptr [rsp+0b8h+var_28+4], 3
        $fixup2 = {c7 84 24 ?? 00 00 00 03 00 00 00}
        // stack string svchost.exe
        $stackstring = {
        c7 44 24 ?? 73 00 76 00
        c7 44 24 ?? 63 00 68 00
        c7 44 24 ?? 6f 00 73 00
        c7 44 24 ?? 74 00 2e 00
        c7 44 24 ?? 65 00 78 00
        c7 44 24 ?? 65 00 00 00
        }
        $path1 = "C:\\Windows\\System32\\rsc.dat"
        $path2 = "C:\\Windows\\System32\\broker.exe"
        $name = "DriveGuard"
    condition:
        uint16(0) == 0x5A4D and uint32(uint32(0x3C)) == 0x00004550 and all of ($fixup*) and ($stackstring or any of ($path*) or $name)
}

