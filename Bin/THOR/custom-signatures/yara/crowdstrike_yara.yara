        48 85 db
        74 ??
        66 83 3b 00
        74 ??
        33 d2
        48 8b cb
        8b c2
        90
        66 89 11
        48 8d 40 ??
        66 39 14 43
        48 8d 0c 43
        75 ??
        ff 15 ?? ?? ?? ??
        4c 8b c3
        33 d2
        48 8b c8
