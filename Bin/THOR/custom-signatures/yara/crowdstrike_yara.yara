rule CrowdStrike_CSIT_21096_02 : foudre obfuscation radiantcrash tonnerre 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects string obfuscation algorithm used in RadiantCrash malware families Tonnerre and Foudre"
        reports = "CSIT-21096"
        version = "202203251724"
        last_modified = "2022-03-25"
        malware_family = "Foudre"
        activity_cluster = "RadiantCrash"
    strings:
        $ = {8B 55 FC    // mov     edx, [ebp+buf]
        0F B6 14 1A // movzx   edx, byte ptr [edx+ebx]
        89 55 ??    // mov     [ebp+var_14], edx
        8B 55 FC    // mov     edx, [ebp+buf]
        0F B7 CE    // movzx   ecx, si
        C1 E9 08    // shr     ecx, 8
        30 0C 1A    // xor     [edx+ebx], cl
        0F B7 55 ?? // movzx   edx, word ptr [ebp+var_14]
        66 03 D6    // add     dx, si
        66 0F AF F2 // imul    si, dx
        43          // inc     ebx
        48          // dec     eax
        75 DB       // jnz     short loc_4A4BA6
        }
    condition:
        uint16(0) == 0x5A4D and
        uint32(uint32(0x3C)) == 0x00004550 and
        all of them
}

rule CrowdStrike_CSIT_21096_01 : radiantcrash rat tonnerre 
{
    meta:
