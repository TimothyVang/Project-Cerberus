rule CrowdStrike_Syswin_01 : syswin wiper worm 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Python-based wiper with the executable name syswin.exe, which spreads as a worm through removable drives"
        version = "202204080829"
        last_modified = "2022-04-08"
        malware_family = "Syswin"
    strings:
        // Paths used for persistence and environment keying
        $path0 = "C:\\boots"
        $path1 = "D:\\boots"
        $file0 = "syswin.exe"
        $file1 = "C:\\txt.txt"
        // Method names which appear in the source Python script
        $method0 = "cible_run_file"
        $method1 = "thr_cible"
        $method2 = "thr_usb"
        $method3 = "add_to_reg"
        // Variable names which appear in the source Python script
        $var0 = "universal_newlines"
        $var1 = "thefile"
        $var2 = "pseudo0"
        // Windows API and executable names
        $api0 = "GetLogicalDriveStrings"
        $api1 = "SetFileAttributesW"
        $api2 = "QueryValueEx"
        $api3 = "tasklist.exe /fo csv"
    condition:
        all of them and filesize > 2MB
}

