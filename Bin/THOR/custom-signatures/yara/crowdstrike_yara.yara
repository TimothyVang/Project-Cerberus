rule CrowdStrike_CSIT_21213_01 : bitwise_spider ecrime post_exploitation stealbit unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects unique code sequences related to function hashing, configuration decoding, debugger detection, and command line retrieval associated with the Stealbit malware"
        reports = "CSA-220011,CSIT-21213"
        version = "202201071825"
        last_modified = "2022-01-07"
        actor = "BITWISE SPIDER"
        malware_family = "Stealbit"
    strings:
        // modified FNV1a32 hash calculation used to hash Windows API function names
        $modified_fnv1a = {
        0f be f2 80 ea 41 8b c6  83 c8 20 80 fa 19 0f 47
        c6 33 c1 69 C0 93 01 00  01
        }
        //Custom function hashing algorithm using initialization constant 0x0C4D5A97A
        $custom_function_hash = {
        ?? 7a a9 d5 c4 85 ?? 74  ?? 0f be [6] c1 ?? 02 c1
        ?? 05 03 [3-4] 03 ?? 33  ?? (47 | 42 | 43 | 40 |
        46) 3b ?? 72
        }
        // XOR decryption loop to decode configuration block
        $c2_decode = { 8b c1 83 e0 0f 8a 80 [4]  30 81 [4] 41 83 f9 ?? 72 }
        // debug detection via NtGlobalFlag in the Process Environment Block (PEB)
        $peb_detect_debugger = { 64 a1 30 00 00 00 [0-6] f6  40 68 70 [0-1] 74 }
        // retrieve a pointer to process command line using the Process Parameters structure pointed to in the PEB
        $peb_cmdline = { 64 a1 30 00 00 00 [0-10] 8b  40 10 [0-5] ff 70 44 }
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        $c2_decode and
        1 of ($modified_fnv1a,$custom_function_hash) and
        1 of ($peb_*) and
        filesize < 125KB
}

