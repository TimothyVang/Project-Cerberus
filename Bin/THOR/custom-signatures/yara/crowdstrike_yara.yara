rule CrowdStrike_Doit_Stealer_03 : doit infostealer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "rc4 related opcode sequences in heavily packed DoIt samples"
        version = "202403080820"
        last_modified = "2024-03-08"
    strings:
        // inc     ecx
        // movzx   edx, byte ptr [edx+edi]
        // add     edx, ebx
        // add     esi, edx
        // and     esi, 0FFh
        $x_rc4_01 = {
        41
        0f b6 14 3a
        03 d3
        03 f2
        81 e6 ff 00 00 00
        }
        // add     ebx, eax
        // and     ebx, 800000FFh
        // jns     08
        // dec     ebx
        // or      ebx, 0FFFFFF00h
        // inc     ebx
        $x_rc4_02 = {
        03 d8
        81 e3 ff 00 00 80
        79 08
        4b
        81 cb 00 ff ff ff
        43
        }
        // movzx   edx, word ptr [eax]
        // imul    ecx, 1003Fh
        // inc     eax
        // add     ecx, edx
        // cmp     byte ptr [eax], 0
        // jnz     short loc_1003AFE0
        $x_sw_hash = {
        0f b7 10
        69 c9 3f 00 01 00
        40
        03 ca
        80 38 00
        75 ef
        }
        // push    4
        // push    100h
        // push    offset TK
        // mov     eax, offset TK-4
        // call    rc4crypt
        $kc = {
        6A 04
        68 00 01 00 00
        68 ?? ?? ?? ??
        B8 ?? ?? ?? ??
        E8 ?? ?? ?? ??
        }
    condition:
        $kc
        and 2 of ($x*)
        and for all i in (1..#kc) : (uint32(@kc[i] +  8) == uint32(@kc[i] + 13) + 4)
}

