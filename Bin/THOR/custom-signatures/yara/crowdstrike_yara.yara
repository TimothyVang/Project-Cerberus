rule CrowdStrike_CSIT_23013_01 : ducktail ecrime infostealer stealer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings associated with Ducktail Stealer"
        reports = "CSIT-23013"
        version = "202407101147"
        last_modified = "2024-07-10"
        malware_family = "Ducktail"
    strings:
        // facebook information stealing
        $fb_0 = "No cookie FB ###" wide
        $fb_1 = "Tien hanh check user : " wide
        $fb_2 = "BM RESULT : " wide
        $fb_3 = "/me/adaccounts?fields=business&limit=50&access_token=" wide
        $fb_4 = "/me?fields=name,email,birthday&access_token" wide
        $fb_5 = "me/businesses?fields=verification_status,name,permitted_roles,clients.limit(50)&limit=50&access_token=" wide
        // exfiltration
        $tel_0 = "cookies{0}.txt" wide
        $tel_1 = "{0}/user_agent.txt" wide
        $tel_2 = "No IP found" wide
        $tel_3 = "100000458192217.zip" wide
        $tel_4 = "key:SKm0uJdd20cu49Ket5rFLOXA48baFog98j6qo3wa2Cszi9gNOhPV55cvlKxqUiJC5d0mE74VIXEKkk+zXKAgIE88Is/ljTQE9MVTrD6ZarpyHiU4lNgBQrJC87Xvf0ja+1bKrbTeCB6jwj4Jq180+KAd5ZJEuo7Y/TOsT0KFMas=" wide
        $rsa_key_xml = "<RSAKeyValue><Modulus>24WR+D2sq7MyJmlclhJhcfwtFce8h9z2lhRT7arLKI7KbAmjYskWIk15cp46TYqwxrNkSo38uS9IF+NtnajztutKJy7bh8XdJk9DGKtrPn2Dj3hq1F0vejcWTq3GLyIljwT3MXPOrvJpwOesB1cVqifjWUBuyCE2xNKr/8ZHp80=</Modulus><Exponent>AQAB</Exponent></RSAKeyValue>" wide
        // anti-debug checks
        $chk_0 = "SbieDll.dll" wide
        $chk_1 = "134744072" wide // 8.8.8.8
        $chk_2 = "ProcessHacker" wide
        $chk_4 = "taskmgr" wide
        $chk_5 = "This computer is not currently joined to a domain" wide
        // PDB paths associated with DuckTail
        $pdb_path_0 = "\\Projects\\virot\\"
        $pdb_path_1 = "\\Projects\\VirutTest\\"
    condition:
        uint16(0) == 0x5A4D
        and any of ($pdb_path*)
        and (
        (5 of ($fb*))
        or (2 of ($fb*) and 3 of ($tel*))
        or (2 of ($fb*) and 2 of ($chk*))
        or (2 of ($fb*) and $rsa_key_xml)
        )
}

