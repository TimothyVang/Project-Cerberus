rule CrowdStrike_CSA_210721_01 : downloader pdfcaptchalure21 skynet 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects PDF lure documents that were observed delivering Skynet payloads."
        reports = "CSA-210721"
        version = "202204220852"
        last_modified = "2022-04-22"
        malware_family = "PdfCaptchaLure21"
    strings:
        $pp1 = {
        2f 43 72 65 61 74 6f 72 20 28 fe ff 00 77 00 6b
        00 68 00 74 00 6d 00 6c 00 74 00 6f 00 70 00 64
        00 66 00 20 00 30 00 2e 00 31 00 32 00 2e 00 35
        29 0a 2f 50 72 6f 64 75 63 65 72 20 28 fe ff 00
        51 00 74 00 20 00 34 00 2e 00 38 00 2e 00 37 29
        }
        $pp5 = {
        5d 0a 2f 42 6f 72 64 65 72 20 5b 30 20 30 20 30
        5d 0a 2f 41 20 3c 3c 0a 2f 54 79 70 65 20 2f 41
        63 74 69 6f 6e 0a 2f 53 20 2f 55 52 49 0a 2f 55
        52 49 20 28 68 74 74 70
        }
        $pdf_header = "%PDF-1.4"
        $httpp = "http://"
        $https = "https://"
        $lure = /https?:\/\/[#\/=:;$!?&.,\w\+\%\-\*\'~@()]{2,200}\?\w{1,20}=(\w{1,20}\+)+\w{1,20}\)/
    condition:
        any of ($pp*)
        and $pdf_header at 0
        and (
        #httpp > 5 or
        #https > 5 or
        (#httpp > 4 and #https > 0) or
        (#httpp > 3 and #https > 1) or
        (#httpp > 2 and #https > 2) or
        (#httpp > 1 and #https > 3) or
        (#httpp > 0 and #https > 4)
        )
        and $lure
        and filesize < 200KB
}

