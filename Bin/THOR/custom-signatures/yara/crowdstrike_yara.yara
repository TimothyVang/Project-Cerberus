rule CrowdStrike_CSA_230966_02 : ecrime net_support_rat netsupportrat rat unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings found in NetSupportRAT client DLLs"
        reports = "CSA-230966"
        version = "202306300751"
        last_modified = "2023-06-30"
        malware_family = "NetSupportRAT"
    strings:
        /* Standard NetSupportRAT PDB path structure */
        $pdb_path = "e:\\nsmsrc\\nsm\\" ascii
        /* Standard prefix for named pipes used by
        NetSupportRAT
        */
        $pipe_prefix = "\\\\.\\pipe\\nsm_" ascii
        /* Client32 exported function name called
        by client executable when starting NetSupportRAT
        */
        $client_32_export = "_NSMClient32@8" ascii
        /* Controls filename */
        $ctl_filename = "CONTROLS.NSM" ascii
        /* Names prefixed with the Net Support Manager (NSM)
        acronym
        */
        $nsm_0 = "NSMClientConnection" ascii
        $nsm_1 = "NSMAnnotate" ascii
        $nsm_2 = "NSMCobrowse" ascii
        $nsm_3 = "NSMDesktopWnd" ascii
        $nsm_4 = "NSMRemote32" ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        3 of ($pdb_path,$pipe_prefix,$client_32_export,$ctl_filename) and
        3 of ($nsm_*)
}

rule CrowdStrike_CSA_230966_01 : downloader ecrime unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings and XOR decoding sequence in downloader delivering NetSupportRAT"
        reports = "CSA-230966"
        version = "202306300750"
        last_modified = "2023-06-30"
        malware_family = "NetSupportRAT"
    strings:
        /* Statically linked Zlib copyright */
        $zlib = "inflate 1.1.3 Copyright 1995-1998 Mark Adler" ascii
        /* XOR string decoding using the first
        byte in the encoded string as the key
        */
        $str_xor = {
        8b 44 24 ?? 0f b7 4c 24  ?? 66 31 4c 44 ?? 83 c0
        01 eb
        }
        /* Plaintext strings that are not
        obfuscated using the compile-time string
        obfuscator
        */
        $str_0 = "runas" wide
        $str_1 = "cmd.exe" wide
        $str_2 = "%s\\schtasks.exe" wide
        $str_3 = "%s%s%s" wide
        $str_4 = "/c \"%s\"" wide
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        all of ($zlib,$str_xor) and
        3 of ($str_*) and
        filesize < 300KB
}

