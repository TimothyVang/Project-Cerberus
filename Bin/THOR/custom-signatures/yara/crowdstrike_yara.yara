rule CrowdStrike_CSIT_25142_01 : brushfire loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic code and size restriction for the BrushFire loader"
        reports = "CSIT-25142"
        version = "202506240821"
        last_modified = "2025-06-24"
        malware_family = "BrushFireLoader"
    strings:
        $ = {
        b8 1a 00 00 00      // mov eax, 1Ah
        bb 05 00 00 00      // mov ebx, POKEDATA  ; type
        8b 0c 24            // mov ecx, [esp]     ; pid
        89 ??               // mov edx, ??        ; addr
        89 ??               // mov esi, ??        ; data
        cd 80               // int 80h            ; sys_ptrace
        [10-40]             // ...
        b8 1a 00 00 00      // mov eax, 1Ah
        bb 05 00 00 00      // mov ebx, POKEDATA  ; type
        8b 0c 24            // mov ecx, [esp]     ; pid
        89 ??               // mov edx, ??        ; addr
        89 ??               // mov esi, ??        ; data
        cd 80               // int 80h            ; sys_ptrace
        [10-40]             // ...
        b8 1a 00 00 00      // mov eax, 1Ah
        bb 02 00 00 00      // mov ebx, PEEKDATA  ; type
        8b 0c 24            // mov ecx, [esp]     ; pid
        89 ??               // mov edx, ??        ; addr
        89 ??               // mov esi, ??        ; data
        cd 80               // int 80h            ; sys_ptrace
        }
        $ = {
        b8 1a 00 00 00      // mov eax, 1Ah
        bb 11 00 00 00      // mov ebx, DETACH    ; type
        89 ??               // mov ecx, ??        ; pid
        ba 00 00 00 00      // mov edx, 0         ; addr
        be 00 00 00 00      // mov esi, 0         ; data
        cd 80               // int 80h            ; sys_ptrace
        [10-30]             // ...
        b8 1a 00 00 00      // mov eax, 1Ah
        bb 11 00 00 00      // mov ebx, DETACH    ; type
        89 ??               // mov ecx, ??        ; pid
        ba 00 00 00 00      // mov edx, 0         ; addr
        be 00 00 00 00      // mov esi, 0         ; data
        cd 80               // int 80h            ; sys_ptrace
        [10-30]             // ...
        (
        bb 00 00 00 00  // mov ebx, 0
        b8 fc 00 00 00  // mov eax, 0FCh
        |
        b8 fc 00 00 00  // mov eax, 0FCh
        bb 00 00 00 00  // mov ebx, 0
        )
        cd 80               // int 80h            ; sys_exit_group
        }
    condition:
        uint32(0) == 0x464C457F
        and all of them
        and filesize < 5KB
}

