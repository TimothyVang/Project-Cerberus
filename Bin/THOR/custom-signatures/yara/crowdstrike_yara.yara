rule CrowdStrike_CSA_230404_01 : dropper ecrime loader powershell 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings in custom PowerShell designed to install embedded malicious Chrome extension"
        reports = "CSA-230404"
        version = "202303221457"
        last_modified = "2023-03-22"
        malware_family = "FriezerCryptoStealer"
    strings:
        /* Wildcarded search strings to query shortcut
        names in file paths
        */
        $wildcard_chrome = "\"*chrome.exe\"" wide ascii
        $wildcard_chrome_0 = "\"*chrome.exe*\"" wide ascii
        $wildcard_launcher = "\"*launcher.exe\"" wide ascii
        /* Environment paths pre-defined for desktop
        and quick launch shortcuts as well as other
        required directories
        */
        $env_desktop_0 = "$env:userProfile\\Desktop" wide ascii
        $env_desktop_1 = "[Environment]::GetFolderPath(\"Desktop\")" wide ascii
        $env_common_desktop = "[Environment]::GetFolderPath(\"CommonDesktopDirectory\")" wide ascii
        $env_quick_launch = "$env:USERPROFILE\\AppData\\Roaming\\Microsoft\\Internet Explorer\\Quick Launch\\User Pinned" wide ascii
        $env_cleanup = "$env:LOCALAPPDATA\\DesktopCleanup" wide ascii
        $env_dest = "$env:LOCALAPPDATA\\Default" wide ascii
        /* Termination commands for both Chrome and Opera
        browsers
        */
        $stop_chrome = "Stop-Process -Name \"chrome\"" wide ascii
        $stop_opera = "Stop-Process -Name \"opera\"" wide ascii
    condition:
        2 of ($wildcard_*) and
        3 of ($env_*) and
        1 of ($stop_*) and
        filesize > 750KB
}

