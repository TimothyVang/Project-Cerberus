        $fu_success = "Upload successful" wide
        // FileDownload specific string
        $fd_error = "[!] Error: " wide
        // FileDelete specific string
        $del_success = "Delete successful" wide
        // FileRename specific string
        $ren_success = "Rename successful" wide
        // ListDirectory specific strings
        $ld_format = "{0}\t{1}\t{2}\t{3}\t{4}\t{5}" wide
        $ld_timestamp = "yyyy-MM-dd hh:mm:ss" wide
        // LoadAndExecuteAssembly specific string
        $load_exec = "LoadAndExecuteAssembly"
        // BypassDefender specific strings
        $bd_disable = "Set-MpPreference -DisableRealtimeMonitoring $true" wide
        $bd_error = "[!] Bypass error: {0}" wide
    condition:
        dotnet.is_dotnet and $c2_result and (
        // RemoteExec variant
        ($scroll_position and $re_opcode and $re_cmd and $re_exit and $re_error) or
        // Information variant
        ($info_reg and $info_adapter and $info_mac and $info_ip and $info_dns) or
        // FileUpload variant
        ($scroll_path and $scroll_position and $fu_success) or
        // FileDownload variant
        ($scroll_path and $scroll_position and $fd_error) or
        // FileDelete variant
        ($scroll_path and $del_success) or
        // FileRename variant
        ($scroll_path and $scroll_position and $ren_success) or
        // ListDirectory variant
        ($scroll_path and $ld_format and $ld_timestamp) or
        // LoadAndExecuteAssembly variant
        ($scroll_path and $scroll_position and $load_exec) or
        // BypassDefender variant
        ($bd_disable and $bd_error)
        ) and filesize < 50KB
}

