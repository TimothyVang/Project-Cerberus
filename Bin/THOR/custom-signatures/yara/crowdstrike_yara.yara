        $ = "Creating the snapshoot of lsass.exe ... Done !!" wide
        $ = "Creating the snapshoot of lsass.exe is failed !" wide
        $ = "Opening  the snapshoot file ..." wide
        $ = "Cannot create the snapshoot file ,error :0x%0x" wide
    condition:
        uint16(0)==0x5a4d and 2 of them and filesize < 1MB
}

