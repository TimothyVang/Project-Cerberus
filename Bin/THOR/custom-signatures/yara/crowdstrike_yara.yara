        reports = "CSA-250917"
        version = "202508080842"
        last_modified = "2025-08-08"
        malware_family = "ChromaLoader"
    strings:
        $rust_01 = ".rustup"
        $rust_02 = "/rustc/"
        $rust_03 = "\\\\.\\pipe\\__rust_anonymous_pipe1__."
        $magic = {34 12 cd ab}
        $export_01 = "fake_etw_event_write"
        $export_02 = "install_etw_veh_hook"
        $export_03 = "ORIGINAL_ETW_ENTRY"
        $export_04 = "ETW_HOOK_IN_PROGRESS"
        $export_05 = "ETW_PROLOGUE_BYTES"
        $export_06 = "ETW_VEH_REG"
