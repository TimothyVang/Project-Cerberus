rule CrowdStrike_CSIT_21196_01 : hidden_spider servhelper 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects the ServHelper backdoor "
        reports = "CSIT-21196,CSIT-21235"
        version = "202401301427"
        last_modified = "2024-01-30"
        actor = "HIDDEN SPIDER"
        malware_family = "ServHelper"
    strings:
        // x64 load config
        // 48 8D 8D A8 00 00 00   lea     rcx, [rbp+var_sA8]
        // 48 8D 15 14 05 00 00   lea     rdx, aNfthwokloghmFe ; "nfthwokloghm.fes"
        // 4C 8D 05 49 04 00 00   lea     r8, aVmchjigt_3 ; "VMCHJIGT"
        // 41 B9 41 41 00 00      mov     r9d, 4141h
        // E8 EE FC FF FF         call    mlw_VigenereDecrypt
        // 48 8B 8D A8 00 00 00   mov     rcx, [rbp+var_sA8]
        // E8 12 C7 C0 FF         call    mlw_StrStuff??
        // 48 8D 0D 4B 04 08 00   lea     rcx, C2_SERVER
        // 48 89 C2               mov     rdx, rax
        // E8 A3 C7 C0 FF         call    mlw_StrAssign??
        $x64_load_config = { 48 [2-6] 48 [6] 4c [6] 41 [5] e8 [4] 48 [6] e8 [4] 48 [6] 48 89 c2 e8 [4] 48 }
        // x64 vigenere
        // 4F 0F B6 44 48 FE   movzx   r8, byte ptr [r8+r9*2-2]
        // 41 80 E8 41         sub     r8b, 41h ; 'A'
        // 44 88 04 10         mov     [rax+rdx], r8b
        // EB 19               jmp     short loc_415CDB
        $x64_vigenere = { 4f 0f b6 44 48 fe 41 80 e8 41 44 88 04 10 eb }
        // x86 load config
        // 8D 45 E8            lea     eax, [ebp+var_18]
        // 50                  push    eax
        // B9 D5 50 00 00      mov     ecx, 50D5h
        // BA C8 F2 6B 00      mov     edx, offset aDebhgwxn ; "DEBHGWXN"
        // B8 08 F3 6B 00      mov     eax, offset aGpli1 ; "gpli1"
        // E8 5E FF FF FF      call    mlw_VigenereDecrypt
        // 8B 45 E8            mov     eax, [ebp+var_18]
        // E8 3E D4 D4 FF      call    sub_40B974
        // 8B D0               mov     edx, eax
        // 8D 45 EC            lea     eax, [ebp+var_14]
        // E8 9C D4 D4 FF      call    sub_40B9DC
        // 8B 45 EC            mov     eax, [ebp+
        $x86_load_config = { 8d [2-5] 50 b9 [4] ba [4] b8 [4] e8 [4] 8b [2] e8 [4] 8b d0 8d [2] e8 [4] 8b }
        // x86 vigenere
        // 0F B7 44 5F FE      movzx   eax, word ptr [edi+ebx*2-2]
        // 2C 41               sub     al, 41h ; 'A'
        // 8B 55 FC            mov     edx, [ebp+var_4]
        // 88 44 1A FF         mov     [edx+ebx-1], al
        // EB 13               jmp     short loc_6BE3A5
        $x86_vigenere = { 0f b7 44 5f fe 2c 41 8b [2] 88 44 1a ff eb }
    condition:
        (#x64_load_config > 10 and $x64_vigenere) or (#x86_load_config > 10 and $x86_vigenere)
}

