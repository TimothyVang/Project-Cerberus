        $a_4 = "SGV4KCIqYSI" wide ascii
        $a_5 = "U2VuZERuc1JlcXVlc3QoVG9IZXgoIiphIi" wide ascii
        $a_6 = "TZW5kRG5zUmVxdWVzdChUb0hleCgiKmEiK" wide ascii
        $a_7 = "NlbmREbnNSZXF1ZXN0KFRvSGV4KCIqYSI" wide ascii
        $b_1 = "SendDnsRequest(ToHex(\"*n\")" wide ascii
        $b_2 = "U2VuZERuc1JlcXVlc3QoVG9IZXgoIipuIi" wide ascii
        $b_3 = "TZW5kRG5zUmVxdWVzdChUb0hleCgiKm4iK" wide ascii
        $b_4 = "NlbmREbnNSZXF1ZXN0KFRvSGV4KCIqbiI" wide ascii
        $c_1 = "if (CmdType == \"z\")" wide ascii
        $c_2 = "aWYgKENtZFR5cGUgPT0gInoiK" wide ascii
        $c_3 = "pZiAoQ21kVHlwZSA9PSAieiI" wide ascii
        $c_4 = "lmIChDbWRUeXBlID09ICJ6Ii" wide ascii
        $d_1 = "if (CmdType == \"f\")" wide ascii
        $d_2 = "aWYgKENtZFR5cGUgPT0gImYiK" wide ascii
        $d_3 = "pZiAoQ21kVHlwZSA9PSAiZiI" wide ascii
        $d_4 = "lmIChDbWRUeXBlID09ICJmIi" wide ascii
