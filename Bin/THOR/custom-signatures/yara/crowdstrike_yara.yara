rule CrowdStrike_CSIT_23291_01 : exploit 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Potential CVE-2023-36802 exploits"
        reports = "CSIT-23291"
        version = "202310060747"
        last_modified = "2023-10-06"
    strings:
        //opening the device
        // - GUID for KsOpenDefaultDevice
        $open1_1 = { 1a 50 0d 3c 0b 14 d1 11 b4 0f 00 a0 c9 22 31 96 }
        $open1_2 = "KsOpenDefaultDevice"
        $open2 = "\\\\?\\ROOT#SYSTEM#0000#{3c0d501a-140b-11d1-b40f-00a0c9223196}\\{96E080C7-143C-11D1-B40F-00A0C9223196}&{3C0D501A-140B-11D1-B40F-00A0C9223196}" ascii wide
        //the deviceIo
        $deviceio_1_1 = "DeviceIoControl"
        // - mov edx, 0x2f040c
        $deviceio_1_2 = { ba 0c 04 2f 00 }
        // - mov edx, 0x2f0400
        $deviceio_1_3 = { ba 00 04 2f 00 }
        $deviceio_2_1 = "NtDeviceIoControlFile"
        // - mov [rsp+X], 0x2f040c
        $deviceio_2_2 = { c7 44 24 ?? 0c 04 2f 00 }
        // - mov [rsp+X], 0x2f0400
        $deviceio_2_3 = { c7 44 24 ?? 00 04 2f 00 }
    condition:
        (uint16(0) == 0x5a4d)
        and ((all of ($open1_*)) or $open2)
        and ((all of ($deviceio_1*)) or (all of ($deviceio_2*)))
}

