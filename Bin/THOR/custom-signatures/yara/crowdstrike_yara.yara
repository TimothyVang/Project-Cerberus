rule CrowdStrike_CSIT_21133_02 : ransomware trinage unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects unique strings and chunk size calculation for file encryption in Trinage ransomware"
        reports = "CSIT-21133"
        version = "202108060914"
        last_modified = "2021-08-06"
        malware_family = "Trinage"
    strings:
        // Base64 encoded, reverse order segments concatenated together to form RSA public key used to protect 32 byte passphrase key that is used to generate AES file encryption keys
        $rsa_pub_1 = "cpJ2RaxWe1Q1cBV1NHpXYWZHOzcFdrQ3aNlEbMNkMRNjekZndxJnPzVHb1R2bNxjPlVHbhZVeltUQTJFP" wide ascii
        $rsa_pub_2 = "iM2Z3RuRUVqVEVEhUdlhVbFdnaSFWTWpkVwR1SEh3KY9mbht2L08SbKlWVEpGZPJnSmpGVBdlazJ1ZkFz" wide ascii
        $rsa_pub_3 = "VHMUJzc1YUSz90Lz8mNQNTTlN2ZExmYYFlZ4Q1KTJ0TK1kUIhjZJBXYaVndzonUhBTRop0QShkNDhTMJt" wide ascii
        $rsa_pub_4 = "+UWdsFmV5V2SBNlUvwjP05WZu9Gc4V0L8IUQRFkP05WZu9Gc4VEP+MXdsVHZv10L80TViplbxhGM5tkaG" wide ascii
        // Base64 encoded, reverse order segments concatenated together and sent to string decryption to generate mutex name "Global\\2ea8f335-7e68-434b-a38a-8ff6fb02aff8"
        $mutex_1 = "UDwKBAABAAAAAAACL+BAAAwK" wide ascii
        $mutex_2 = "hCizqcMZhwnpq/OlJu7Fxr+/" wide ascii
        $mutex_3 = "nnKQWmwU/DVqc2X3proWsaib" wide ascii
        $mutex_4 = "==AAAAwK41iRj1Ck/9EYjlyE" wide ascii
        // Base64 encoded, reverse order segments concatenated together and sent to string decryption to generate filename for ransomware generated desktop background "[WALLNAME].bmp"
        $bckgrnd_loc_1 = "AAAAACL+BAAAwD" wide ascii
        $bckgrnd_loc_2 = "tIpx/xEe7DABAA" wide ascii
        $bckgrnd_loc_3 = "gBpvCTojbR2f2f" wide ascii
        $bckgrnd_loc_4 = "==AAAAwDE3SdjA" wide ascii
        // Calculate chunk size for encryption of files larger than 10MB with arbitrary arithmetic performed on file length
        $chunk_calc_1 = { 23 [8] 23 [8] ?? 28 [4] 5b 0b }
        $chunk_calc_2 = { 6f [4] 28 [4] 5a 00 23 [8] 23 [8] ?? 28 [4] 5b 0c }
        $chunk_calc_3 = { 07 03 28 [4] 00 23 [8] 23 [8] ?? 28 [4] 5a 00 23 [8] 23 [8] ?? 28 [4] 5a 59 0c }
        $chunk_calc_4 = { 00 28 [4] 69 00 23 [8] 23 [8] ?? 28 [4] 5a 0d }
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        all of ($chunk_calc_*) and
        4 of ($mutex_*,$bckgrnd_loc_*,$rsa_pub_*) and
        filesize < 200KB
}

