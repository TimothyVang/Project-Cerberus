        // cmp sp, sp
        $sp = { 66 3b e4 74 }
        // cmp bx, bx
        $bx = { 66 3b db 74 }
        // cmp di, di
        $di = { 66 3b ff 74 }
        // cmp si, si
        $si = { 66 3b f6 74 }
    condition:
        pe.DLL
        and $peb
        and #sp > 5
        and #bx > 5
        and #di > 5
        and #si > 5
        and filesize < 2MB
}

