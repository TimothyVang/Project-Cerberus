rule CrowdStrike_CSharpStreamerPacker_01 : csharp_streamer packer rat 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "A packer commonly observed delivering CStreamerRAT; it leverages the .NET runtime via COM to execute the payload in memory."
        version = "202406101039"
        last_modified = "2024-06-10"
        malware_family = "CSharpStreamerRAT"
    strings:
        $ldrCryptData = {
        F3 41 0F 6F 04 82       // movdqu  xmm0, xmmword ptr [r10+rax*4]
        8D 50 04                // lea     edx, [rax+4]
        66 0F 6E C8             // movd    xmm1, eax
        66 0F 70 C9 00          // pshufd  xmm1, xmm1, 0
        66 0F FE CA             // paddd   xmm1, xmm2
        66 0F FA CB             // psubd   xmm1, xmm3
        66 0F EF C8             // pxor    xmm1, xmm0
        F3 41 0F 7F 0C 82       // movdqu  xmmword ptr [r10+rax*4], xmm1
        83 C0 08                // add     eax, 8
        66 0F 6E CA             // movd    xmm1, edx
        66 0F 70 C9 00          // pshufd  xmm1, xmm1, 0
        66 0F FE CA             // paddd   xmm1, xmm2
        66 0F FA CB             // psubd   xmm1, xmm3
        F3 41 0F 6F 04 92       // movdqu  xmm0, xmmword ptr [r10+rdx*4]
        66 0F EF C8             // pxor    xmm1, xmm0
        F3 41 0F 7F 0C 92       // movdqu  xmmword ptr [r10+rdx*4], xmm1
        41 3B C1                // cmp     eax, r9d
        72 B3                   // jb      short loc_140002310
        }
        $ldrExecuteAssembly = {
        48 8B 4C 24 ??          // mov     rcx, [rsp+??]
        4C 8D 4C 24 50          // lea     r9, [rsp+80]
        45 33 C0                // xor     r8d, r8d
        48 8B D3                // mov     rdx, rbx
        4C 8B 11                // mov     r10, [rcx]
        41 FF 92 90 01 00 00    // call    qword ptr [r10+190h]
        }
        $ldrZlib = "1.2.11" fullword
        $ldrApi1 = "StrStrNIW"
        $ldrXorK = {
        00000000 01000000 02000000 03000000
        0001ff00 0001ff00 0001ff00 0001ff00 }
        $guid1 = { 8d 18 80 92 8e 0e 67 48 b3 0c 7f a8 38 84 e8 de } // ICLRMetaHost Class
        $guid2 = { 9e db 32 d3 b3 b9 25 41 82 07 a1 48 84 f5 32 16 } // ICLRMetaHost IF
        $guid3 = { d2 d1 39 bd 2f ba 6a 48 89 b0 b4 b0 cb 46 68 91 } // ICLRRuntimeInfo
        $guid4 = { 23 67 2f cb 3a ab d2 11 9c 40 00 c0 4f a3 0a 3e } // ICorRuntimeHost Class
        $guid5 = { 22 67 2f cb 3a ab d2 11 9c 40 00 c0 4f a3 0a 3e } // ICorRuntimeHost IF
        $guid6 = { dc 96 f6 05 29 2b 63 36 ad 8b c4 38 9c f2 a7 13 } // IAppDomain
    condition:
        all of ($guid*) and 2 of ($ldr*)
}

