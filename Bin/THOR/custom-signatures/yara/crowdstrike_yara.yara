rule CrowdStrike_CoreImpactAgentWrapperV2 : agent backdoor coreimpact packer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects 64-bit packer used for Core Impact Agents"
        version = "202204080854"
        last_modified = "2022-04-08"
        malware_family = "CoreImpact"
    strings:
        //Length parameter
        $a1 = { 48 B9 30 63 02 00 00 00 00 00 }
        /*
        Decoding loop
        .data:0000000100004220 48 81 C1 F8 FF FF FF                                add     rcx, 0FFFFFFFFFFFFFFF8h
        .data:0000000100004227 48 FF C3                                            inc     rbx
        .data:000000010000422A 48 FF C3                                            inc     rbx
        .data:000000010000422D 48 FF C3                                            inc     rbx
        .data:0000000100004230 48 FF C3                                            inc     rbx
        .data:0000000100004233 48 FF C3                                            inc     rbx
        .data:0000000100004236 48 FF C3                                            inc     rbx
        .data:0000000100004239 48 FF C3                                            inc     rbx
        .data:000000010000423C 48 FF C3                                            inc     rbx
        .data:000000010000423F E9 C2 FF FF FF                                      jmp     loc_100004206
        */
        $a2 = { 48 81 C1 F8 FF FF FF 48 FF C3 48 FF C3 48 FF C3 48 FF C3 48 FF C3 48 FF C3 48 FF C3 48 FF C3 }
        /*
        Alternative decoding loop, probably different due to compiler optimization
        .data:00000000FF244229 48 FF C9                                      dec     rcx
        .data:00000000FF24422C 48 FF C9                                      dec     rcx
        .data:00000000FF24422F 48 FF C9                                      dec     rcx
        .data:00000000FF244232 48 FF C9                                      dec     rcx
        .data:00000000FF244235 48 FF C9                                      dec     rcx
        .data:00000000FF244238 48 FF C9                                      dec     rcx
        .data:00000000FF24423B 48 FF C9                                      dec     rcx
        .data:00000000FF24423E 48 FF C9                                      dec     rcx
        .data:00000000FF244241 48 81 C3 08 00 00 00
        */
        $a3 = { 48 FF C9 48 FF C9 48 FF C9 48 FF C9 48 FF C9 48 FF C9 48 FF C9 48 FF C9 48 81 C3 08 00 00 00 }
    condition:
        any of them and filesize < 500KB
}

