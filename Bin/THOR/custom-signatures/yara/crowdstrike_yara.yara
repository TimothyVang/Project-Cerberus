rule CrowdStrike_CSIT_25091_03 : autohotkey hotwire rat 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects HotWire RAT"
        reports = "CSIT-25091,CSIT-25149"
        version = "202507101316"
        last_modified = "2025-07-10"
        actor = "MUTANT SPIDER"
        malware_family = "HotWire"
    strings:
        $name_0 = "AutoHotkey" ascii wide
        $compiler_0 = "; <COMPILER: v" ascii wide
        $encrypted_script_0 = "PK" ascii wide
        $string_0 = "Script_%word%" ascii wide
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and pe.is_dll() and pe.number_of_resources > 0
        and $name_0 at pe.rva_to_offset(
        uint32(
        pe.rva_to_offset(
        pe.data_directories[pe.IMAGE_DIRECTORY_ENTRY_EXPORT].virtual_address
        ) + 12
        )
        )
        and for any i in (0..pe.number_of_resources): (
        $compiler_0 at pe.resources[i].offset
        or $encrypted_script_0 at pe.resources[i].offset
        )
