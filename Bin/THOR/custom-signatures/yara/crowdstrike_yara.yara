        */
        $ = { 7b 00 30 00 30 00
        30 00 32 00 30 00 34 00  45 00 46 00 2d 00 30 00
        30 00 30 00 30 00 2d 00  30 00 30 00 30 00 30 00
        2d 00 43 00 30 00 30 00  30 00 2d 00 30 00 30 00
        30 00 30 00 30 00 30 00  30 00 30 00 30 00 30 00
        34 00 36 00 7d 00
        }
        // Code page
        $ = { 02 00 00 00 e4 04 00 00 1e 00 00 00 04 00 00 00 }
        // Author pc
        $ = { 1e 00 00 00 04 00 00 00 70 63 00 00 1e 00 00 00 }
        // AppVersion
        $ = { 03 00 00 00 00 00 10 00 }
        /*
        00023770  2e 00 30 00 23 00 30 00  23 00 43 00 3a 00 5c 00  |..0.#.0.#.C.:.\.|
        00023780  55 00 73 00 65 00 72 00  73 00 5c 00 70 00 63 00  |U.s.e.r.s.\.p.c.|
        00023790  5c 00 41 00 70 00 70 00  44 00 61 00 74 00 61 00  |\.A.p.p.D.a.t.a.|
