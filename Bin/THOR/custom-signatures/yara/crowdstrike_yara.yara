rule CrowdStrike_Donut_Loader_Shellcode_01 : donut loader shellcode 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Donut Loader shellcode components using to load required libraries"
        version = "202308112234"
        last_modified = "2023-08-11"
        malware_family = "Donut"
    strings:
        /*
        Code to parse semi-colon separated DLL dependencies
        seg000:0000000000000E72 C6 44 05 20 64                          mov     [rbp+rax+1E0h+var_1C0], 64h ; 'd'
        seg000:0000000000000E77 8B 85 DC 01 00 00                       mov     eax, [rbp+1E0h+var_4]
        seg000:0000000000000E7D 83 C0 02                                add     eax, 2
        seg000:0000000000000E80 89 C0                                   mov     eax, eax
        seg000:0000000000000E82 C6 44 05 20 6C                          mov     [rbp+rax+1E0h+var_1C0], 6Ch ; 'l'
        seg000:0000000000000E87 8B 85 DC 01 00 00                       mov     eax, [rbp+1E0h+var_4]
        seg000:0000000000000E8D 83 C0 03                                add     eax, 3
        seg000:0000000000000E90 89 C0                                   mov     eax, eax
        seg000:0000000000000E92 C6 44 05 20 6C                          mov     [rbp+rax+1E0h+var_1C0], 6Ch ; 'l'
        */
        $ = { c6 44 05 20 64 8b 85 dc 01 00 00 83 c0 02 89 c0 c6 44 05 20 6c 8b 85 dc 01 00 00 83 c0 03 89 c0 c6 44 05 20 6c }
        /*
        seg000:0000000000000E57 84 C0                                   test    al, al
        seg000:0000000000000E59 74 0C                                   jz      short loc_E67
        seg000:0000000000000E5B 83 BD DC 01 00 00 3B                    cmp     [rbp+1E0h+var_4], 3Bh ; ';'
        */
        $ = { 84 c0 74 0c 83 bd dc 01 00 00 3b }
    condition:
        all of them
}

