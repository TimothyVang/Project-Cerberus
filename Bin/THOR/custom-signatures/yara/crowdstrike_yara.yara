rule CrowdStrike_CSA_250092_03 : cruel_jackal dreadful_ruin 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Encrypted strings and wiper algorithm used by the wiper component of DreadfulRuin"
        reports = "CSA-250092"
        version = "202501241600"
        last_modified = "2025-01-24"
        actor = "CRUEL JACKAL"
        malware_family = "DreadfulRuin"
        
    strings:
        /*
        cmp ebx, 0x29e3
        jle 0x401a24
        nop dword ptr [eax]
        call 0x40612c
        and eax, 0x800000ff
        jns 0x4019d3
        dec eax
        or eax, 0xffffff00
        inc eax
        mov byte ptr [ebp + esi - 0x29f0], al
        inc esi
        cmp esi, 0x29e3
        jl 0x4019c0
        */
        $wiper_algorithm = { 81 fb e3 29 00 00
        7e ??
        0f 1f 80 ?? ?? ?? ??
        e8 ?? ?? ?? ??
        25 ff 00 00 80
        79 ??
        48
        0d 00 ff ff ff
        40
        88 84 35 ?? ?? ?? ??
        46
        81 fe e3 29 00 00
        7c ?? }
        $s1= "Saturday, October 07, 2023, 6:29:00 AM" // encryption key
        $s2= "zKmFfPOamlsZbjL]"  // GetLogicalDrives
        $s3= "KERNEL32.dll"
        $s4= "ProgramData" wide
        $s5= "%s\\%s" wide
        $s6= "desktop.ini" wide
    condition:
        uint16(0) == 0x5A4D and
        uint32(uint32(0x3C)) == 0x00004550 and
        $wiper_algorithm and 4 of ($s*)
}

