rule CrowdStrike_CSIT_24247_04 : compression dll_to_shellcode loader shellcode 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique function hashes and code sequences from shellcode loaders generated using the open-source DllToShellcode project"
        reports = "CSIT-24247"
        version = "202508051525"
        last_modified = "2025-08-05"
        malware_family = "DllToShellcode"
    strings:
        /* Function and library hashes used by DllToShellcode */
        $lib_hash_kernel32 = { e6 9c ca 1c }
        $func_hash_getprocaddress = { 54 b8 b9 1a }
        $func_hash_loadlibrarya = { 78 1f 20 7f }
        $func_hash_virtualalloc = { 62 34 89 5e }
        $func_hash_virtualfree = { 73 80 48 06 }
        $func_hash_lstrcmpia = { a5 f2 5c 70 }
        $func_hash_rtlzeromemory = { cb 79 b5 0d }
        $func_hash_rtlmovememory = { c0 e9 18 15 }
        $func_hash_rtldecompressbuffer = { 65 62 10 4b }
        /* Calculate delta value used to compute absolute addresses */
        $get_delta = { e8 00 00 00 00 58 2d [4] 89 45 }
        /*
        Multiplication-based hash calculation using
        the default seed value of 0x83 (131)
        */
        $hash_calc = { 69 c9 83 00 00 00 0f b7  c0 03 c8 [1-4] 75 }
        /*
        Load ntdll.dll by moving the name string on to the stack
        and then calling the offset for LoadLibraryA in the custom
        "func" structure
        */
        $load_ntdll = {
        8d 4? ?? c7 45 ?? 6e 74  64 6c [0-8] 66 c7 45 ?? 6c
        00
        }
    condition:
        8 of ($lib_hash_*,$func_hash_*) and
        2 of ($get_delta,$hash_calc,$load_ntdll)
}

