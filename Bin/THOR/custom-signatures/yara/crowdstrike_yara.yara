        $decode_config_data_32_bit = { C7 45 ?? 06 00 00 00 F7 75 ?? 8A 0C 1F 8A 82 ?? ?? ?? ?? 32 C1 66 98 }
        /*
        48 C1 EA 02           shr     rdx, 2
        48 8D 04 52           lea     rax, [rdx+rdx*2]
        48 03 C0              add     rax, rax
        48 2B C8              sub     rcx, rax
        48 8D 05 ?? ?? ?? ??  lea     rax, config_decode_key
        */
        $decode_config_data_64_bit = { 48 C1 EA 02 48 8D 04 52 48 03 C0 48 2B C8 48 8D 05 }
        /*
        68 34 12 FF FF     push    0xFFFF1234
        FF 15 ?? ?? ?? ??  call    ds:NtCompressKey
        */
        $NtCompressKey_call_32_bit = { 68 34 12 FF FF FF 15 }
        /*
        B9 34 12 FF FF     mov     ecx, 0xFFFF1234
        FF 15 ?? ?? ?? ??  call    cs:NtCompressKey
        */
        $NtCompressKey_call_64_bit = { B9 34 12 FF FF FF 15 }
        /*
        B8 95 3A 00 00  mov     eax, 0x3A95
        */
        $build_number_check_windows_build_14997 = { B8 95 3A 00 00 }
        $build_number_check_unique_constant_0 = { FC FF FB FF }
        $build_number_check_unique_constant_1 = { 14 00 84 10 }
        $process_path_component_0 = "PROGRAMDATA" wide ascii
