rule CrowdStrike_CSIT_17168_02 : loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detection for CCleaner second-stage loader"
        reports = "CSIT-17168"
        version = "202201111534"
        last_modified = "2022-01-11"
