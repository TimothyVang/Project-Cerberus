rule CrowdStrike_M1CRO_RC4 : m1cro 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic RC4 implementation of M1CRO"
        version = "202205270922"
        last_modified = "2022-05-27"
        malware_family = "M1CRO"
    strings:
        $op_rc4_init = {
        89 01             // mov     [ecx], eax
        40                // inc     eax
        8d 49 04          // lea     ecx, [ecx+4]
        3b c3             // cmp     eax, ebx
        7c f6             // jl      -10
        8b 6c 24 ??       // mov     ebp, [esp+key]
        89 54 24 ??       // mov     [esp+b], edx
        8a 04 2a          // mov     al, [edx+ebp]
        02 44 24 ??       // add     al, byte ptr [esp+b]
        8b 0f             // mov     ecx, [edi]
        02 C1             // add     al, cl
        0f b6 c0          // movzx   eax, al
        89 44 24 ??       // mov     [esp+b], eax
        8B 44 86 08       // mov     eax, [esi+eax*4+8]
        89 07             // mov     [edi], eax
        8d 7f 04          // lea     edi, [edi+4]
        8b 44 24 ??       // mov     eax, [esp+b]
        89 4c 86 ??       // mov     [esi+eax*4+key_length], ecx
        8d 42 01          // lea     eax, [edx+1]
        33 d2             // xor     edx, edx
        3b 44 24 ??       // cmp     eax, [esp+key_length]
        0f 4c d0          // cmovl   edx, eax
        83 eb 01          // sub     ebx, 1
        75 cc             // jnz     short loc_1C92EDA
        }
        $op_rc4_crypt = {
        8a 06             // mov     al, [esi]
        fe c0             // inc     al
        0f b6 d0          // movzx   edx, al
        8a 46 04          // mov     al, [esi+4]
        89 16             // mov     [esi], edx
        8b 5c 96 08       // mov     ebx, [esi+edx*4+8]
        02 c3             // add     al, bl
        0f b6 c0          // movzx   eax, al
        89 46 04          // mov     [esi+4], eax
        8b 4c 86 08       // mov     ecx, [esi+eax*4+8]
        89 4c 96 08       // mov     [esi+edx*4+8], ecx
        8b 46 04          // mov     eax, [esi+4]
        89 5c 86 08       // mov     [esi+eax*4+8], ebx
        02 d9             // add     bl, cl
        0f b6 c3          // movzx   eax, bl
        8a 44 86 08       // mov     al, [esi+eax*4+8]
        30 04 2f          // xor     [edi+ebp], al
        47                // inc     edi
        }
    condition:
        any of them
}

rule CrowdStrike_CSIT_22100_01 : ecrime loader mix_loader mixloader unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects unique strings including static HTTP headers in MixLoader's main module"
        reports = "CSA-240561,CSIT-22100"
        version = "202407091432"
        last_modified = "2024-07-09"
        malware_family = "MixLoader"
    strings:
        /* Static HTTP Accept headers */
        $accept_hdr_0 = "Accept: text/html, application/xml;q=0.9, application/xhtml+xml, image/png, image/jpeg, image/gif, image/x-xbitmap, */*;q=0.1" ascii
        $accept_hdr_1 = "Accept-Language: ru-RU,ru;q=0.9,en;q=0.8" ascii
        $accept_hdr_2 = "Accept-Charset: iso-8859-1, utf-8, utf-16, *;q=0.1" ascii
        $accept_hdr_3 = "Accept-Encoding: deflate, gzip, x-gzip, identity, *;q=0" ascii
        /*
        Check-in, software check, and download
        DLL export name strings from MixLoader builds
        */
        $checkin_sub = "SUB=" ascii
        $checkin_nosub = "NOSUB" ascii
        $checkin_uniq = "uniqq" ascii
        $check = "/chk" ascii
        $software_check_wrshrk = "Wireshark" ascii
        $download_dll_export_0 = "GetLicInfo" ascii
        $download_dll_export_1 = "updateSW" ascii
        $key = "................" ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        all of ($accept_hdr_*) and
        3 of ($checkin_*,$check,$software_check_wrshrk,$download_dll_export_*) and
        $key
}

