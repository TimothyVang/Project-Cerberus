rule CrowdStrike_CSIT_22052_01 : emotet geodo mummy_spider plugin 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Emotet (aka Geodo) plugins"
        reports = "CSIT-22052"
        version = "202304260925"
        last_modified = "2023-04-26"
        actor = "MUMMY SPIDER"
        malware_family = "Emotet"
    strings:
        /*
        .text:10017BBC 8D 7F 04                                      lea     edi, [edi+4]
        .text:10017BBF 33 CB                                         xor     ecx, ebx
        .text:10017BC1 0F B6 C1                                      movzx   eax, cl
        .text:10017BC4 66 89 02                                      mov     [edx], ax
        .text:10017BC7 8B C1                                         mov     eax, ecx
        .text:10017BC9 C1 E8 08                                      shr     eax, 8
        .text:10017BCC 8D 52 08                                      lea     edx, [edx+8]
        .text:10017BCF 0F B6 C0                                      movzx   eax, al
        .text:10017BD2 66 89 42 FA                                   mov     [edx-6], ax
        .text:10017BD6 C1 E9 10                                      shr     ecx, 10h
        .text:10017BD9 0F B6 C1                                      movzx   eax, cl
        .text:10017BDC C1 E9 08                                      shr     ecx, 8
        */
        $decrypt_string_2 = { 8d 7f 04 33 cb 0f b6 c1 66 89 02 8b c1 c1 e8 08 8d 52 08 0f b6 c0 66 89 42 fa c1 e9 10 0f b6 c1 c1 e9 08 }
        /*
        .text:0000000180009C05 8B 07                                 mov     eax, [rdi]
        .text:0000000180009C07 49 FF C0                              inc     r8
        .text:0000000180009C0A 33 C5                                 xor     eax, ebp
        .text:0000000180009C0C 89 04 3A                              mov     [rdx+rdi], eax
        .text:0000000180009C0F 48 8D 7F 04                           lea     rdi, [rdi+4]
        .text:0000000180009C13 4C 3B C1                              cmp     r8, rcx
        */
        $decrypt_string_x64_1 = { 8b 07 49 ff c? 33 c5 89 04 3a 48 8d 7f 04 4c 3b c? }
        /*
        .text:000000018001557A 42 8B 04 03                                   mov     eax, [rbx+r8]
        .text:000000018001557E 49 FF C1                                      inc     r9
        .text:0000000180015581 41 33 00                                      xor     eax, [r8]
        .text:0000000180015584 33 C7                                         xor     eax, edi
        .text:0000000180015586 41 89 00                                      mov     [r8], eax
        */
        $decrypt_string_x64_2 = { 42 8b 04 03 49 ff c1 41 33 00 33 c7 41 89 00 }
        /*
        .text:0000000180005F04 42 8B 04 03                             mov     eax, [rbx+r8]
        .text:0000000180005F08 49 FF C1                                inc     r9
        .text:0000000180005F0B 33 C7                                   xor     eax, edi
        .text:0000000180005F0D 41 31 00                                xor     [r8], eax
        .text:0000000180005F10 4D 8D 40 04                             lea     r8, [r8+4]
        */
        $decrypt_string_x64_3 = { 42 8b 04 03 49 ff c1 33 c7 41 31 00 4d 8d 40 04 }
        /*
        .text:0000000180015045 33 CD                                   xor     ecx, ebp
        .text:0000000180015047 0F B6 C1                                movzx   eax, cl
        .text:000000018001504A 66 41 89 00                             mov     [r8], ax
        .text:000000018001504E 0F B7 C1                                movzx   eax, cx
        .text:0000000180015051 C1 E9 10                                shr     ecx, 10h
        */
        $decrypt_string_x64_4 = { 33 cd 0f b6 c1 66 41 89 00 0f b7 c1 c1 e9 10 }
        /*
        .text:000000018001A36B 8B CD                                   mov     ecx, ebp
        .text:000000018001A36D 49 FF C3                                inc     r11
        .text:000000018001A370 33 0B                                   xor     ecx, [rbx]
        .text:000000018001A372 48 8D 5B 04                             lea     rbx, [rbx+4]
        .text:000000018001A376 0F B6 C1                                movzx   eax, cl
        */
        $decrypt_string_x64_5 = { 8b cd 49 ff c3 33 0b 48 8d 5b 04 0f b6 c? }
        /*
        This check is performed on Emotet plugin DLL EntryPoint function
        .text:10001719 83 7D 0C 10                                   cmp     [ebp+fdwReason], 10h
        .text:1000171D 74 0E                                         jz      short loc_1000172D
        */
        $dll_ep1 = { 83 7d 0c 10 74 }
        /*
        This check is performed on Emotet plugin DLL EntryPoint function
        .text:0000000180006E4E 83 FA 64                                cmp     edx, 64h ; 'd'
        .text:0000000180006E51 0F 85 9D 00 00 00                       jnz     loc_180006EF4
        */
        $dll_ep2 = { 83 fa 64 0f 85 }
        /*
        This check is performed on Emotet plugin DLL EntryPoint function
        .text:00000001800016C3 83 FA 64                                cmp     edx, 64h ; 'd'
        .text:00000001800016C6 75 6B                                   jnz     short loc_180001733
        */
        $dll_ep3 = { 83 fa 64 75 6b }
    condition:
        uint16(0) == 0x5a4d and
        (any of ($dll_ep*)) and
        ($decrypt_string_2 or (any of ($decrypt_string_x64*))) and
        filesize < 600KB
}

