        last_modified = "2024-05-17"
        malware_family = "VeiledLoader"
    strings:
        /*
        mov     rax, r9
        inc     r9
        and     eax, 0Fh
        movzx   ecx, byte ptr [rax+rbx]
        add     ecx, r11d
        add     ecx, edx
        movzx   r11d, cl
        */
        $ = {
        49 8b c1
        49 ff c1
        83 e0 0f
        0f b6 0c 18
        41 03 cb
        03 ca
        44 0f b6 d9
        }
        /*
        add     ecx, 4
        mov     r8d, r10d
        mov     edx, r10d
        add     rcx, r11
        mov     rdi, rcx
        sub     rdi, r11
        cmp     r11, rcx
        cmova   rdi, r10
        test    rdi, rdi
        */
        $ = {
        83 c1 04
        45 8b c2
        41 8b d2
        49 03 cb
        48 8b f9
        49 2b fb
        4c 3b d9
        49 0f 47 fa
        48 85 ff
        }
        /*
        mov     [rcx], al
        inc     eax
        lea     rcx, [rcx+1]
        cmp     eax, r8d
        jb      short START
        */
        $ = {
        88 01
        ff c0
        48 8d 49 01
        41 3b c0
        72 f3
        }
    condition:
        2 of them
}

