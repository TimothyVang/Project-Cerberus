}

rule CrowdStrike_CSIT_23188_01 : loader pika_bot pikabot 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Function name hashes and anti-sandbox code found in PikaBot"
        reports = "CSIT-23188"
        version = "202402011040"
        last_modified = "2024-02-01"
        malware_family = "PikaBot"
    strings:
        $hash_1 = { ba 75 fe 5b 89 a3 }
        $hash_2 = { ba 49 91 fb 87 a3 }
        $anti_1 = { 0f 31 89 55 ?? 89 45 ?? 33 c0 b8 05 00 00 00 c1 e8 02 2b c3 3b c1 0f 31 89 55 ?? 89 45 ?? }
        $anti_2 = { 33 c0 50 51 58 59 2b c8 }
        $anti_3 = { 8a 96 00 00 fe 7f 84 d2 }
        // October 2023
        /*
        .text:10029F90 58                      pop     eax
        .text:10029F91 A3 00 90 03 10          mov     g_x86_return_address, eax
        .text:10029F96 54                      push    esp
        .text:10029F97 58                      pop     eax
        .text:10029F98 83 C0 04                add     eax, 4
        .text:10029F9B FF 30                   push    dword ptr [eax]
        .text:10029F9D 8F 05 04 90 03 10     pop     g_x64_return_address
        .text:10029FA3 83 C0 04                add     eax, 4
        .text:10029FA6 50                      push    eax
        .text:10029FA7 8F 05 08 90 03 10    pop     g_x86_saved_stack
        .text:10029FAD E8 0F 34 FF FF          call    pikabot__get_function_syscall_number
        */
        $x64_heavens_gate = { 58 a3 ?? ?? ?? ?? 54 58 83 c0 04 ff 30 8f 05 ?? ?? ?? ?? 83 c0 04 50 8f 05 ?? ?? ?? ?? e8 }
        /*
        pikabot::resolve_apis
        E8 E7 FF FF FF      call    pikabot__resolve_kernel32_dll
        BA A5 1A A3 B0      mov     edx, 0B0A31AA5h
        A3 BC AA 03 10      mov     dword_1003AABC, eax
        8B C8               mov     ecx, eax
        E8 C2 F5 FF FF      call    pikabot__resolve_function
        8B 0D BC AA 03 10   mov     ecx, dword_1003AABC
        BA F9 54 50 7F      mov     edx, 7F5054F9h
        A3 B8 AA 03 10      mov     dword_1003AAB8, eax
        E8 AD F5 FF FF      call    pikabot__resolve_function
        A3 C0 AA 03 10      mov     dword_1003AAC0, eax
        C3                  retn
        */
        $resolve_api_code = { e8 [4] ba [4] a3 [4] 8b c8 e8 [4] 8b 0d [4] ba [4] a3 [4] e8 [4] a3 [4] c3 }
    condition:
        uint16(0) == 0x5a4d and
        all of ($hash_*) or all of ($anti_*) or ($x64_heavens_gate and (any of ($hash_*)) or (any of ($anti_*))) or $resolve_api_code
}

