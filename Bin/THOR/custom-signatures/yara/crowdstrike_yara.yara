        8B 55 ??
        8B 46 ??
        E8 ?? ?? ?? ??
        8D 55 ??
        A1 ?? ?? ?? ??
        E8 ?? ?? ?? ??
        }
        // Generate AES key and IV char-by-char
        $code_aeskeyiv = {
        C7 85 ?? ?? ?? ?? 01 00 00 00
        B8 00 01 00 00
        E8 ?? ?? ?? ??
        8B D0
        8D 85 ?? ?? ?? ??
        E8 ?? ?? ?? ??
        8B 95 ?? ?? ?? ??
        8D 45 ??
        E8 ?? ?? ?? ??
        83 BD ?? ?? ?? ?? 10
        7F ??
        B8 00 01 00 00
        E8 ?? ?? ?? ??
        8B D0
        8D 85 ?? ?? ?? ??
        E8 ?? ?? ?? ??
        8B 95 ?? ?? ?? ??
        8D 45 ??
