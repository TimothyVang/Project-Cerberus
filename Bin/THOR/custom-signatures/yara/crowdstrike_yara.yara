rule CrowdStrike_CSIT_24237_03 : lotus_panda trap_door 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Distinctive strings found in Trapdoor samples"
        reports = "CSIT-24237"
        version = "202410111811"
        last_modified = "2024-10-11"
        actor = "LOTUS PANDA"
        malware_family = "TrapDoor"
    strings:
        $ = "~vminst.log"
        $ = ",IJA %s"
        $ = "[+] ServiceMain(%d, %s)"
        $ = "%04d.%02d.%02d %02d:%02d:%02d"
        $ = "[!] socket(): %ld"
        $ = "[!] ServerReceiveCommand().Unknow command code.error.[0x%02x,0x%02x]."
        $ = "[!] command_code_download.recvfrom(%d) error.error code:%u"
        $ = "[!] handle_command_code_upload().CreateFileA( %u ).error."
        $ = "[!] Failed to create ReadShell session thread, error = %d"
        $ = "[!] command_code_download.recvfrom() error.error code:%u"
        $ = "[!] handle_command_code_upload().decrypt_data().error."
        $ = "[!] handle_command_code_upload().encrypt_data().error."
        $ = "[!] Failed to create shell stdout pipe, error code= %s"
        $ = "[!] command_code_upload. data len= %d > 100*1024*1024"
        $ = "[!] not command_code_download.error.[0x%02x,0x%02x]."
        $ = "[!] Error listening on socket. [%s:%d] error code:%d"
        $ = "[!] not command_code_inbound.error.[0x%02x,0x%02x]."
        $ = "[!] not command_code_upload.error.[0x%02x,0x%02x]."
        $ = "[+] command_code_download. path len= %d. path: %s"
        $ = "[!] Failed to create shell stdin pipe, error = %s"
        $ = "[!] ServerReceiveCommand().decrypt_data().error."
        $ = "[!] SessionReadShellThreadFn exitted, error = %d"
        $ = "[+] command_code_download code.[0x%02x,0x%02x]."
        $ = "[!] command_code_upload. path len= %d. path: %s"
        $ = "[!] not command_code_nop.error.[0x%02x,0x%02x]."
        $ = "[+] command_code_inbound code.[0x%02x,0x%02x]."
        $ = "[+] command_code_cmdinfo code.[0x%02x,0x%02x]."
        $ = "[!] command_code_download. path len= %d > 256"
        $ = "[+] command_code_upload code.[0x%02x,0x%02x]."
        $ = "[+] ----------cmd console [ %s:%d ]----------"
        $ = "[!] command_code_upload. path len= %d > 256"
        $ = "[!] command_code_download.recvfrom() %d <6"
        $ = "[+] command_code_nop code.[0x%02x,0x%02x]."
        $ = "[!] bound.Tread.[ Handle:%u ThreadId:%u ]"
        $ = "[!] RegQueryValueEx() error.error code:%u"
        $ = "[!] bind() failed. [%s:%d] error code:%d"
        $ = "[+] ------cmd command [ %s ]-----------"
        $ = "[+] command_code_cmdinfo len= %d > 2000"
        $ = "[!] Failed to execute shell, error = %d"
        $ = "[!] bound.CreateThread().error code:%u"
        $ = "[!] RegOpenKeyEx() error.error code:%u"
        $ = "[!] memcmp() error.cryptkey error???"
        $ = "[!] WaitForMultipleObjects error: %d"
        $ = "[+] SessionWriteShellThreadFn() end."
        $ = "[+] SessionReadShellThreadFn() end."
        $ = "[!] recvfrom() error.error code:%u"
        $ = "[+] connecting.bound.[ %s:%d %s ]"
        $ = "[+] Receive From [%s:%d].byte=%d"
        $ = "[!] recvfrom(%d).error code: %ld"
        $ = "[!] sendto() error.error code:%u"
        $ = "[!] getsockopt(). error code:%ld"
        $ = "[+] accept().connected. [%s:%d]"
        $ = "[!] error.Len Fields [ %d ]!=12"
        $ = "[!] CreatePipe().error code:%u"
        $ = "[!] error.recv bytes [ %d ]<38"
        $ = "[!] Error at WSASocketA(): %ld"
        $ = "[!] recvfrom().error code:%ld"
        $ = "[!] error.recv bytes [ %d ]<6"
        $ = "[+] Listenning ...[%s:%d] ..."
        $ = "[!] len fields error.[ %d ]."
        $ = "[!] Failed to execute shell"
        $ = "[!] sendto() error.%d!=%d"
        $ = "[!] sendto() error.%d!=38"
        $ = "[!] Error at WSAStartup()"
        $ = "[+] InteractiveCMD() end."
        $ = "[!] error.bound.Port:%u"
        $ = "[!] setsockopt(): %ld"
        $ = "[!] file size > 100M"
        $ = "[+] port:%u  key:%s"
        $ = "[!] connect(): %ld"
        $ = "SO_RCVTIMEO Value: %ld"
        $ = "SO_SNDTIMEO Value: %ld"
        $ = "SO_SNDBUF Value: %ld"
        $ = "SO_RCVBUF Value: %ld"
    condition:
        4 of them
}

