rule CrowdStrike_CSIT_21116_02 : ipsechelper profanetalon rat spectral_kitten 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects SPECTRAL KITTEN IPSecHelper RAT through characteristic embedded commands and names"
        reports = "CSIT-21116"
        version = "202203251723"
        last_modified = "2022-03-25"
        actor = "SPECTRAL KITTEN"
        malware_family = "IPSecHelper"
        activity_cluster = "ProfaneTalon"
    strings:
        $ = "CommandClass.IsCmAvailable" ascii wide
        $ = "CommandClass.ProcessId" ascii wide
        $ = "CommandClass.SendProcessId" ascii wide
        $ = "ConfigClass.SelfDelete" ascii wide
        $ = "ConfigClass.GetConfigPathFromRegistry" ascii wide
        $ = "741952hheeyy66#cs!9hjv887mxx7@8y" ascii wide
        $ = "EncryptionClass.Decrypt" ascii wide
        $ = "PING 127.0.0.1 -n 20" ascii wide
        $ = "%windir%\\system32\\rundll32.exe advapi32.dll,ProcessIdleTasks" ascii wide
        $ = "%FIRSTPART%%DOTNETVER%%SECONDPART% /U /name=\"%SERVICENAME%\" \"%PROG%%SERVICE_EXE%\"" ascii wide
    condition:
        uint16(0) == 0x5A4D and
        uint32(uint32(0x3C)) == 0x00004550 and
        3 of them
}

