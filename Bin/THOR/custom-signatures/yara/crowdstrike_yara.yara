        $ETH_PRECHECK_2 = { 8b [2-5] 33 c9 66 8b 08 83 f9 30 [2-6] 8b [2-5] 33 c0 66 8b 42 02 83 f8 78 }
        $ETH_PRECHECK_3 = { 8b [2-5] 33 c0 66 8b 02 83 f8 30 [2-6] 8b [2-5] 33 d2 66 8b 51 02 83 fa 78 }
        /**
        for ( i = lpString;
        *i >= (unsigned int)'a' && *i <= (unsigned int)'f'
        || *i >= (unsigned int)'A' && *i <= (unsigned int)'F'
        || *i >= (unsigned int)'0' && *i <= (unsigned int)'9';
