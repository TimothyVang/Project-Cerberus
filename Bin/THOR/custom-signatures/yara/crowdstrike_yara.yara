rule CrowdStrike_EggrollLoader_02 : eggroll loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic 64-bit string decryption code for low-prevalence, likely China nexus typical packer and loader"
        version = "202508080914"
        last_modified = "2025-08-08"
        malware_family = "EggrollLoader"
    strings:
        $dp = {
        0f b6 14 0a             // movzx   edx, byte ptr [rdx+rcx]
        83 f2 ??                // xor     edx, key
        }
        $dc = {
        8b 95 ?? ?? ?? ff       // mov     edx, [rbp-??]
        48 8d 0d ?? ?? ?? 00    // lea     rcx, ENCRYPTED_DATA
        0f b6 14 11             // movzx   edx, byte ptr [rcx+rdx]
        83 f2 ??                // xor     edx, KEY
        8b 8d ?? ?? ?? ff       // mov     ecx, [rbp-??]
        4c 8d 05 ?? ?? ?? 00    // lea     r8, ENCRYPTED_DATA
        41 88 14 08             // mov     [r8+rcx], dl
        }
        $fp = /FPC \d\.\d\.\d \[\d\d\d\d\/\d\d\/\d\d\]/
    condition:
        all of them
        and #dp == 1
        and #dc == 1
        and uint32(@dc + 9) - uint32(@dc + 29) == 20
        and uint8(@dc + 19) == uint8(@dp + 6)
}

