import "dotnet"

rule CrowdStrike_CSA_250244_03 : qhain 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic function names in Qhain PDF payloads"
        reports = "CSA-250244"
        version = "202502280950"
        last_modified = "2025-02-28"
        malware_family = "Qhain"
    strings:
        $f1 = "Close"
        $f2 = "SetReadCb"
        $f3 = "Write"
        $f4 = "Start"
        $d1 = "Finalize"
        $d2 = "~Program"
        $c1 = "Program"
    condition:
        all of ($f*) and any of ($d*) and all of ($c*) and
        dotnet.is_dotnet and
        dotnet.assembly.name startswith "PDF_" and
        for any i in (0 .. dotnet.number_of_classes) : (
        dotnet.classes[i].name == "Program" and
        dotnet.classes[i].number_of_methods >= 4 and
        for 4 m in (0 .. dotnet.classes[i].number_of_methods) : (
        dotnet.classes[i].methods[m].name == "Start" or
        dotnet.classes[i].methods[m].name == "SetReadCb" or
        dotnet.classes[i].methods[m].name == "Write" or
        dotnet.classes[i].methods[m].name == "Close"
        )
        )
}

import "dotnet"

rule CrowdStrike_CSA_250244_02 : qhain 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic function names in Qhain PD payloads"
        reports = "CSA-250244"
        version = "202502280950"
        last_modified = "2025-02-28"
        malware_family = "Qhain"
    strings:
        $f1 = "Input"
        $f2 = "SetOutputCb"
        $f3 = "Start"
        $d1 = "Finalize"
        $d2 = "~Program"
        $d3 = "~Implement"
        $c1 = "Program"
        $c2 = "Implement"
    condition:
        all of ($f*) and any of ($d*) and all of ($c*) and
        dotnet.is_dotnet and
        dotnet.assembly.name startswith "PD_" and
        for 2 i in (0 .. dotnet.number_of_classes) : (
        (
        dotnet.classes[i].name == "Program" and
        dotnet.classes[i].number_of_methods >= 3 and
        for 3 m in (0 .. dotnet.classes[i].number_of_methods) : (
        dotnet.classes[i].methods[m].name == "Start" or
        dotnet.classes[i].methods[m].name == "SetOutputCb" or
        dotnet.classes[i].methods[m].name == "Input"
        )
        ) or (
        dotnet.classes[i].name == "Implement" and
        dotnet.classes[i].number_of_methods >= 1 and
        for any m in (0 .. dotnet.classes[i].number_of_methods) : (
        dotnet.classes[i].methods[m].name == "Start"
        )
        )
        )
}

