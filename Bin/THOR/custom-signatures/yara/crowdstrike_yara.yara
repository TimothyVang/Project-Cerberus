rule CrowdStrike_Untypistown_NWJS_Adware_Executable
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Adware written in JavaScript, packaged as a Windows executable with the NW.js framework; typically distributed in NSIS installers."
        version = "202303171036"
        last_modified = "2023-03-17"
    strings:
        $zip_magic = "PK"
        $zip_filename_0 = "index.html"
        $zip_filename_1 = "package.json"
        $zip_filename_2 = ".bin"
        $libname_0 = "nw_elf"
        $imports_0 = "GetInstallDetailsPayload"
        $imports_1 = "IsBrowserProcess"
        $imports_2 = "IsExtensionPointDisableSet"
        $imports_3 = "SignalChromeElf"
        $misc_unique_string_0 = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
        $misc_unique_string_1 = "setItem"
        $misc_unique_string_2 = "removeItem"
        $misc_unique_string_3 = "application/x-www-form-urlencoded"
        $misc_unique_string_4 = "aes-256-cbc"
        $misc_unique_string_5 = "createDecipheriv"
