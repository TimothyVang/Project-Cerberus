rule CrowdStrike_CSIT_24193_01 : dotnet ice_basilisk iis 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Collection of characteristic string sequences of IceBasilisk assemblies"
        reports = "CSA-250331,CSA-250341,CSIT-24193"
        version = "202503171909"
        last_modified = "2025-03-17"
        malware_family = "IceBasilisk"
    strings:
        // TEP trailers
        $ = { 00 07 54 00 45 00 50 00 00 11 74 00 72 00 61 00 69 00 6c 00 65 00 72 00 73 00 }
        // Sec-Fetcah-Dest
        $ = { 1f 53 00 65 00 63 00 2d 00 46 00 65 00 74 00 63 00 61 00 68 00 2d 00 44 00 65 00 73 00 74 00 }
        // .details display.
        $ = { 13 2e 00 64 00 65 00 74  00 61 00 69 00 6c 00 73
        00 20 00 00 13 20 00 64  00 69 00 73 00 70 00 6c
        00 61 00 79 00 2e 00 }
        // .details show.
        $ = { 13 2e 00 64 00 65 00 74 00 61 00 69 00 6c 00 73 00 20 00 00 0d 20 00 73 00 68 00 6f 00 77 00 2e 00 }
        // If-None-Matche
        $ = { 1d 49 00 66 00 2d 00 4e 00 6f 00 6e 00 65 00 2d 00 4d 00 61 00 74 00 63 00 68 00 65 00 }
        // Sec-CPC 1
        $ = { 0f 53 00 65 00 63 00 2d 00 43 00 50 00 43 00 01 03 31 00 00 }
        // AddHeaderSystem.TextEncodingget_ASCIIGetBytesConvertToBase64StringWriteFlushEndException
        $ = { 41 64 64 48 65 61 64 65  72 00 53 79 73 74 65 6d
        2e 54 65 78 74 00 45 6e  63 6f 64 69 6e 67 00 67
        65 74 5f 41 53 43 49 49  00 47 65 74 42 79 74 65
        73 00 43 6f 6e 76 65 72  74 00 54 6f 42 61 73 65
        36 34 53 74 72 69 6e 67  00 57 72 69 74 65 00 46
        6c 75 73 68 00 45 6e 64  00 45 78 63 65 70 74 69
        6f 6e 00 }
        $ = " :::Not found\n" wide
    condition:
        uint16(0) == 0x5A4D and uint32(uint32(0x3C)) == 0x00004550 and
        // Mono/.NET 32bit
        ((uint16(uint32(0x3c)+24) == 0x010b and int32(uint32(0x3c)+232) > 0) or
        // Mono/.NET 64bit
        (uint16(uint32(0x3c)+24) == 0x020b and int32(uint32(0x3c)+248) > 0)) and
        any of them and
        filesize < 50KB
}

