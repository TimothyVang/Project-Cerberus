        // .data:006E83D6 a300            db '300',0
        // .data:006E83DA a400            db '400',0
        // .data:006E83DE a500            db '500',0
        // .data:006E83DE a500            db '555',0 ?
        // .data:006E83E2 a666            db '600',0 ?
        // .data:006E83E2 a666            db '666',0
        $pattern = {
