        // neg     eax
        $luhn_final = {
        B867666666 F7EB C1FA02 8BC2 C1E81F 03C2 8D0480 8D0C00 8BC3
        2BC1 F7D8
        }
        // movsx   edx, byte ptr [esi+edx]
        // push    edx             ; int
        // call    _isdigit
        // add     esp, 4
        // test    eax, eax
        // jz      short loc_40A45E
        // mov     eax, [ebp+CreditCardNumber]
        // movsx   ecx, byte ptr [esi+eax]
        // sub     ecx, 30h ; '0'
        // test    edi, edi
        // jz      short loc_40A448
        // add     ecx, ecx
        // cmp     ecx, 9
        // jle     short loc_40A448
        $luhn_checkdigit = {
        0FBE1416 52 E8???????? 83C404 85C0 74?? 8B45?? 0FBE0C06
        83E930 85FF 74?? 03C9 83F909 7E??
        }
        // mov     eax, 66666667h
        // imul    ecx
        // sar     edx, 2
        // mov     eax, edx
        // shr     eax, 1Fh
        // add     eax, edx
        // lea     edx, [eax+eax*4]
        // add     edx, edx
        // mov     eax, 1
