        description = "Detects SunDawn ransomware used by NEMESIS KITTEN through characteristic command line strings"
        reports = "CSA-210821"
        version = "202203251724"
        last_modified = "2022-03-25"
        actor = "NEMESIS KITTEN"
        malware_family = "SunDawn"
    strings:
        $ = "expand 32-byte k"
        $ = "How To Restore Your Files.txt" wide
        $ = "select * from Win32_ShadowCopy" wide
        $ = "Calling GetSystemInfo..." wide
        $ = "/c ECHO \"You must restart the program to resolve a critical error"
        $ = "/c PING -n 5 127.0.0.1 > NUL && del \""
    condition:
        uint16(0) == 0x5A4D and
        uint32(uint32(0x3C)) == 0x00004550 and
        4 of them
}

rule CrowdStrike_CSA_210926_02 : c2 cozy_bear stellarparticle trailblazer unpacked 
