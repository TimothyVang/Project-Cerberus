rule CrowdStrike_CSA_230192_01 : downloader ecrime lightning_spider satacom unpacked vult 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "RC4 decryption and unique strings from Satacom JSON task configuration"
        reports = "CSA-230192,CSA-230782,CSA-231676,CSA-231737,CSA-240061,CSA-240147,CSA-240225,CSA-240384,CSA-240561,CSA-250225,CSIT-23128,CSIT-23130,CSIT-24088"
        version = "202502172132"
        last_modified = "2025-02-17"
        actor = "LIGHTNING SPIDER"
        malware_family = "Satacom"
    strings:
        /* RC4 Sbox initialization optimized
        using Intel SSE instructions
        */
        $rc4_sse_optimized_sbox_init_0 = { 66 0f fe c1 0f 11 42 a0 }
        $rc4_sse_optimized_sbox_init_1 = { 66 0f fe c1 0f 11 42 b0 }
        $rc4_sse_optimized_sbox_init_2 = { 66 0f fe c1 0f 11 42 c0 }
        $rc4_sse_optimized_sbox_init_3 = { 66 0f fe c1 0f 11 42 d0 }
        /* Name strings from JSON name-value
        pairs contained in Satacom task configurations
        */
        $task_config_0 = "crypto_domain" wide ascii
        $task_config_1 = "moderation" wide ascii
        $task_config_2 = "int_point" wide ascii
        $task_config_3 = "nonencrypt" wide ascii
        $task_config_4 = "pops" wide ascii
        $task_config_5 = "postback_url" wide ascii
        $task_config_6 = "postback_path" wide ascii
        $task_config_7 = "postback_id" wide ascii
        $task_config_8 = "powershell" wide ascii
        /* Informational labels for parameters exchanged
        in Satacom communications traffic
        */
        $info_str_0 = "windows_version" wide ascii
        $info_str_1 = "status_code" wide ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        2 of ($rc4_sse_optimized_sbox_init_*) and
        5 of ($task_config_*) and
        1 of ($info_str_*)
}

