rule CrowdStrike_CSIT_24155_01 : knock_backdoor 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects KnockBackdoor"
        reports = "CSA-240982,CSA-241078,CSIT-24155,CSIT-24168"
        version = "202503191630"
        last_modified = "2025-03-19"
        malware_family = "KongTuke"
    strings:
        $rc4_length = {4? 81 [1-3] (ff 00 00 00|00 01 00 00) 7? ??}
        $sleep_export = {b? e8 03 00 00 [0-7] ff (15|d?) ?? ?? ?? ??}
        $memory_division_check_0 = {b? 00 00 10 00 4? f7 f?}
        $memory_division_check_1 = {4? 8b 4? [1-2] 4? c1 e8 14}
        $format_string_0 = "%\"%ls\",%ls %ls" ascii wide
        $format_string_1 = "\"%ls\",%ls %ls"  ascii wide
        $format_string_2 = "%ls\\%ls \"%ls\"" ascii wide
        $rundll32 = "rundll32.exe" ascii wide
        $export_0 = {00 53 74 61 72 74 00}                                              // Start
        $export_1 = {00 6c 52 65 67 69 73 74 65 72 53 65 72 76 65 72 45 78 00}       // DllRegisterServerEx
        $export_2 = {00 6c 52 65 67 69 73 74 65 72 53 65 72 76 65 72 00}             // DllRegisterServer
        $export_3 = {00 44 6c 6c 55 6e 72 65 67 69 73 74 65 72 53 65 72 76 65 72 00} // DllUnregisterServer
        $export_4 = {00 44 6c 6c 47 65 74 43 6c 61 73 73 4f 62 6a 65 63 74 00}       // DllGetClassObject
    condition:
        uint16(0) == 0x5a4d
        and uint32(uint32(0x3c)) == 0x00004550
        and filesize < 1MB
        and $rc4_length
        and $sleep_export
        and 1 of ($memory_division_check_*)
        and (
        (
        // Not DLL
        (uint16(uint32(0x3c) + 0x16) & 0x2000) != 0x2000
        and 1 of ($format_string_*)
        )
        or (
        // DLL
        (uint16(uint32(0x3c) + 0x16) & 0x2000) == 0x2000
        and 2 of ($export_*)
        and (
        1 of ($format_string_*)
        or $rundll32
        )
        )
        )
}

