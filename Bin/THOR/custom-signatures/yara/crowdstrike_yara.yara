        and
        for any method in class.methods : (
        method.name == "X" and method.visibility == "private" and method.number_of_parameters == 3 and
        method.parameters[0].type == "string" and  method.parameters[1].type == "string" and
        method.parameters[2].type == "object"
        )
        )
}

