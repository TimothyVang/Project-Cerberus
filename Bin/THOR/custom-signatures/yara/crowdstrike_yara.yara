rule CrowdStrike_AdaptixC2_Agent : c2 rat 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "The default command and control agent for the AdaptixC2 post-exploitation framework (https://github.com/Adaptix-Framework/AdaptixC2/)."
        version = "202507311932"
        last_modified = "2025-07-31"
    strings:
        $mingw = "Mingw-w64 runtime failure:"
        $api_hash_djb2_seed_1572_0 = { fa d0 59 11 } // "LoadLibraryA"
        $api_hash_djb2_seed_1572_1 = { 20 28 ba 1c } // "CopyFileA"
        $api_hash_djb2_seed_1572_2 = { 14 86 34 7b } // "kernel32"
        $api_hash_djb2_seed_1572_3 = { d8 08 57 57 } // "InternetOpenA"
        /*
        1400060dc  817c244821230000   cmp     dword [rsp+0x48 {var_18_1}], 0x2321 (COMMAND_SAVEMEMORY)
        1400060e4  0f847a040000       je      0x140006564
        */
        $c2_dispatcher_command_constant_SAVEMEMORY = { 21 23 00 00 }
        /*
        14000266d  b988000000         mov     ecx, 0x88
        140002672  e8d9c10000         call    mw::MemAllocLocal
        */
        $memory_allocation_call_with_specific_size_0 = { b988000000 e8 }
        /*
        14000e3dc  b9fcff0f00         mov     ecx, 0xffffc
        14000e3e1  e86a040000         call    mw::MemAllocLocal
        */
        $memory_allocation_call_with_specific_size_1 = { b9fcff0f00 e8 }
        /*
        14000a7e3  b968000000         mov     ecx, 0x68
        14000a7e8  e863400000         call    mw::MemAllocLocal
        */
        $memory_allocation_call_with_specific_size_2 = { b968000000 e8 }
        /*
        140002795  b928000000         mov     ecx, 0x28
        14000279a  e8b1c00000         call    mw::MemAllocLocal
        */
        $memory_allocation_call_with_specific_size_3 = { b928000000 e8 }
        /*
        1400079ab  baffff1111         mov     edx, 0x1111ffff (COMMAND_ERROR)
        1400079b0  4889c1             mov     rcx, rax
        1400079b3  e80e390000         call    mw::Packer::Pack32
        */
        $pack32_call_command_constant_COMMAND_ERROR = { ba ff ff 11 11 48 89 ?? e8 }
    condition:
        $mingw
        and #pack32_call_command_constant_COMMAND_ERROR >= 5
        and 5 of ($api_hash_djb2_seed_1572_*, $c2_dispatcher_command_constant_SAVEMEMORY, $memory_allocation_call_with_specific_size_*)
}

