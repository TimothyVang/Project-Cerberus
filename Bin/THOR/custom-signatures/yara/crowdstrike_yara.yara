rule CrowdStrike_MultiPartXLLDropperX64 : dropper 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unrolled copy loop opcodes of a malicious XLL dropper"
        version = "202202111010"
        last_modified = "2022-02-11"
    strings:
        $load = {
        48 8d 92 80 00 00 00  // lea     rdx, [rdx+80h]
        0f 10 00              // movups  xmm0, xmmword ptr [rax]
        0f 10 48 10           // movups  xmm1, xmmword ptr [rax+10h]
        48 8d 80 80 00 00 00  // lea     rax, [rax+80h]
        0f 11 42 80           // movups  xmmword ptr [rdx-80h], xmm0
        0f 10 40 a0           // movups  xmm0, xmmword ptr [rax-60h]
        0f 11 4a 90           // movups  xmmword ptr [rdx-70h], xmm1
        0f 10 48 b0           // movups  xmm1, xmmword ptr [rax-50h]
        0f 11 42 a0           // movups  xmmword ptr [rdx-60h], xmm0
        0f 10 40 c0           // movups  xmm0, xmmword ptr [rax-40h]
        0f 11 4a b0           // movups  xmmword ptr [rdx-50h], xmm1
        0f 10 48 d0           // movups  xmm1, xmmword ptr [rax-30h]
        0f 11 42 c0           // movups  xmmword ptr [rdx-40h], xmm0
        0f 10 40 e0           // movups  xmm0, xmmword ptr [rax-20h]
        0f 11 4a d0           // movups  xmmword ptr [rdx-30h], xmm1
        0f 10 48 f0           // movups  xmm1, xmmword ptr [rax-10h]
        0f 11 42 e0           // movups  xmmword ptr [rdx-20h], xmm0
        0f 11 4a f0           // movups  xmmword ptr [rdx-10h], xmm1
        48 83 e9 01           // sub     rcx, 1
        }
        $ = "xlAutoOpen"
    condition:
        all of them
        and #load > 3
}

