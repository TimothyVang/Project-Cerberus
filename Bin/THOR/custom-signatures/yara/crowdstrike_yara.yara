        4C 8D 05 [4]         //  lea   r8, Format     ; "%s%s%s%s"
        BA 08 00 00 00       //  mov   edx, 8         ; BufferCount
        48 8D 4C 24 ??       //  lea   rcx, [rsp+??]  ; Buffer
        E8                   //  call  snprintf
        }
        $x32sprintf = {
        68 [4]               //  push  offset aSSSS   ; "%s%s%s%s"
        6A 08                //  push  8
        (
        8D 55 ??         //  lea   edx, [ebp-??]
        52               //  push  edx
        |
        68 ?? ?? ?? ??   //  push  Buffer
        )
        E8                   //  call  snprintf
        }
        $fmt1 = "%s%s%s%s" ascii fullword
        $fmt2 = /c\x00{0,3}m\x00{0,3}d\x00{0,3}\.\x00{0,3}e\x00{0,3}x\x00{0,3}e\x00/
        $api1 = "CreateProcessA"
        $api2 = "WSASocketA"
