rule CrowdStrike_CSIT_25099_02 : apolog ecrime lightning_spider loader unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Custom encryption algorithm arithmetic shifts and CRC32 polynomial with memory allocation API strings used by Apolog loaders introduced in March 2025"
        reports = "CSIT-25099"
        version = "202504182031"
        last_modified = "2025-04-18"
        actor = "LIGHTNING SPIDER"
        malware_family = "Apolog"
    strings:
        // Windows memory allocation APIs
        $alloc_mem_0 = "VirtualAlloc" ascii
        $alloc_mem_1 = "GetProcessHeap" ascii
        $alloc_mem_2 = "HeapAlloc" ascii
        $alloc_mem_3 = "LocalAlloc" ascii
        $alloc_mem_4 = "LocalLock" ascii
        // CRC32 polynomial
        $crc32_poly_0 = { 20 83 b8 ed }
        $crc32_poly_1 = { b7 1d c1 04 }
        // XTEA constants
        $xtea_sum = { 20 37 ef c6 }
        $xtea_const = { b9 79 37 9e }
        $xtea_sub_const = { 47 86 c8 61 }
        // Decryption algorithm arithmetic
        $decrypt_shifts_0 = { (41 8b|8b) c? [0-10] c1 e? 06 (41 8b|8b) c? c1 e? 08 33 ?? 8b c? 83 e? 03 }
        $decrypt_shifts_1 = { (41 8b|8b) c? [0-10] c1 e? 06 c1 e? 08 33 ?? 8b c? 83 e? 03 }
        // Shellcode call and debug string setup
        $end_call_0 = { ff d3 48 8d ?d [4] 48 8b [5-20] 48 ff 25 }
        $end_call_1 = { e8 [4] 48 8d ?d [4] 48 8b [5-20] 48 ff 25 }
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and uint8(uint32(0x3c)+4) == 0x64 and uint16(uint32(0x3c)+22) == 0x2022 and
        all of ($alloc_mem_*)
        and 1 of ($crc32_poly_*)
        and (1 of ($decrypt_shifts_*) or ($xtea_sum and 1 of ($xtea_const,$xtea_sub_const)))
        and 1 of ($end_call_*)
        and filesize < 2MB
}

