        $cstr1 = "Landroid/provider/ContactsContract$CommonDataKinds$Phone"
        $cstr2 = "Landroid/accessibilityservice/AccessibilityService;"
        $cstr3 = "android/telephony/TelephonyManager"
        $cstr4 = "Landroid/view/accessibility/AccessibilityEvent"
        $cstr9 = "Landroid/view/accessibility/AccessibilityNodeInfo"
        $cstr11 = "android/provider/ContactsContract$CommonDataKinds"
        $cstr12 = "android/telephony/SmsManager"
        $dom1 = { 13 05 19 00 6e 20 ea 63 52 00 0a 05 d8 05 05 61 8e 55 6e 20 7e 63 59 00 }
        $dom2 = { 13 0c 19 00 6e 20 9f 0c c2 00 0a 0c d8 0c 0c 61 8e cc 6e 20 48 0c c7 00 }
        $dom3 = { 13 07 19 00 6e 20 29 03 74 00 0a 07 d8 07 07 61 8e 77 6e 20 10 03 76 00 }
        $domg = { 13 0? 19 00 6e 20 ?? ?? ?? 00 0a 0? d8 0? 0? 61 8e ?? 6e 20 ?? ?? ?? 00 }
        $dsee1 = { 71 00 ?? ?? 00 00 0c 00 12 11 6e 20 ?? ?? 10 00 0a 00 71 00 ?? ?? 00 00 0c }
    condition:
        $dex at 0
        and filesize <7MB
        and (all of ($cstr*))
        and ((1 of ($dom*)) or $domg)
        and $dsee1
}

