rule CrowdStrike_CSIT_22021_01 : demon_spider loader matanbuchus unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects unique debug strings observed in Matanbuchus main stage downloader malware"
        reports = "CSA-220509,CSA-220632,CSA-240317,CSA-240763,CSIT-22021,CSIT-22077"
        version = "202407031932"
        last_modified = "2024-07-03"
        actor = "DEMON SPIDER"
        malware_family = "Matanbuchus"
    strings:
        /* FNV1a 32 bit hashing algorithm seed and prime
        values
        */
        $fnv1a_algorithm_seed = {
        c5 9d 1c 81
        }
        $fnv1a_algorithm_prime = {
        93 01 00 01
        }
        /* Individual 32 bit FNV1a function hashes
        used by the main stage
        */
        $fnv1a_hash_expandenvironmentstringsw = {
        01 fb 42 04
        }
        $fnv1a_hash_pathisdirectoryw = {
        aa 12 cf af
        }
        $fnv1a_hash_socket = {
        6c 76 12 90
        }
        $fnv1a_hash_gethostbyname = {
        83 c8 6e 29
        }
        $fnv1a_hash_inet_addr = {
        f3 bc 4c cc
        }
        // Generic string for Matanbuchus name
        $matan_1 = "Matanbuchus" wide ascii
        // Possible debug/error string
        $dbg_1 = "OOO BelialDemon master malware " wide ascii
        // Possible debug/error string
        $dbg_2 = "Agent.Matanbuchus" wide ascii
        // PDB path for Matanbuchus loader main stage
        $pdb_path = "B:\\Loader\\Matanbuchus\\Main module\\" wide ascii
        // Author name from JSON for Modern C++ library
        $json_lib = "nlohmann" wide ascii
        // Regsvr export
        $regsvr = "DllRegisterServer" ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        (any of ($matan_1,$dbg_*,$pdb_path) and $regsvr) or
        (all of ($fnv1a_algorithm_*) and 3 of ($fnv1a_hash_*) and $json_lib and $regsvr) and
        filesize > 200KB
}

