rule CrowdStrike_CSIT_23230_01 : cpl_rat panda rat 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Opcode sequences used in CplRAT to register plugins (64-bit)"
        reports = "CSIT-23230"
        version = "202503111353"
        last_modified = "2025-03-11"
        malware_family = "CplRAT"
    strings:
        // add the plugin named other (x64) to the plugin function table
        // 75 16                   jnz  short
        // b9 01 00 00 00          mov  ecx, 1
        // e8 ?? ?? ?? ??          call [address of new()]
        // 48 89 44 24 30          mov  [rsp+30h], rax
        // 48 89 05 ?? ?? ?? ??    mov  [address of a gobal variable], rax
        // e8 ?? ?? ?? ??          call [function address - plugin list handle]
        // 4c 8d 0d ?? ?? ?? ??    lea  r9, [address of plugin name]
        // ba 01 00 00 00          mov  edx, 1
        // 4c 8d 05 ?? ?? ?? ??    lea  r8, [address of the plugin function]
        // 48 c7 c1 ff ff ff ff    mov  rcx, 0ffffffffffffffffh
        // ff 10                   call qword ptr [rax]
        $a0 = {
        75 16
        b9 01 00 00 00
        e8 [4]
        48 89 44 24 30
        }
        $b0 = {
        48 89 05 [4]
        e8 [4]
        4c 8d 0d [4]
        ba 01 00 00 00
        4c 8d 05 [4]
        48 c7 c1 ff ff ff ff
        ff 10
        }
        // add any plugin (x64) to the plugin function table
        // 48 83 ec 28             sub  rsp, 28h
        // e8 17 ff ff ff          call [function address - plugin list handle]
        // 4c 8d 0d ?? ?? ?? ??    lea  r9, [address of plugin name]
        // ba ?? 00 00 00          mov  edx, [position of the plugin]
        // 4c 8d 05 14 00 00 00    lea  r8, [address of the plugin function]
        // 48 c7 c1 ff ff ff ff    mov  rcx, 0ffffffffffffffffh
        // 48 83 c4 28             add  rsp, 28h
        // 48 ff 20                jmp  qword ptr [rax]
        $a1 = {
        48 83 ec 28
        e8 17 ff ff ff
        4c 8d 0d [4]
        ba [1] 00 00 00
        4c 8d 05 14 00 00 00
        48 c7 c1 ff ff ff ff
        48 83 c4 28
        48 ff 20
        }
        // subset of b0
        $b1 = {
        e8 17 ff ff ff
        4c 8d 0d [4]
        ba [1] 00 00 00
        4c 8d 05 14 00 00 00
        48 c7 c1 ff ff ff ff
        }
        // creation of the plugin function table (x64)
        // 48 8d 0d 9b fd ff ff    lea  rcx, [address function 1]
        // ba a8 00 00 00          mov  edx, 0a8h       ; dwsize
        // 48 89 08                mov  [rax], rcx
        // 4c 8d 4c 24 38          lea  r9, [rsp+38h]
        // 48 8d 0d 67 fe ff ff    lea  rcx, [address function 2]
        // 41 b8 02 00 00 00       mov  r8d, 2
        // 48 89 48 08             mov  [rax+8], rcx
        // 48 8d 0d f6 fa ff ff    lea  rcx, [address function 3]
        // 48 89 48 10             mov  [rax+10h], rcx
        // 48 8d 0d fb fa ff ff    lea  rcx, [address function 4]
        // 48 89 48 18             mov  [rax+18h], rcx
        // 48 8d 0d 00 fb ff ff    lea  rcx, [address function 5]
        // 48 89 48 20             mov  [rax+20h], rcx
        $a2 = {
        48 8d 0d 9b fd ff ff
        ba a8 00 00 00
        48 89 08
        4c 8d 4c 24 38
        48 8d 0d 67 fe ff ff
        41 b8 02 00 00 00
        }
        $b2 = {
        48 89 48 08
        48 8d 0d f6 fa ff ff
        48 89 48 10
        48 8d 0d fb fa ff ff
        48 89 48 18
        48 8d 0d 00 fb ff ff
        48 89 48 20}
    condition:
        ($a0 and $b0) or ($a1) or ($a2 and $b2) or (2 of ($b*))
}

