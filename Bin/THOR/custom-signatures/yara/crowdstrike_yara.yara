        $user_agent = "Gecko / 20100101 Chrome/73.0.3645.0"
        $b64_url_safe_mistake = { 80 f? 2b 74 05 80 f? 2f 75 04 c6 ?? ?? 5f }
        $dll_name = "WininetBodyShell.dll"
