rule CrowdStrike_CSA_240147_01 : downloader ecrime lightning_spider satacom shellcode 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "CRC32 function hashes and XTEA encryption constants included in a shellcode loader embedded in Satacom v2 builds"
        reports = "CSA-240147,CSIT-24088"
        version = "202501312118"
        last_modified = "2025-01-31"
        actor = "LIGHTNING SPIDER"
        malware_family = "Satacom"
    strings:
        /* Windows library name hashes created using the CRC32
        hashing algorithm
        */
        $crc32_lib_hash_ntdll = { 40 5e c0 84 }
        $crc32_lib_hash_kernel32 = { 02 9f e6 6a }
        /* Windows API function name hashes created using the
        CRC32 hashing algorithm
        */
        $crc32_api_hash_virtualalloc = { 4a 0d ce 09 }
        $crc32_api_hash_virtualfree = { dd f5 53 cd }
        $crc32_api_hash_loadlibrarya = { 8d bd c1 3f }
        $crc32_api_hash_getprocaddress = { ff 1f 7c c9 }
        $crc32_api_hash_tlsalloc = { 27 37 9e 16 }
        $crc32_api_hash_flsfree = { e9 7b ab b7 }
        $crc32_api_hash_tlssetvalue = { 39 5c 15 29 }
        $crc32_api_hash_activateactctx = { 0c c2 a0 6a }
        $crc32_api_hash_createactctxa = { 2f 3d 8a b1 }
        /* Setup of constants used by the XTEA
        decryption algorithm to calculate
        arithmetic magic values
        */
        $xtea_constants = { c7 (45 ??|44 ?? ??) 20 00 00 00 c7  (45 ??|44 ?? ??) b9 79 37 9e }
    condition:
        all of ($crc32_lib_hash_*) and
        7 of ($crc32_api_hash_*) and
        $xtea_constants
}

