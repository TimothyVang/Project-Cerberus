rule CrowdStrike_WinDealer_Loader_01 : rat windealer_loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Opcode sequences from WinDealer loader executables"
        version = "202402052213"
        last_modified = "2024-02-05"
        malware_family = "WinDealerLoader"
    strings:
        /*
        8B 17           // mov     edx, [edi]
        56              // push    esi
        8B D8           // mov     ebx, eax
        52              // push    edx
        6A 01           // push    1
        53              // push    ebx
        FF 15 [4]       // call    ds:fread
        8B 3F           // mov     edi, [edi]
        83 C4 30        // add     esp, 30h
        3B C7           // cmp     eax, edi
        75 ??           // jnz     short ??
        56              // push    esi
        C6 04 1F 00     // mov     byte ptr [edi+ebx], 0
        */
        $op_read_file = {
        8b 17 56 8b d8 52 6a 01  53 ff 15 [4]         8b
        3f 83 c4 30 3b c7 75 ??  56 c6 04 1f 00
        }
        /*
        8A 14 29        // mov     dl, [ecx+ebp]
        32 D0           // xor     dl, al
        88 14 29        // mov     [ecx+ebp], dl
        41              // inc     ecx
        3B CE           // cmp     ecx, esi
        */
        $op_decrypt = { 8a 14 29 32 d0 88 14 29 41 3b ce
        }
        /*
        C6 44 24 ?? 61  // mov     [esp+238h+var_224], 61h ; 'a'
        C6 44 24 ?? 62  // mov     [esp+238h+var_223], 62h ; 'b'
        C6 44 24 ?? 63  // mov     [esp+238h+var_222], 63h ; 'c'
        C6 44 24 ?? 64  // mov     [esp+238h+var_221], 64h ; 'd'
        C6 44 24 ?? 65  // mov     [esp+238h+var_220], 65h ; 'e'
        C6 44 24 ?? 66  // mov     [esp+238h+var_21F], 66h ; 'f'
        C6 44 24 ?? 67  // mov     [esp+238h+var_21E], 67h ; 'g'
        C6 44 24 ?? 68  // mov     [esp+238h+var_21D], 68h ; 'h'
        */
        $op_loader_01 = {
        c6 44 24 ?? 61 c6 44 24  ?? 62 c6 44 24 ?? 63 c6
        44 24 ?? 64 c6 44 24 ??  65 c6 44 24 ?? 66 c6 44
        24 ?? 67 c6 44 24 ?? 68
        }
        /*
        F2 AE           // repne scasb
        F7 D1           // not     ecx
        2B F9           // sub     edi, ecx
        8B C1           // mov     eax, ecx
        8B F7           // mov     esi, edi
        8B FA           // mov     edi, edx
        C1 E9 02        // shr     ecx, 2
        F3 A5           // rep movsd
        8B C8           // mov     ecx, eax
        83 E1 03        // and     ecx, 3
        F3 A4           // rep movsb
        5F              // pop     edi
        5E              // pop     esi
        83 C4 08        // add     esp, 8
        C3              // retn
        */
        $op_loader_02 = {
        f2 ae f7 d1 2b f9 8b c1  8b f7 8b fa c1 e9 02 f3
        a5 8b c8 83 e1 03 f3 a4  5f 5e 83 c4 08 c3
        }
    condition:
        2 of them
}

