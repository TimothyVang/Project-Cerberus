        version = "202504182146"
        last_modified = "2025-04-18"
        malware_family = "BlindPMX"
    strings:
        // \\Device\\Pmxdrv vulnerable driver path
        $driver_path = { 5c 00 44 00 65 00 76 00 69 00 63 00 65 00 5c 00 50 00 6d 00 78 00 64 00 72 00 76 00 }
        // pmxdrv.sys vulnerable driver name
        $driver_name = { 70 00 6d 00 78 00 64 00 72 00 76 00 2e 00 73 00 79 00 73 }
        // BA BC 2A 22 00  mov     edx, 222ABCh    ; dwIoControlCode
        // IOCTL code for vulnerable driver memory mapping
        $ioctl1 = { bc 2a 22 00 }
        // BA B8 2A 22 00  mov     edx, 222AB8h    ; dwIoControlCode
        // IOCTL code for vulnerable driver memory writing
        $ioctl2 = { b8 2a 22 00 }
        $success_remove = "[Success] Remove Done"
        $success_blind = "[Success] Only Blind Done!"
    condition:
        ($driver_path and $driver_name and $ioctl1 and $ioctl2) and ($success_remove or $success_blind)
}

