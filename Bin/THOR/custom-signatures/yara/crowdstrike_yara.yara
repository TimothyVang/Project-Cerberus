rule CrowdStrike_CSIT_19135_01 : ransomware revil sodinokibi unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "This rule detects unpacked Sodinokibi ransomware samples."
        reports = "CSIT-19135"
        version = "202407101224"
        last_modified = "2024-07-10"
        malware_family = "REvil"
    strings:
        $expand = "expand 32-byte kexpand 16-byte k" ascii
        $mutex = "\\BaseNamedObjects\\%S" wide fullword
        //  lea     eax, [esi-41h]
        //  lea     ebx, [ebx+2]
        //  cmp     ax, 19h
        //  ja      offset 3
        //  or      esi, 20h
        //  imul    edx, 10Fh
        //  movzx   eax, si
        //  movzx   esi, word ptr [ebx]
        //  add     edx, eax
        //  test    si, si
        //  jnz
        $op_api_hashing = {
        8d46bf 8d5b02 6683f819 7703 83ce20 69d20f010000 0fb7c6
        0fb733 03d0 6685f6 75
        }
        //  mov     edx, [eax+0Ch]
        //  add     edx, 14h
        //  mov     [ebp+??], edx
        //  mov     ecx, [edx]
        //  cmp     ecx, edx
        //  jz      short LIST_EMPTY
        //  mov     edi, [ebp+Needle]
        $op_search_dll = {
        8B500C 83C214 8955?? 8B0A 3BCA 74(4?|5?) 8B7D08
        }
        //  xor     edx, edx
        //  mov     bl, [ebp+edi+rc4table]
        //  mov     eax, edi
        //  movzx   ecx, bl
        //  div     [ebp+KeySize]
        //  mov     eax, [ebp+Key]
        //  movzx   eax, byte ptr [edx+eax]
        //  add     eax, esi
        //  add     ecx, eax
        //  movzx   esi, cl
        //  mov     al, [ebp+esi+rc4table]
        //  mov     [ebp+edi+rc4table], al
        //  inc     edi
        //  mov     [ebp+esi+rc4table], bl
        //  cmp     edi, 100h
        $op_rc4_01 = {
        33D2 8A9C3D ??F?FFFF 8BC7 0FB6CB F775?? 8B45?? 0FB60402
        03C6 03C8 0FB6F1 8A8435 ??F?FFFF 88843D ??F?FFFF 47 889C35
        ??F?FFFF 81FF00010000
        }
        //  inc     eax
        //  movzx   ecx, al
        //  mov     [ebp+Index], ecx
        //  mov     dl, [ebp+ecx+rc4table]
        //  movzx   eax, dl
        //  add     eax, esi
        //  movzx   esi, al
        //  mov     al, [ebp+esi+rc4table]
        //  mov     [ebp+ecx+rc4table], al
        //  mov     [ebp+esi+rc4table], dl
        //  movzx   ecx, [ebp+ecx+rc4table]
        //  movzx   eax, dl
        //  add     ecx, eax
        //  mov     eax, [ebp+InputSize]
        //  movzx   ecx, cl
        //  mov     cl, [ebp+ecx+rc4table]
        //  xor     cl, [edi+eax]
        //  mov     [eax], cl
        //  inc     eax
        //  mov     [ebp+InputSize], eax
        //  mov     eax, [ebp+Index]
        //  sub     ebx, 1
        $op_rc4_02 = {
        40 0FB6C8 894D?? 8A940D ??F?FFFF 0FB6C2 03C6 0FB6F0 8A8435
        ??F?FFFF 88840D ??F?FFFF 889435 ??F?FFFF 0FB68C0D ??F?FFFF 0FB6C2
        03C8 8B45?? 0FB6C9 8A8C0D ??F?FFFF 320C07 8808 40 8945??
        8B45FC 83EB01
        }
        $salsa20_seq = {
        BE ?? ?? ?? ?? 8B 01 89 42 ?? 8B 41 ?? 89 42 ?? 8B 41 ?? 89 42 ?? 8B 41 ?? 89 42 ?? 8B 06 89 02 8B 46 ?? 89 42 ?? 8B 46 ?? 89 42 ?? 8B 46 ?? 89 35 ?? ?? ?? ?? 89 42 ?? 5E 5D C3
        }
        $json_seq = {
        8b 75 f0 8b 55 f8 8b 5d b8 83 ca 20 33 ff 89 55 f8 8b 4e 0c 89 75 f4 89 4d ec 89 7d 10 e9 5e 03 00 00
        }
    condition:
        (($expand or $mutex) and 2 of ($op*)) or (3 of ($op*)) or ($salsa20_seq and $json_seq)
}

