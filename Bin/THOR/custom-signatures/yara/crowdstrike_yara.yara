        $log3 = "[<] %s prepared"
        $pdb = "C:\\Users\\user\\source\\evil-mhyprot-cli\\x64\\Release\\evil-mhyprot-cli64.pdb"
        /*
        .text:0000000140960988 48 C1 E8 1D                       shr     rax, 1Dh
        .text:000000014096098C 49 23 C0                          and     rax, r8
        .text:000000014096098F 48 33 D0                          xor     rdx, rax
        .text:0000000140960992 48 33 D1                          xor     rdx, rcx
        .text:0000000140960995 48 8B C2                          mov     rax, rdx
        .text:0000000140960998 48 8B CA                          mov     rcx, rdx
        .text:000000014096099B 25 40 BF FF 07                    and     eax, 7FFBF40h
        .text:00000001409609A0 48 C1 E9 25                       shr     rcx, 25h
        .text:00000001409609A4 48 33 C1                          xor     rax, rcx
        .text:00000001409609A7 48 8B CA                          mov     rcx, rdx
        .text:00000001409609AA 48 C1 E8 06                       shr     rax, 6
        */
        $generate_key_asm = {48 c1 e8 1d 49 23 c0 48 33 d0 48 33 d1 48 8b c2 48 8b ca 25 40 bf ff 07 48 c1 e9 25 48 33 c1 48 8b ca 48 c1 e8 06}
    condition:
        $pdb or (uint16(0) == 0x5a4d and 2 of ($log*) and $generate_key_asm)
}

