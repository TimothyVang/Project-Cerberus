        $log_03 = "\x0d\x0aFailed to execute-assembly, error %08X\x0d\x0a\x0d\x0a"
        $log_04 = "\x0d\x0aFailed to execute-pe, error %08X\x0d\x0a\x0d\x0a"
        $log_05 = "Go to sleep mode for %u minutes.\x0d\x0a"
        $log_06 = "\x0d\x0aFailed to inject, error %08X\x0d\x0a\x0d\x0a"
        $log_07 = "\x0d\x0aFailed to load PS module, error %08X\x0d\x0a\x0d\x0a"
