        $avdlls_2 = "4z3b4OmshdqL1F3p2/NlsybE/7" wide ascii
        $avdlls_3 = "kf/cSE/TqTWrUQr/ApVHz282+W" wide ascii
        $avdlls_4 = "AAAAzU/5+voUe7NUbLzw7Omk01" wide ascii
        // Base64 encoded, reverse byte order chunks concatenated and decrypted to form AMSI bypass bytes
        $amsi_1 = "AACL+BAAAAC" wide ascii
        $amsi_2 = "Vc7CABAAAAA" wide ascii
        $amsi_3 = "AAc+3zoqx6t" wide ascii
        $amsi_4 = "AAAAIkoXFZK" wide ascii
