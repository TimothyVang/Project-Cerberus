rule CrowdStrike_cve_2023_21608_exploit : exploit pdf 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Patterns found on cve-2023-21608 exploit"
        version = "202303131435"
        last_modified = "2023-03-13"
    strings:
        /* the following pdf object appears mandatory, we avoid any detection on javascript as this can be minified or obfuscated
        obj
        <<
        /Type /Annot
        /Subtype /Widget
        /T (testField)
        /FT /Tx
        /Rect [0 0 0 0]
        >>
        */
        $exploit_obj = { 6f 62 6a 0d 0a 3c 3c 0d 0a 2f 54 79 70 65 20 2f 41 6e 6e 6f 74 0d 0a 2f 53 75 62 74 79 70 65 20 2f 57 69 64 67 65 74 0d 0a 2f 54 20 28 74 65 73 74 66 69 65 6c 64 29 0d 0a 2f 46 54 20 2f 54 78 0d 0a 2f 52 65 63 74 20 5b 30 20 30 20 30 20 30 5d 0d 0a 3e 3e }
        /* add the javascript object
        obj
        <<
        /Type /Action
        /S /JavaScript
        */
        $javascript = { 6f 62 6a 0d 0a 3c 3c 0d 0a 2f 54 79 70 65 20 2f 41 63 74 69 6f 6e 0d 0a 2f 53 20 2f 4a 61 76 61 53 63 72 69 70 74 }
        /*%PDF magic*/
        $magic = { 25 50 44 46 }
    condition:
        $magic at 0 and all of them
}

