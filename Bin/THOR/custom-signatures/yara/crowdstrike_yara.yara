rule CrowdStrike_CSIT_24209_01 : apolog ecrime lightning_spider loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique APIs used for asynchronous operations and other Apolog functionality combined with constant values consistently found in Apolog builds"
        reports = "CSA-241114,CSA-241236,CSA-250163,CSIT-24209"
        version = "202503041611"
        last_modified = "2025-03-04"
        actor = "LIGHTNING SPIDER"
        malware_family = "Apolog"
    strings:
        // Windows memory allocation APIs
        $alloc_mem_0 = "VirtualAlloc" ascii
        $alloc_mem_1 = "GetProcessHeap" ascii
        $alloc_mem_2 = "HeapAlloc" ascii
        // Windows API function names for verifying the victim operating system version against pre-set version numbers
        $version_api_0 = "VerSetConditionMask" ascii
        $version_api_1 = "VerifyVersionInfoW" ascii
        // Windows API function names for creating a custom registry key
        $reg_api_0 = "RegSetValueExW" ascii
        $reg_api_1 = "RegCreateKeyExW" ascii
        $reg_api_2 = "RegCloseKey" ascii
        // Hardcoded software root path used in registry operations
        $root_reg = "SOFTWARE\\" wide
        // Hardcoded debug messages
        $msg_0 = "Operation completed successfully." ascii
        $msg_1 = "Operation failed." ascii
        // Text file name
        $txt_filename = "result_matrix.txt" ascii
        // String artifacts left from the use of the ADVobfuscator framework
        $adv_obf_0 = "ADVobfuscator@andrivet@@" ascii
        $adv_obf_1 = "$ObfuscatedAddress@" ascii
        // Murmurhash3 constants
        $murmurhash3_const_0 = { 6b ca eb 85 }
        $murmurhash3_const_1 = { 35 ae b2 c2 }
        $murmurhash3_const_2 = { 93 35 87 1b }
        $murmurhash3_const_3 = { 51 2d 9e cc }
        // RC4 Sbox initialization
        $rc4_init = { (49 8b|41 8b|33) c? [0-16] 88 04 0? 48 ff c? 48 (3d|81 fb|81 fe|81 ff) 00 01 00 00 72 }
        // Setup for retrieval of pointers that are randomly offset in memory allocations
        $ptr_recovery = { 48 8b (05|0d) [0-20] e8 [4] 48 (89 98|8b 05|8b 0d) }
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and uint8(uint32(0x3c)+4) == 0x64 and uint16(uint32(0x3c)+22) == 0x2022 and
        all of ($adv_obf_*)
        and 3 of ($murmurhash3_const_*)
        and (5 of ($version_api_*,$reg_api_*,$root_reg,$msg_*,$txt_filename,$ptr_recovery)) or (3 of ($alloc_mem_*) and $rc4_init)
        and filesize < 5MB
}

