rule CrowdStrike_CSA_240225_01 : ecrime loader powershell 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings in a PowerShell script embedded in MSI installers delivering Apolog loader"
        reports = "CSA-240225"
        version = "202402231121"
        last_modified = "2024-02-23"
    strings:
        /*
        Function names and test values used by the PowerShell install
        framework to interact with the MSI installer
        */
        $ps_cmdlet_0 = "AI_GetMsiProperty" ascii
        $ps_cmdlet_1 = "AI_SetMsiProperty" ascii
        $test_value_0 = "$testPrefix$name$msiPropKVSeparator$testValue$msiPropLineSeparator" ascii
        $test_value_1 = "$name$msiPropKVSeparator$value$msiPropLineSeparator" ascii
        $debug_0 = "POTENTIAL_BUG: MSI property $name set to an uninitialized/null variable. Initialize empty variables using empty quotes." ascii
        $comm_0 = "# Simple quotes are problematic, especially when more in a succession" ascii
        $comm_1 = "# e.g. in a username. We need to enclose each bundle of them in a simple quoted string" ascii
        $comm_2 = "# with each contained simple quote being escaped by doubling. N initial quotes => (N+1)*2 final quotes" ascii
        /*
        Strings used by implementations observed delivering Apolog
        loader using an MSI installer
        */
        $license_uri = "LicenseInfo" ascii
        $resp_key = "$responseString.result" ascii
        $msi_property_0 = "LostTime" ascii
        $msi_property_1 = "license_expired" ascii
    condition:
        2 of ($license_uri,$resp_key,$msi_property_*) and
        6 of ($ps_cmdlet_*, $test_value_*, $debug_0, $comm_*)
}

