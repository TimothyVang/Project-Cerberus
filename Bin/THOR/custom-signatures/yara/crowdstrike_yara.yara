        pe.resources[i].type == pe.RESOURCE_TYPE_BITMAP
        and math.entropy(pe.resources[i].offset, pe.resources[i].offset+pe.resources[i].length) > 6.8
        )
        and 2 of ($hash_*)
        and 1 of ($res*)
        and ($keys_x86 or $h_x86)
}

