rule CrowdStrike_CSIT_23047_01 : downloader ecrime ishmael prophet_spider proxy unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Code sequences used to produce custom header and evaluate networking errors"
        reports = "CSA-231266,CSA-231617,CSA-250719,CSIT-23047"
        version = "202506240402"
        last_modified = "2025-06-24"
        actor = "PROPHET SPIDER"
        malware_family = "Ishmael"
    strings:
        /* Construct the components of the custom packet
        header structure
        */
        $build_packet_header = {
        8b 85 [4-6] 89 85 [4-6] 8b 85  [4-6] 89 85 [4-6] c7 85 [4] 08
        00 00 00 8b 05 [4-6] 48 98
        }
        /* Short loop to generate two pseudorandom
        DWORDs using the rand() function
        */
        $pseudorandom_dword = {
        e8 [4-6] 89 85 [4-6] 8b 85 [4-6]  48 98 48 8d 95 [4-6] 48 01
        c2 0f b7 85 [7-12] 83 85 [2]  00 00 01 83 85 [2] 00 00
        02 83 bd [2] 00 00 01 7e
        }
        /* Reset variable values in the main response
        processing loop based on hard-coded criteria
        */
        $reset_thread_vars = {
        90 c6 85 [2-4] 00 00 05 c6  85 [2-4] 00 00 ff c7 85 [2-4]
        00 00 ff 00 00 00
        }
        /* Four distinct switch cases handling specific
        error codes returned by WSAGetLastError after
        socket operations
        */
        $socket_error_var_0 = {
        81 (7d|bd) [1-4] 43 27 00 00 75  ?? c6 45 ?? 03
        }
        $socket_error_var_1 = {
        81 (7d|bd) [1-4] 42 27 00 00 75  ?? c6 45 ?? 03
        }
        $socket_error_var_2 = {
        81 (7d|bd) [1-4] 4c 27 00 00 75  ?? c6 45 ?? 04
        }
        $socket_error_var_3 = {
        81 (7d|bd) [1-4] 4d 27 00 00 75  ?? c6 45 ?? 05
        }
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550
        and (any of ($build_packet_header,$pseudorandom_dword,$reset_thread_vars) and any of ($socket_error_var_*))
}

