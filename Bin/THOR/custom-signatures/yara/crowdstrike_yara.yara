        .text:00000001400053F2 BB E8 03 00 00       mov     ebx, 3E8h
        .text:00000001400053F7 8B FB                mov     edi, ebx
        */
        $delay_prologue = { 57 48 83 ec 20 bb e8 03 00 00 8b fb }
        /*
        .text:0000000140005548 80 34 18 32          xor     byte ptr [rax+rbx], 32h
        .text:000000014000554C 48 FF C3             inc     rbx
        .text:000000014000554F 48 81 FB 00 10 00 00 cmp     rbx, 1000h
        .text:0000000140005556 7C EB                jl      short loc_140005543
        */
        $config_xor = { 80 34 18 ?? 48 ff c3 48 81 fb 00 10 00 00 7c eb }
        $status_0 = "[*] Exception in inline-execute"
