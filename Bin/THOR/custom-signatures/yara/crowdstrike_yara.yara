        $BTC_PRECHECK_2 = { 8b [2-5] 33 c9 66 8b 08 83 f9 31 74 11 8b [2-5] 33 c0 66 8b 02 83 f8 33 }
        $BTC_PRECHECK_3 = { 8b [2-5] 33 c0 66 8b 02 83 f8 31 74 11 8b [2-5] 33 d2 66 8b 11 83 fa 33 }
        $strstr = { 8b 55 fc 83 c2 02 89 55 fc 8b 45 f8 83 c0 02 89 45 f8 8b 4d fc 33 d2 66 8b 11 85 d2 74 24 8b 45 f8 33 c9 66 8b 08 85 c9 74 18 8b 55 fc 33 c0 66 8b 02 8b 4d f8 33 d2 66 8b 11 3b c2 74 02 eb 02 }
    condition:
        1 of ($ETH_PRECHECK_*) and 1 of ($ETH_CHAR_CHECK_*) and 1 of ($BTC_PRECHECK_*) and $strstr
}

