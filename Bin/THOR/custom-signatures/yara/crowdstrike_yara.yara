rule CrowdStrike_CSIT_21152_01 : backdoor just_for_fun 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Distinctive byte sequences and strings found in JustForFun samples"
        reports = "CSIT-21152"
        version = "202209230834"
        last_modified = "2022-09-23"
        malware_family = "JustForFun"
    strings:
        $ptmx = "/dev/ptmx"
        $env_ps1 = "PS1=[\\u@\\h \\W]\\\\$ "
        // mov   [rbp+var_8940], 50h ; 'P'
        // mov     [rbp+var_8940+1], 53h ; 'S'
        // mov     [rbp+var_8940+2], 31h ; '1'
        // mov     [rbp+var_8940+3], 3Dh ; '='
        // mov     [rbp+var_8940+4], 5Bh ; '['
        // mov     [rbp+var_8940+5], 5Ch ; '\'
        // mov     [rbp+var_8940+6], 75h ; 'u'
        // mov     [rbp+var_8940+7], 40h ; '@'
        // mov     [rbp+var_8940+8], 5Ch ; '\'
        // mov     [rbp+var_8940+9], 68h ; 'h'
        // mov     [rbp+var_8940+0Ah], 20h ; ' '
        // mov     [rbp+var_8940+0Bh], 5Ch ; '\'
        // mov     [rbp+var_8940+0Ch], 57h ; 'W'
        // mov     [rbp+var_8940+0Dh], 5Dh ; ']'
        // mov     [rbp+var_8940+0Eh], 5Ch ; '\'
        // mov     [rbp+var_8940+0Fh], 5Ch ; '\'
        // mov     [rbp+var_8940+10h], 24h ; '$'
        // mov     [rbp+var_8940+11h], 20h ; ' '
        // mov     [rbp+var_8940+12h], 0
        $env_ps1_2 = {
        c6 85 [4] 50
        c6 85 [4] 53
        c6 85 [4] 31
        c6 85 [4] 3d
        c6 85 [4] 5b
        c6 85 [4] 5c
        c6 85 [4] 75
        c6 85 [4] 40
        c6 85 [4] 5c
        c6 85 [4] 68
        c6 85 [4] 20
        c6 85 [4] 5c
        c6 85 [4] 57
        c6 85 [4] 5d
        c6 85 [4] 5c
        c6 85 [4] 5c
        c6 85 [4] 24
        c6 85 [4] 20
        c6 85 [4] 00
        }
        // X:\x003458\x008543
        $vals = { 58 3a 00 33 34 35 38 00 38 35 34 33 00 }
        $name1 = "kdevtmpfls"
        $name2 = "kdumpcab"
        $godpid = "godpid"
        $vhangup = "vhangup"
        $timeval = { 48 c7 45 e0 3c 08 0a 49 48 c7 45 e8 00 00 00 00 48 c7 45 f0 3c 08 0a 49 }
        $fw1 = "/sbin/iptables -t nat -D PREROUTING -p tcp -s %s --dport %d -j REDIRECT --to-ports %d"
        $fw2 = "/sbin/iptables -t nat -A PREROUTING -p tcp -s %s --dport %d -j REDIRECT --to-ports %d"
        $bpf_tcp_magic = { 48 00 00 00 0e 00 00 00 15 00 00 01 93 52 00 00 }
        $bpf_icmp_udp_magic = { 48 00 00 00 16 00 00 00 15 00 00 0e 55 72 00 00 }
    condition:
        (
        ($ptmx and 1 of ($env_ps1*))
        or $vals
        or (1 of ($name*))
        or ($godpid and $vhangup)
        or $timeval
        or all of ($fw*)
        or all of ($bpf*)
        ) and filesize < 100KB
}

