    strings:
        /*
        4d 8d 40 01          lea     r8, [r8+1]
        41 0f b6 04 56       movzx   eax, byte ptr [r14+rdx*2]
        41 32 40 ff          xor     al, [r8-1]
        f6 d0                not     al
