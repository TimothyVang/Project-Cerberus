rule CrowdStrike_CSIT_24091_01 : aspx exchange owa venomous_bear webshell 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "XOwaAction header containing Base64-encoded JScript to execute"
        reports = "CSIT-24091"
        version = "202404190559"
        last_modified = "2024-04-19"
        actor = "VENOMOUS BEAR"
    strings:
        $jscript_1 = "\x00engine\x00JScriptImport\x00JScriptPackage\x00" ascii
        $jscript_2 = {
        65 00 6e 00 67 00 69 00 6e 00 65 00 00 31 4d 00
        69 00 63 00 72 00 6f 00 73 00 6f 00 66 00 74 00
        2e 00 4a 00 53 00 63 00 72 00 69 00 70 00 74 00
        2e 00 49 00 6d 00 70 00 6f 00 72 00 74 00 00 1b
        4a 00 53 00 63 00 72 00 69 00 70 00 74 00 49 00
        6d 00 70 00 6f 00 72 00 74 00
        }
