        $dn2 = "#Strings"
        $c2_msg_1 = "PNC" wide fullword
        $c2_msg_2 = "IE" wide fullword
        $c2_msg_3 = "GPL" wide fullword
        $c2_msg_4 = "LP" wide fullword
        $c2_msg_5 = "UNV" wide fullword
        $str_ping_msgt = "keepAlivePing!" wide
        $str_name = "Revenge-RAT" wide
        $str_splitter1 = "!@#%^NYAN#!@$" wide
        $str_splitter2 = "*-]NK[-*" wide
        $str_mutex_prefix = "RV_MUTEX-" wide
        $method_1 = "TcpReceive"
        $method_2 = "PacketFixer"
        $method_3 = "SendInfo"
        $method_4 = "GetIp"
        $method_5 = "GetHardDiskSerialNumber"
        $method_6 = "GetSystem"
        $method_7 = "GetCamera"
        $method_8 = "GetAV"
        $method_9 = "GetCpu"
    condition:
        all of ($dn*)
        and (7 of them or (
        3 of ($c2*)
