        $log_01 = "%s %s out."
        $log_02 = "%s %s thread stopped. (%d thread(s) stopped.)"
        $log_03 = "%s <%i> out."
        $log_04 = "%s Bad URL or DNS Error, error: <%d>"
        $log_05 = "%s Couldn't open file for writing: %s."
        $log_06 = "%s Couldn't parse path, error: <%d>"
        $log_07 = "%s Created process: \"%s\", PID: <%d>"
        $log_08 = "%s Downloading URL: %s to: %s."
        $log_09 = "%s Downloading update from: %s to: %s."
        $log_10 = "%s Fail start %s, err: <%d>."
        $log_11 = "%s Failed to create process: \"%s\", error: <%d>"
        $log_12 = "%s Failed to parse command."
        $log_13 = "%s File download: %.1fKB to: %s @ %.1fKB/sec."
        $log_14 = "%s Invalid slot: <%i>"
        $log_15 = "%s Kill: <%d> threads"
        $log_16 = "%s Killed thread: <%s>"
        $log_17 = "%s No %s thread found."
        $log_18 = "%s No threads"
        $log_19 = "%s No user at: <%i>"
        $log_20 = "%s Process Finished: \"%s\", Total Running Time: %s."
        $log_21 = "%s Update failed: Error executing file: %s."
        $log_22 = "%s logged in."
        $log_23 = "%s main thread"
        $log_24 = "%s mis param."
        $msc_00 = "Removed by: %s!%s@%s"
        $msc_01 = "Ping Timeout? (%d-%d)%d/%d"
        $msc_02 = "New Infection!"
        $msc_03 = "Infected drive"
        $msc_04 = "Go fuck yourself %s."
        $msc_05 = "Fuck off"
        $msc_06 = "Fail Nigga?"
        $msc_07 = "Auth Granted!"
        $msc_09 = "%seraseme_%d%d%d%d%d.exe"
        $msc_10 = "%s\\removeMe%i%i%i%i.bat"
        $msc_11 = "%s!%s@%s"
        $irc_01 = "USER %s * 0 :%s"
        $irc_02 = "PRIVMSG %s :%s"
        $irc_03 = "PRIVMSG %s :%s"
        $irc_04 = "NOTICE %s :%s"
        $irc_05 = "MODE %s %s %s"
        $irc_06 = "MODE %s %s"
        $irc_07 = "JOIN %s %s"
    condition:
        2 of ($irc*) and
        10 of them
}

