        description = "Strings and code patterns found on N3ww4v3 ransomware"
        reports = "CSIT-23043"
        version = "202302101026"
        last_modified = "2023-02-10"
        malware_family = "N3ww4v3"
    strings:
        $everything_import_0 = "Everything_QueryW"
        $everything_import_1 = "Everything_SetSearchW"
        $everything_import_2 = "Everything_GetResultFullPathNameW"
        $powercfg_0 = "powercfg.exe" wide
        $powercfg_1 = "-SETACVALUEINDEX" wide
        $powercfg_2 = "-SETDCVALUEINDEX" wide
        $powercfg_3 = "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c" wide
        $powercfg_4 = "e9a42b02-d5df-448d-aa00-03f14749eb61" wide
        $deletion_string_0 = "bcdedit.exe /set {default} bootstatuspolicy ignoreallfailures" wide
        $deletion_string_1 = "bcdedit.exe /set {default} recoveryenabled no" wide
        $deletion_string_2 = "wbadmin.exe DELETE SYSTEMSTATEBACKUP" wide
        $deletion_string_3 = "wbadmin.exe delete catalog -quiet" wide
        $acl_string_0 = "O:BAG:BAD:PAR(A;;GA;;;WD)(A;;GA;;;BA)(A;;GA;;;SY)" wide
        $acl_string_1 = "O:BAG:$D:AI(D;;FR;;;WD)(D;;FR;;;AN)(D;;FR;;;SY)(D;;FR;;;BA)(D;;FR;;;BU)(A;OICIID;FA;;;SY)(A;OICIID;FA;;;BA)(A;OICIID;FA;;;$)" wide
        /*
        6A 00              push    0               ; pSacl
        5?                 push    esi             ; pDacl
        6A 00              push    0               ; psidGroup
        6A 00              push    0               ; psidOwner
        6A 04              push    4               ; SecurityInfo
        6A 06              push    6               ; ObjectType
        5?                 push    edi             ; handle
        FF 15 ?? ?? ?? ??  call    <SetSecurityInfo>
        */
        $SetSecurityInfo_call_pushes = { 6a 00 6a 00 6a 04 6a 06 }
    condition:
        all of them
}

