        $ETH_CHAR_CHECK_1 = { 8b [2-5] 33 d2 66 8b 11 83 fa 61 7c 10 8b [2-5] 33 c9 66 8b 08 83 f9 66 7e 40 8b [2-5] 33 c0 66 8b 02 83 f8 41 7c 10 8b [2-5] 33 d2 66 8b 11 83 fa 46 7e 20 8b [2-5] 33 c9 66 8b 08 83 f9 30 7c 30 8b [2-5] 33 c0 66 8b 02 83 f8 39 }
