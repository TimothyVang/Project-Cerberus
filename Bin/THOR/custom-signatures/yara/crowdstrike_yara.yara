rule CrowdStrike_BrushFire_01 : backdoor brushfire 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic opcode sequences of the BrushFire backdoor"
        version = "202506051355"
        last_modified = "2025-06-05"
        malware_family = "BrushFire"
    strings:
        $push_regs = "UWVS"
        $xor_shellcode = {
        30 0c 02            // xor     [edx+eax], cl
        83 c0 01            // add     eax, 1
        83 f8 ??            // cmp     eax, ?
        75 f5               // jnz     short loop
        }
        $invoke_shellcode = {
        b8 7d 00 00 00      // mov     eax, 7Dh     ; sys_mprotect
        89 fb               // mov     ebx, edi     ; addy
        b9 ?? ?? ?? ??      // mov     ecx, 5000h   ; len
        ba 07 00 00 00      // mov     edx, 7       ; flags
        cd 80               // int     80h
        [8-32]              // ...
        ff d6               // call    esi
        [0-8]               // ...
        89 c5               // mov     ebp, eax
        b8 7d 00 00 00      // mov     eax, 7Dh     ; sys_mprotect
        89 fb               // mov     ebx, edi     ; addy
        b9 ?? ?? ?? ??      // mov     ecx, 5000h   ; len
        ba 03 00 00 00      // mov     edx, 3       ; flags
        cd 80               // int     80h
        }
    condition:
        all of them
        and @push_regs == 0
        and filesize < 1KB
}

