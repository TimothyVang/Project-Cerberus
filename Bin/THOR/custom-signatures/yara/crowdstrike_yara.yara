        $initial_sleep_32_bit = { FF 15 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 2B C7 5F 83 F8 32 72 }
        /*
        FF 15 ?? ?? ?? ??  call    Sleep
        FF 15 ?? ?? ?? ??  call    GetTickCount
        2B C3              sub     eax, ebx
        83 F8 32           cmp     eax, 0x32
        0F 82 ?? ?? ?? ??  jb      exit_location
        */
        $initial_sleep_64_bit = { FF 15 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 2B C3 83 F8 32 0F 82 }
        /*
        C7 45 ?? 06 00 00 00  mov     [ebp+var_encoded_config_offset], 6
        F7 75 ??              div     [ebp+var_encoded_config_offset]
