        $win_const_1 = { f3 dd 60 46 }   // WSAID_CONNECTEX
        $win_const_2 = { 8e e9 76 e5 }   // WSAID_CONNECTEX
        $win_const_3 = { 8c 74 06 3e }   // WSAID_CONNECTEX
        $win_const_4 = { 06 00 00 c8 }   // SIO_GET_EXTENSION_FUNCTION_POINTER
        $win_const_5 = { 68 bd 01 00 00 } // push 445
        $pub_key_0 = "-----BEGIN PUBLIC KEY-----" ascii wide
        $pub_key_1 = "-----BEGIN RSA PUBLIC KEY-----" ascii wide
        $pub_key_2 = "-----BEGIN RSA PRIVATE KEY-----" ascii wide
