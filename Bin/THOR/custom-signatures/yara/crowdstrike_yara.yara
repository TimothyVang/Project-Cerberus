rule CrowdStrike_CSIT_25137_01 : attor dispatcher enchanted_illumination 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Matches both the x86_32 and x86_64 version of ATTOR dispatcher module."
        reports = "CSIT-25137"
        version = "202506061514"
        last_modified = "2025-06-06"
        malware_family = "Attor"
        activity_cluster = "EnchantedIllumination"
    strings:
        $system_time_format_string = "%02u-%02u-%04u %02u:%02u:%02u" wide
        $blowfish_sbox = { ac b5 df 98 db 72 fd 2f }
        $blowfish_pbox = { 88 6a 3f 24 d3 08 a3 85 }
        /*
        66 0F EF C9              pxor    xmm1, xmm1
        66 0F EF C0              pxor    xmm0, xmm0
        F2 48 0F 2A 4C 24 ??     cvtsi2sd xmm1, qword ptr [rsp+<var_FreeBytesAvailableToCaller>]
        F2 48 0F 2A 44 24 ??     cvtsi2sd xmm0, qword ptr [rsp+<var_TotalNumberOfBytes>]
        F2 0F 5E C8              divsd   xmm1, xmm0
        F2 0F 59 0D ?? ?? ?? ??  mulsd   xmm1, cs:<var_MultiplierConstant>
        66 0F 2F 0D ?? ?? ?? ??  comisd  xmm1, cs:<var_ThresholdConstant>
        */
        $code_disk_space_calculation_x86_64 = { 66 0f ef c9 66 0f ef c0 f2 48 0f 2a 4c 24 ?? f2 48 0f 2a 44 24 ?? f2 0f 5e c8 f2 0f 59 0d ?? ?? ?? ?? 66 0f 2f 0d }
        /*
        DF 6D ??           fild    qword ptr [ebp+<var_FreeBytesAvailableToCaller>]
        DF 6D ??           fild    qword ptr [ebp+<var_TotalNumberOfBytes>]
        DE F9              fdivp   st(1), st
        DC 0D ?? ?? ?? ??  fmul    ds:<var_MultiplierConstant>
        DC 1D ?? ?? ?? ??  fcomp   ds:<var_ThresholdConstant>
        */
        $code_disk_space_calculation_x86_32 = { df 6d ?? df 6d ?? de f9 dc 0d ?? ?? ?? ?? dc 1d ?? ?? ?? ?? }
        // 7.0, as an IEEE754 double (0x401C000000000000)
        // 100.0, as an IEEE754 double (0x4059000000000000)
        $constant_calc = {
        00 00 00 00 00 00 ( 1c 40 | 59 40 )
        }
    condition:
        ( uint16(0) == 0x5a4d or uint16(0) == 0xc104) and
        $system_time_format_string and
        all of ($system_time_format_string, $blowfish_*)
        and any of ($code_disk_space_calculation_*) and
        #constant_calc > 0
}

