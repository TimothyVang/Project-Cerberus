rule CrowdStrike_CSIT_22248_01 : apolog ecrime lightning_spider loader shellcode 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "MurmurHash2 and CRC32 function hashes, XTEA decryption algorithm constants, and unique code sequences"
        reports = "CSA-230183,CSA-230571,CSA-240225,CSA-250784,CSIT-22248,CSIT-25099"
        version = "202507032226"
        last_modified = "2025-07-03"
        actor = "LIGHTNING SPIDER"
        malware_family = "Apolog"
    strings:
        /* Windows API function name hashes using MurmurHash2 with a
        seed value of 0x2334
        */
        $murmur2_api_hash_virtualalloc = { 7d 9d 4f b6 }
        $murmur2_api_hash_virtualfree = { 22 69 37 54 }
        $murmur2_api_hash_getmodulefilenamea = { 45 41 5a cb }
        $murmur2_api_hash_getcommandlinea = { de f5 5e 7b }
        $murmur2_api_hash_createprocessa = { 6a 5a 9b f2 }
        $murmur2_api_hash_virtualallocex = { a8 41 f8 24 }
        $murmur2_api_hash_getthreadcontext = { bc 9f 6a 0e }
        $murmur2_api_hash_readprocessmemory = { 99 e7 ff 72 }
        $murmur2_api_hash_writeprocessmemory = { c6 f4 98 62 }
        $murmur2_api_hash_setthreadcontext = { ea 03 16 81 }
        $murmur2_api_hash_ntresumethread = { a2 36 0f 4b }
        $murmur2_api_hash_ntqueryinformationprocess = { 9a 4e e3 76 }
        $murmur2_api_hash_ntunmapviewofsection = { a5 2a de 65 }
        /* Windows API function name hashes using the CRC32 hashing
        algorithm
        */
        $crc32_api_hash_virtualalloc = { 4a 0d ce 09 }
        $crc32_api_hash_virtualfree = { dd f5 53 cd }
        $crc32_api_hash_getmodulefilenamea = { a0 f7 bf 08 }
        $crc32_api_hash_getcommandlinea = { c5 b1 66 2d }
        $crc32_api_hash_createprocessinternala = { 33 13 e2 81 }
        $crc32_api_hash_virtualallocex = { 4d 82 2e e6 }
        $crc32_api_hash_getthreadcontext = { c1 b9 9e 64 }
        $crc32_api_hash_readprocessmemory = { 42 ae c7 f7 }
        $crc32_api_hash_writeprocessmemory = { 2e 97 58 4f }
        $crc32_api_hash_setthreadcontext = { d8 cb 88 56 }
        $crc32_api_hash_ntresumethread = { 72 b5 73 62 }
        $crc32_api_hash_ntqueryinformationprocess = { 50 4c c4 a5 }
        $crc32_api_hash_ntunmapviewofsection = { f6 3f 48 90 }
        /* Setup of constants used by the XTEA
        decryption algorithm to calculate
        arithmetic magic values
        */
        $xtea_constants = { c7 (45 ??|44 ?? ??) 20 00 00 00 c7  (45 ??|44 ?? ??) b9 79 37 9e }
        /* Execution of cpuid assembly instruction
        with basic information flag used in check
        for hypervisor on system
        */
        $hypervisor_check = { b8 01 00 00 00  [0-4] 0f a2 }
    condition:
        (9 of ($murmur2_api_hash_*) or 9 of ($crc32_api_hash_*)) and
        1 of ($xtea_constants,$hypervisor_check)
}

