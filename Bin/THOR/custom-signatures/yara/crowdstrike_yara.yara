rule CrowdStrike_CSA_241357_01 : android lib_ducex packer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Common strings and encryption string algorithm"
        reports = "CSA-241357"
        version = "202501151458"
        last_modified = "2025-01-15"
        malware_family = "LibDucex"
    strings:
        $dex   = { 64 65 (78 | 79) 0a 30 ?? ?? 00 }
        $ducex = "ducex" fullword
        $algorithm = {
        1a 00 0? 00             // const-string        v0, "82f7500966f9f677"
        12 01                   // const/4             v1, 0
        71 ?? ?? ?? ?? ??       // invoke-static       Base64->decode(String, I)[B, p0, v1
        0c 05                   // move-result-object  p0
        6e 10 ?? 00 00 00       // invoke-virtual      String->getBytes()[B, v0
        0c 00                   // move-result-object  v0
        21 02                   // array-length        v2, v0
        21 53                   // array-length        v3, p0
        35 31 ?? 00             // if-ge               v1, v3, :38
        94 03 01 02             // rem-int             v3, v1, v2
        48 04 05 01             // aget-byte           v4, p0, v1
        48 03 00 03             // aget-byte           v3, v0, v3
        b7 43                   // xor-int/2addr       v3, v4
        8d 33                   // int-to-byte         v3, v3
        4f 03 05 01             // aput-byte           v3, p0, v1
        d8 01 01 01             // add-int/lit8        v1, v1, 1
        }
        $s01 = "Ldalvik/system/BaseDexClassLoader"
        $s02 = "Lcom/m/s/DuceApplication;"
    condition:
        $dex at 0 and $ducex and $algorithm and all of ($s*)
}

