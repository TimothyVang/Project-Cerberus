rule CrowdStrike_CSA_250784_01 : apolog ecrime lightning_spider loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings and CRC32 constants in malicious libraries containing Apolog loader"
        reports = "CSA-250784"
        version = "202507110828"
        last_modified = "2025-07-11"
        actor = "LIGHTNING SPIDER"
        malware_family = "Apolog"
    strings:
        // Windows memory allocation APIs
        $alloc_mem_0 = "VirtualAlloc" ascii
        $alloc_mem_1 = "GetProcessHeap" ascii
        $alloc_mem_2 = "HeapAlloc" ascii
        // Window process callback API registration
        $window_proc_reg_0 = "RegisterClassA" ascii
        $window_proc_reg_1 = "RegisterClassW" ascii
        // Window creation APIs
        $window_create_0 = "CreateWindowExA" ascii
        $window_create_1 = "CreateWindowExW" ascii
        // CRC32 polynomial
        $crc32_poly_0 = {20 83 b8 ed}
        $crc32_poly_1 = {b7 1d c1 04}
        $crc32_poly_2 = {2b 98 33 a8}
        // Possible mutex
        $mutex_0 = "mvcoibjhdoirgh" ascii
        // Hardcoded text filenames
        $filename_0 = "waofgufmiwcrfxnxxbyvxo.txt" ascii
        $filename_1 = "cxjvsfhsko.txt" ascii
        $filename_2 = "rlpefgfmbszeaburfiu.txt" ascii
        // Registry keys and value names
        $reg_0 = "Software\\xmqrkzxrrykcfmeafmzopldt" ascii
        $reg_1 = "Software\\vielbebcvsvfkohxxnosmckp" ascii
        $reg_2 = "dsjvis" ascii
        // Message box output
        $msg_box_0 = "sifos aoiane fn!" ascii
        // File mapping global
        $map_0 = "Global\\pstzetajekppatffhoooqptr" ascii
    condition:
        uint16(0) == 0x5a4d
        and uint32(uint32(0x3c)) == 0x00004550
        and uint8(uint32(0x3c)+4) == 0x64
        and uint16(uint32(0x3c)+22) == 0x2022
        and all of ($alloc_mem_*)
        and (1 of ($window_proc_reg_*)
        and 1 of ($window_create_*))
        and 1 of ($crc32_poly_*)
        and (1 of ($filename_*) or 1 of ($mutex_*,$reg_*,$msg_box_*,$map_*))
        and filesize < 2MB
}

