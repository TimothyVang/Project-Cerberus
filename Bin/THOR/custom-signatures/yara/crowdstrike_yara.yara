rule CrowdStrike_CSIT_21157_01 : downloader pubnubrat ricochet_chollima 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects strings used to create mutexes, ASEP, self-delete command, and PDB paths in PubNubRAT downloaders."
        reports = "CSIT-21157"
        version = "202411121658"
        last_modified = "2024-11-12"
        actor = "RICOCHET CHOLLIMA"
        malware_family = "PubNubRAT"
    strings:
        $mutex_0 = " Avoid Double-Running" wide
        $mutex_1 = " double up" wide
        $self_delete = "cmd.exe /C ping 1.1.1.1 -n 1 -w 3000 > NUL & Del /f /q \"%s\"" wide fullword
        $pdb = "E:\\project\\windows\\Rocket\\"
    condition:
        uint16(0) == 0x5a4d
        and 1 of ($mutex_*)
        and ($self_delete or $pdb)
        and filesize < 3MB
}

rule CrowdStrike_CSIT_21157_02 : pubnubrat rat ricochet_chollima 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects an XOR decoding loop byte sequence, and strings used in function names, mutexes, and PDB paths in PubNubRAT"
        reports = "CSIT-21157"
        version = "202411121658"
        last_modified = "2024-11-12"
        actor = "RICOCHET CHOLLIMA"
        malware_family = "PubNubRAT"
    strings:
        $dn_0 = "BSJB"
        $dn_1 = "#Strings"
        $pdb = "E:\\project\\windows\\Rocket\\"
        $mutex = "12as2345-12ab-sw12sff2-b9d9-d32123456" wide
        $fn_0 = "ProcessMsg"
        $fn_1 = "SendHello"
        $fn_2 = "calcXor"
        $xor_loop = { 03 6f 1c 00 00 0a 8d 38 00 00 01 0b }
    condition:
        2 of ($dn_*) and
        2 of ($fn_*) and
        ($pdb or $mutex or $xor_loop)
        and filesize < 3MB
}

