rule CrowdStrike_CSA_210512_01 : deathkitty ecrime feral_spider linux ransomware 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects a Linux variant of the DeathKitty ransomware family"
        reports = "CSA-210512,CSIT-21174"
        version = "202111041310"
        last_modified = "2021-11-04"
        actor = "FERAL SPIDER"
        malware_family = "DeathKitty"
    strings:
        $ext1 = ".README_TO_RESTORE" ascii
        $ext2 = ".crypt" ascii
        $ext3 = ".locked" ascii
        $ext4 = ".v-society" ascii
        $esx1 = "esxcli vm process kill" ascii
        $esx2 = "esxcli vm process list" ascii
        $esx3 = ".vmdk" ascii
        $esx4 = ".vmsd" ascii
        $esx5 = ".vmsn" ascii
        $log0 = "still running VM:" ascii
        $log1 = "Error find %s in libcrypto.so" ascii
        $log2 = "Error InitAPI" ascii
        $log3 = "File Locked:" ascii
        $log4 = "Unable to rename file from:" ascii
        $log5 = "First try kill" ascii
        $log7 = "Total VM run on host:" ascii
        $log8 = "Total Elapsed:" ascii
        $log9 = "Total Crypted:" ascii
    condition:
        filesize < 1MB and
        uint32(0) == 0x464c457f and
        1 of ($ext*) and
        ((all of ($esx*) and 3 of ($log*)) or 5 of ($log*))
}

