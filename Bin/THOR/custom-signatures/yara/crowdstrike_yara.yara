rule CrowdStrike_CSIT_21017_01 : android dropper ecrime ftt 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Obfuscated dropper code of the fttkit android dex crypter service"
        reports = "CSIT-21017"
        version = "202204140835"
        last_modified = "2022-04-14"
        malware_family = "FTT"
    strings:
        $dex = { 64 65 (78 | 79) 0A 30 ?? ?? 00 }
        $initRC4_part1_1 = { 13 ?? 00 01 35 ?? ?? 00 [0-120] 94 ?? ?? ?? 48 ?? ?? ?? 4F ?? ?? ?? [0-120] 62 ?? ?? ?? 8D ?? 4F ?? ?? ?? [0-120] D8 ?? ?? 01 }
        $initRC4_part1_2 = { 13 ?? 00 01 35 ?? ?? 00 [0-120] 62 ?? ?? ?? 8D ?? 4F ?? ?? ?? [0-120] 94 ?? ?? ?? 48 ?? ?? ?? 4F ?? ?? ?? [0-120] D8 ?? ?? 01 }
        // int v0 = 0; int v3 = 0; while(v0 < 0x100) {
        $initRC4_part2 = { 13 ?? 00 01 35 ?? ?? 00 [0-120] 62 ?? ?? ?? 48 ?? ?? ?? B0 ?? 48 ?? ?? ?? B0 ?? D5 ?? FF 00 [0-120] 62 ?? ?? ?? 48 ?? ?? ?? [0-120] 62 ?? ?? ?? 62 ?? ?? ?? 48 ?? ?? ?? 4F ?? ?? ?? [0-120] 62 ?? ?? ?? 4F ?? ?? ?? [0-120] D8 ?? ?? 01 }
        $swap_shorty = "ILII"
        $swap_elements = { 48 00 03 0? 48 0? 03 0? 4F 0? 03 0? 4F 0? 03 0? 0F 0? }
        // cipher[c] = (byte)(v10[v10[i] + v10[j] & 0xFF] ^ plain[c]);
        $encryptRC4 = { 48 ?? ?? ?? 48 ?? ?? ?? B0 ?? D5 ?? FF 00 [0-120] 48 ?? ?? ?? 48 ?? ?? ?? B7 ?? 8D ?? 4f ?? ?? ?? [0-120] D8 ?? ?? 01 }
        // string decoder routine present in some samples
        $string_decoder = { 00 00 00 00 00 00 00 00 00 00 1A 05 ?? ?? 00 00 00 00 00 00 1A 01 ?? ?? 00 00 00 00 00 00 6E 10 ?? 00 05 00 00 00 00 000C 0700 00 00 0012 08 00 00 00 0071 20 ?? 00 87 00 }
    condition:
        $dex at 0 and $swap_shorty and ($string_decoder or ($encryptRC4 and any of ($initRC4_part1_*) and $initRC4_part2 and $swap_elements))
}

