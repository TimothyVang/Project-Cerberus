        $p2 = "!udp_type"
        $p3 = "!bind_ip"
        $info = "cat /etc/*release|sed '/=/d'|tr -d"
        $AES_key_iv = { 29 23 be 84 e1 6c d6 ae 52 90 49 f1 f1 bb e9 eb b3 a6 db 3c 87 0c 3e 99 24 5e 0d 1c 06 b7 47 de }
        $pkt_types = { 24 64 13 a4 b2 2c 4f 9f af }
