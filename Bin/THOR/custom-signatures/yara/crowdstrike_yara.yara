        xor     edx, edi
        mov     [eax+esi], dl
        inc     eax
        inc     ecx
        jmp     short loc_405DC3
        */
        $xor_resource = { 8D ?? ?? ?? ?? 00 33 C0 89 85 ?? ?? FF FF 89 8D ?? ?? FF FF 3B ?? 73 18 8B D0 83 E2 0F 0F B6 92 ?? ?? ?? 00 0F B6 ?? 33 ?? 88 14 ?? 40 41 EB D8 }
    condition:
        any of them
}

