rule CrowdStrike_CSIT_20085_01 : carbon_spider dotnet dotnet_dropper ecrime 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects the JSS Loader that has been used by CARBON SPIDER to drop Harpy payloads."
        reports = "CSIT-20085"
        version = "202405061441"
        last_modified = "2024-05-06"
        actor = "CARBON SPIDER"
        malware_family = "JSSLoader"
    strings:
        $a = "JSS.AppForm.resources"
        $c = "JSS.Properties"
        $d = "GetChromeHistory"
        $v2_a = "Cmd_JS"
        $v2_b = "Cmd_PWS"
        $v2_c = "Cmd_RAT"
        $v2_d = "Cmd_UNINST"
        $v3_a = "adinfo" wide
        $v3_b = "part_of_domain" wide
        $v3_c = "pc_dns_host_name" wide
        $v4_a = "logical drives" wide
        $v4_b = "system_info" wide
        $v4_c = "network_info" wide
        $v4_d = "adinfo" wide
        $v4_e = "no_ad" wide
        $v5_a = "pc_dns_host_name" wide
        $v5_b = "pc_model" wide
        $v5_c = "logical_drives" wide
        $v5_d = "network_info" wide
        $v5_e = "system_info" wide
        $v5_f = "pc_domain" wide
        $v5_g = "pc_dns_host_name" wide
        $v5_h = "pc_model" wide
        $v6_a = "$body = [IO.File]::ReadAllText(" wide
        $v7_stack_str_1 = { 20 6e 66 69 67 }
        $v7_stack_str_2 = { 20 69 70 63 6f }
        $v7_stack_str_3 = { 20 4c 6f 61 64 }
        $v7_stack_str_4 = { 20 73 79 73 74 }
        $v7_stack_str_5 = { 20 65 6d 69 6e }
        $v7_stack_str_6 = { 20 2e 65 78 65 }
    condition:
        uint16(0) == 0x5A4D and
        ((($a or $c) and not $d) or
        ($v2_a and $v2_b and $v2_c and $v2_d) or
        ($v3_a and $v3_b and $v3_c) or
        ($v4_a and $v4_b and $v4_c and $v4_d and $v4_e) or
        (4 of ($v5*)) or
        $v6_a or
        (all of ($v7*))
        )
}

