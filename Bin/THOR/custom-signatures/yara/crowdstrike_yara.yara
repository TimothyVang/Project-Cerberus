        $DLLRef1 = "apphelp"
        $DLLRef2 = "winmm"
        // Control String header
        $CtrlString1 = "PLUSUN"
        $CtrlString2 = "UUSUN"
    condition:
        ($DLLRef1 or $DLLRef2) and ($CtrlString1 or $CtrlString2)
}

