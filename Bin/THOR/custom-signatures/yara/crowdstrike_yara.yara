rule CrowdStrike_CSIT_18016_03 : cirrus ricochet_chollima tasking 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "File collector component dropped by Cirrus"
        reports = "CSIT_18016"
        version = "202411121651"
        last_modified = "2024-11-12"
        actor = "RICOCHET CHOLLIMA"
        malware_family = "Cirrus"
