rule CrowdStrike_CSIT_23091_01 : play_ransomware playransomware ransomware recess_spider 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Code fragments found in Play ransomware used by RECESS SPIDER"
        reports = "CSIT-23091,CSIT-23134"
        version = "202507152048"
        last_modified = "2025-07-15"
        actor = "RECESS SPIDER"
        malware_family = "PlayRansomware"
    strings:
        $xxh32_0   = { b1 67 56 16 }                      // XXH32 API Hashing Constant
        $xxh32_1   = { 28 44 23 24 }                      // XXH32 API Hashing Constant
        $xxh32_2   = { b1 79 37 9e }                      // XXH32 API Hashing Constant
        $decrypt_0 = { d3 [1-2] 83 e? 01 }                // String Decryption
        $xor_0     = { f6 d2 83 e0 ?? 32 54 }             // XOR Operation Old
        $xor_1     = { 8b 4? ?? 03 [2-8] 0f be 08 33 ca } // XOR Operation Neww
    condition:
