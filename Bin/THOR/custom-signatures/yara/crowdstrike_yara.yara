        $s1 = "HKEY_CURRENT_USER\\Software\\Microsoft\\Fax" wide
        $s2 = "PHPSESSID={0}" wide
        $s3 = "CmService" wide ascii
        $e1 = "clear error" wide
        $e2 = "download error" wide
        $e3 = "execute error" wide
        $e4 = "kill error" wide
        $e5 = "timeout error" wide
        $e6 = "upload error" wide
    condition:
        ( all of ($e*) or
        2 of ($s*) ) and
        filesize < 50KB
}

