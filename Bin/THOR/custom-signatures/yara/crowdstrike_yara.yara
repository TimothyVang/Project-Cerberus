rule CrowdStrike_CSA_220934_02 : occurs_rat rat silent_chollima 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "API hashing routines and keylogging strings"
        reports = "CSA-220934"
        version = "202411121720"
        last_modified = "2024-11-12"
        actor = "SILENT CHOLLIMA"
        malware_family = "OccursRAT"
    strings:
        $occurs = "Error occurs while reading" wide
        $keylog_0 = "{Bksp}" wide fullword
        $keylog_1 = "{DECIMAL}" wide fullword
        $lnk = "lnk_" wide fullword
        /* API hashing ror 13
        ror     r10d, 0Dh
        cmp     r8b, 61h ; 'a'
        movzx   r8d, byte ptr [rdx]
        lea     eax, [rcx-20h]
        cmovl   eax, ecx
        */
        $ror_13_0 = { 41 c1 ca 0d 41 80 f8 61 44 0f b6 02 8d 41 e0 0f 4c c1 }
        $ror_13_1 = { c1 c8 0d 41 80 f9 61 45 0f b6 08 8d 4a e0 0f 4c ca }
    condition:
        uint16(0) == 0x5a4d and
        uint32(uint32(0x3c)) == 0x00004550 and
        4 of them and
        filesize < 2MB
}

