        $ = "%1[A-Z] %2[a-z]{2} ~ _.%1(\"gapi.config.update\"_.%2)"
        $ = "%1[a-z] ~ var %1=window.google"
        $ = "%1[a-zA-Z]{2} ~ this.%1=[]"
        $ = "%1[a-z] %2[a-zA-Z]{2} %3[a-zA-Z]{2} ~ for(var %1=1;%1<this.%2;++%1)this.%3[%1]=0"
        $ = "%1[a-zA-Z]{2} %2[a-zA-Z]{2} ~ this.%1=this.%2=0"
        $ = "%1[a-zA-Z]{2} %2[0-9] %3[0-9]{2,9} ~ this.%1[%2]=1%3"
        $ = "%1[a-zA-Z]{2} %2[0-9] %3[0-9]{2,9} ~ this.%1[%2]=2%3"
        $ = "%1[a-zA-Z]{2} %2[0-9] %3[0-9]{2,9} ~ this.%1[%2]=3%3"
        $ = "%1[a-zA-Z]{2} %2[0-9] %3[0-9]{2,9} ~ this.%1[%2]=4%3"
        $ = "%1[a-z] %2[a-z] %3[a-z] %4[a-z] ~ for(%1=0;16>%1;%1++)%2[%1]=%3[%4]<<24|%3[%4+1]<<16|%3[%4+2]<<8|%3[%4+3],%4+=4"
        $ = "%1[a-z] %2[a-z] %3[a-z] %4[0-9]{9} ~ %1[%2]=(%3<<1|%3>>>31)&4%4"
        $ = "%1[a-zA-Z] %2[a-zA-Z] %3[a-zA-Z] %4[a-zA-Z] %5[a-zA-Z] %6[a-zA-Z] %7[a-zA-Z] %8[a-zA-Z] %9[a-zA-Z] ~ var %1m,%2m,%3m,%4m,%5m,%6m,%7m,%8m,%9m,wm"
        $ = "%1[a-zA-Z]{2} %2[a-z] %3[a-z] %4[a-z]{2} %5[a-zA-Z]{2} %6[a-zA-Z]{2} ~ %1=function(%2){var %3=new _.%4;%3.%5(%2);return %3.%6()}"
        $ = "%1[a-z] %2[a-z] %3[a-z] ~ %1.insertBefore(%2,%3)"
        $ = "%1[a-zA-Z]{2} %2[a-zA-Z] %3[a-z] ~ _.%1(_.%2,%3)"
        $ = "%1[a-z] %2[a-z] ~ %1.name=%1.id=%2"
        $ = "%1[a-z] %2[a-z] ~ %1.eurl=%2"
        $ = "%1[a-z] %2[0-9] %3[a-z] %4[.] ~ if((%1||{}).allowPost&&%2E3<%3.length){%4}"
        $ = "%1[a-z] %2[a-z]{2} %3[a-z] %4[a-z] %5[a-z] %6[a-z] ~ %1=_.%2(%3,%4,%5,%6)"
        $ = "%1[a-z] %2[a-z] ~ %1.appendChild(%2)"
        $ = "%1[a-z] %2[a-z] ~ %1.parentNode.removeChild(%2)"
        $ = "%1[a-zA-Z]{2} %2[a-z] %3[a-z] ~ _.%1=function(%2,%3){return 0==%2.lastIndexOf(%3,0)}"
        $ = "%1[a-zA-Z] %2[a-z]{3,5} %3[a-z] %4[a-z] %5[a-zA-Z]{2} ~ %1.prototype.%2=function(%3,%4){this.%5=%3;this.scope=%4;this.next=null}"
        $ = "%1[a-zA-Z]{2} %2[a-z] %3[a-z] ~ %1.add(%2,%3)"
        $ = "%1[a-zA-Z]{2} %2[a-zA-Z]{2} %3[a-z] %4[a-zA-Z]{2} %5[a-zA-Z]{2} %6[0-9] ~ _.%1.prototype.%2=function(%3){this.%4=0;%5(this,%6,%3)}"
        $ = "%1[a-zA-Z]{2} %2[a-z] %3[a-zA-Z]{2} %4[a-z]{2} %5[a-z] ~ _.%1(function(){%2.%3&&%4.call(null,%5)})"
