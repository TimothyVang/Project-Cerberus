        $hex_string = { 34 69 4d ?? ?? 88 ?? ?? 41 ?? ?? ?? ?? 34 69 88 ?? ?? 41 ?? ?? ?? ?? 34 63 88 ?? ?? 41 ?? ?? ?? ?? 34 73 88 ?? ?? 41 ?? ?? ?? ?? 34 72 88 ?? ?? 41 ?? ?? ?? ?? 34 6c 88 ?? ?? 41 ?? ?? ?? ?? 34 5c 88 ?? ?? 41 ?? ?? ?? ?? 34 63 88 ?? ?? 41 ?? ?? ?? ?? 34 5c }
