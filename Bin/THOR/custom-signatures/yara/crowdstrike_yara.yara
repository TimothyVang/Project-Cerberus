rule CrowdStrike_ElitePP_CodePattern1 : backdoor elitepp 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Characteristic 32-bit code used for generating random strings and command invocation; also contains plaintext strings that are included from a statically linked JSON parsing library"
        version = "202407050746"
        last_modified = "2024-07-05"
        malware_family = "ElitePP"
    strings:
        // strings from legitimate JSON parsing library for disambiguation
        $json01 = "[json.exception"
        $json02 = "discarded"
        $json03 = "type must be number, but is "
        // OPTION 1:
        //     83 F9 0F             //   cmp     ecx, 0Fh
        //     0F 47 C6             //   cmova   eax, esi
        //     8A 04 10             //   mov     al, [eax+edx]
        // OPTION 2:
        //     83 F9 10             //   cmp     ecx, 10h
        //     0F 43 C6             //   cmovnb  eax, esi
        //     8A 04 10             //   mov     al, [eax+edx]
        $rnd_character = {
        83 f9 (0f0f47|100f43) c6 8a 04 10
        }
        // BF 0C 00 00 00          //   mov     edi, 0Ch
        // 88 ?? EC                //   mov     [ebp+??], al
        // 8D ?? EC                //   lea     ecx, [ebp+??]
        // E8 ?? ?? 00 00          //   call    get_random_character
        // 88 06                   //   mov     [esi], al
        // 8D 76 01                //   lea     esi, [esi+1]
        // 83 EF 01                //   sub     edi, 1
        // 75 EE                   //   jnz     LOOP
        $rnd_string = { bf 0c 00 00 00 88 ?? ec 8d ?? ec e8 ?? ?? 00 00 88 06 8d 76 01 83 ef 01 75 ee }
        // 68 60 EA 00 00          //   push    0EA60h
        // FF B5 ?? ?? ?? ??       //   push    dword ptr [ebp-???]
        // FF 15 ?? ?? ?? ??       //   call    ds:WaitForSingleObject
        // 3D 02 01 00 00          //   cmp     eax, 102h
        // 75 20                   //   jnz     short DONE
        // FF B5 ?? ?? ?? ??       //   push    dword ptr [ebp-???]
        // 6A 01                   //   push    1
        // 68 FF FF 1F 00          //   push    1FFFFFh
        // FF 15 ?? ?? ?? ??       //   call    ds:OpenProcess
        // 85 C0                   //   test    eax, eax
        // 74 09                   //   jz      short DONE
        // 6A 00                   //   push    0
        // 50                      //   push    eax
        // FF 15 ?? ?? ?? ??       //   call    ds:TerminateProcess
        $curl_process_wait = {
        68 60 ea 00 00 ff b5 ??  ?? ?? ?? ff 15 ?? ?? ??
        ?? 3d 02 01 00 00 75 20  ff b5 ?? ?? ?? ?? 6a 01
        68 ff ff 1f 00 ff 15 ??  ?? ?? ?? 85 c0 74 09 6a
        00 50 ff 15 ?? ?? ?? ??
        }
    condition:
        uint16(0) == 0x5A4D and
        all of ($json*) and
        (all of ($rnd*) or $curl_process_wait) and
        filesize < 5MB and filesize > 5KB
}

