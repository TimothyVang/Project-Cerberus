rule CrowdStrike_CSA_220804_01 : dotnet downloader ecrime post_exploitation ransomwarerunner 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings and code sequences used by .NET tool designed to perform system reconnaissance, upload data, and deploy ransomware"
        reports = "CSA-220804"
        version = "202307131220"
        last_modified = "2023-07-13"
        malware_family = "RansomwareRunner"
    strings:
        //Strings used for core components of the tool's execution
        $str_screensaver = "screensaver.exe" wide ascii
        $str_content_header_1 = "Content-Disposition: form-data; name=\"{0}\"{1}{1}" wide ascii
        $str_content_header_2 = "Content-Disposition: form-data; name=\"{0}\"; filename=\"{1}\"{2}" wide ascii
        $str_uploaded_info = "UploadDedInfo" wide ascii
        $str_retry_send = "RETRY SEND??" wide ascii
        $str_upload_error = "UPLOAD ERROR" wide ascii
        $str_unkn = "UNKNOWN" wide ascii
        $str_std_time = "+#;-#; Standard Time" wide ascii
        //Initial parameters of the "FullInfo" reconnaissance function
        $full_info = {
        (0a 06 | 73 [4] 25) 72 [4] 28 [4] 6f [4] (00 06 | 25) 72 [4]
        28 [4] 6f [4] (00 06 | 25) 72 [4] 28 [4] 6f [4] (00 06 | 25)
        72 [4] 28 [4] 6f [4] (00 06 | 25) 72 [4] (7e [4] 1f 14 19 28
        [4] 6f [4] 00 06 | 28 [4] 6f [4] 25) 72
        }
        //"UploadDedInfo" function core
        $uploaddedinfo = { 72 [4] 02 03 28 [4-5] de [1-4] 6f [4] 72 }
    condition:
        uint16(0) == 0x5a4d and
        uint32(uint32(0x3c)) == 0x00004550 and
        (4 of ($str_*) or 2 of ($full_info,$uploaddedinfo)) and
        filesize < 50KB
}

