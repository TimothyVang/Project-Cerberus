rule CrowdStrike_CSA_230232_01 : rat silent_chollima valobfor 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings, configuration decoding loop, and execution delay function prologue in Valobfor"
