rule CrowdStrike_WizardUpdate_Golang_Downloader : downloader macos 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Golang downloader used to deliver the macOS malware WizardUpdate"
        version = "202306020925"
        last_modified = "2023-06-02"
        malware_family = "WizardUpdate"
    strings:
        // Mach-O file magic numbers
        $macho_magic_number_0 = { cf fa ed fe } // MH_MAGIC_64, 64-bit with same endianness as host
        $macho_magic_number_1 = { ca fe ba be } // Mach-O universal binary with multiple architectures
        $golang = "runtime: failed to create new OS thread"
        $download_url_replaced_string = "{ID}"
        /*
        c7 44 24 ?? 2f 62 69 6e   mov [rsp+<stack_string_var>], '/bin'
        */
        $command_execution_stack_string_x86_64_asm = {
        c7 44 24 ?? 2f 62 69 6e
        }
        $command_execution_stack_string_literal_0 = "ioreg"
        $command_execution_stack_string_literal_1 = "IOPlat"
        $command_execution_stack_string_literal_2 = "-xpath"
        $command_execution_stack_string_literal_3 = "maid="
    condition:
        for any of ($macho_magic_number_*) : ( $ at 0 )
        and $golang
        and $download_url_replaced_string
        and 3 of ($command_execution_stack_string_*)
        and filesize > 1MB
}

