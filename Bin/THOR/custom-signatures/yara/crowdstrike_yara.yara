        $s4 = { c7 05 ?? ?? ?? ?? 40 7e 05 00 }
        $s5 = { c7 05 ?? ?? ?? ?? ?? 08 00 00 }
        $c1 = "Embarcadero Delphi for Win32 compiler version 32.0 (25.0.26309.314)"
        $s6 = "FS_Temp" wide
