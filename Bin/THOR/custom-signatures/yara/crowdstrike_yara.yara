        $string3 = "[+] Round %d"
        $string4 = "[+] Path: %s"
        $string5 = "[+] CPU cores: %d, Threads: %d"
        $cmd1 = "lla/ teIuq/ swodahs   eteled nimdassv  c/ exe.dmc"
        $cmd2 = "eteled ypocwodahs cimw c/ exe.dmc"
        $cmd3 = "eruliafllaerongi ycilopsutatstoob }tluafed{ tes / tidedcb c / exe.dmc"
