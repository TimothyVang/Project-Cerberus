        $ = "FromBase64String"
        $ = "WatsonTcp"
        $ = "GetForegroundWindow"
        $ = "GetProcesses"
        $ = "IUIAutomationElement"
    condition:
        all of them and
        uint32(uint32(0x3c)) == 0x4550 and
        ((uint16(uint32(0x3c)+24) == 0x010b and uint32(uint32(0x3c)+232)>0) or
        (uint16(uint32(0x3c)+24) == 0x020b and uint32(uint32(0x3c)+248)>0)) and
        filesize < 3MB
}

