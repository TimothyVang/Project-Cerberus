        $c2_4 = "vc4cgaf"
        $c2_5 = "/index.php?passed="
        $c2_6 = "v2ggla"
    condition:
        uint16(0) == 0x5a4d and
        (
        3 of ($c2_*)
        or ($path_1 and $filename)
        or all of ($pdb_*)
        or (all of ($func_*) and $filename)
        or any of ($guid_*)
        or ($timestamp and $filename)
        )
}

