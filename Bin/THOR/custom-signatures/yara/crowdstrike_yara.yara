rule CrowdStrike_CSA_210702_01 : loader pyxie sprite_spider vatet 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects two unique XOR and arithmetic decoding algorithms used in trojanized RedisStudio compilations containing the SPRITE SPIDER Vatet loader"
        reports = "CSA-210702"
        version = "202109071819"
        last_modified = "2021-09-07"
        actor = "SPRITE SPIDER"
        malware_family = "Vatet"
    strings:
        // Check BOOL flag for decoding completion and ensure .dat file buffer size is greater than 0 to prepare for decoding
        $decode_check_1 = {
        39 [5] 75 ?? 8b [5] c7 05
        [4] 01 00 00 00 3b ?? 74
        [2] 8b [5] 3b ?? 76 ?? b0
        }
        // Check BOOL flag for decoding completion, check memory allocated for decoded data, and ensure .dat file buffer size is greater than 0 to prepare for decoding
        $decode_check_2 = {
        39 [5] 75 ?? a1 [4] c7 05
        [4] 01 00 00 00 3b ?? 74
        ?? 8b [5] 3b ?? 76
        }
        // XOR and arithmetic decoding loop observed in samples March-June 2021
        $xor_decode_1 = {
        8a 14 39 32 d0 80 ea ?? 32  d0 80 c2 ?? 32 d0 80 ea ??
        32 d0 80 ea ?? 32 d0 80 c2  ?? 32 d0 80 c2 ?? 32 d0 80
        c2 ?? 32 d0 80 ea ?? 32 d0  80 c2 ?? 32 d0 80 ea ?? 32
        d0 88 14 39 47 3B ?? 72
        }
        // XOR and arithmetic decoding loop observed in samples July-early August 2021
        $xor_decode_2 = {
        8a 1c 39 b2 ?? 2a da 32  d8 2a da 32 d8 2a da 32
        d8 80 c3 ?? 32 d8 80 c3  ?? 32 d8 80 eb ?? 32 d8
        80 c3 ?? 32 d8 2a da 32  d8 80 c3 ?? 32 d8 2a da
        88 1c 39 47 3b ?? 72
        }
        // XOR and arithmetic decoding loop observed in samples August 2021
        $xor_decode_3 = {
        8a 1c 30 32 da 80 eb ?? 32  da 80 eb ?? 32 da 80 eb ??
        32 da 80 c3 ?? 32 da 80 c3  ?? 32 da 88 1c 30 46 3b ??
        72
        }
        // XOR and arithmetic decoding loop observed in samples August 2021
        $xor_decode_4 = {
        8a 14 30 80 f2 ?? 80 c2 ??  80 f2 ?? 80 c2 ?? 88 14 30
        46 3b ?? 72
        }
    condition:
        1 of ($decode_check*) and
        1 of ($xor_decode*)
}

