        $add_rdp_port = "reg add \"hklm\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v \"PortNumber\" /t REG_DWORD /d "
        $open_port_in_firewall = "netsh advfirewall firewall add rule name=\""
    condition:
