        75 ??                         jne ??
        ff 15 ?? ?? ?? ??             call ??
        4c 8b c3                      mov r8, rbx
        33 d2                         xor edx, edx
        48 8b c8                      mov rcx, rax
        48 83 c4 20                   add rsp, 0x20
        5B                            pop rbx
