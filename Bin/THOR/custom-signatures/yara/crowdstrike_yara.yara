        actor = "TRAVELING SPIDER"
        malware_family = "INCRansomware"
    strings:
        $s1 = "Start encryption" wide
        $s2 = "[%s] Stop using process" wide
        $s3 = "[%s] Encrypt network shares" wide
        $s4 = "[%s] Load hidden drives" wide
        $s5 = "[*] Starting full encryption in 5s" wide
        $s6 = "[+] Successfully delete shadow copies from" wide
        $s7 = "[+] Sending note to printer" wide
        $s8 = "INC" wide
        // DeviceIO Control to Delete Shadow Copies
        $io1 = "DeviceIoControl"
        $io2 = { 68 28 c0 53 00 }
        // File Encryption
        $enc1 = "CryptStringToBinaryA"
        $enc2 = "CryptGenRandom"
        $enc3 = "BCryptGenRandom"
        // ECC Curve25519
        $enc4 = { 24 3f 80 65 d8 f8 83 c4 0c 0c 40 }
        // SHA256 Constants
        $sha1 = { 67 e6 09 6a }
        $sha2 = { 08 c9 bc f3 }
        $sha3 = { 85 ae 67 bb }
        $sha4 = { 3b a7 ca 84 }
        $sha5 = { 72 f3 6e 3c }
        $sha6 = { 2b f8 94 fe }
        $sha7 = { 3a f5 4f a5 }
        $sha8 = { f1 36 1d 5f }
        $sha9 = { 7f 52 0e 51 }
        $sha10 = { d1 82 e6 ad }
        $sha11 = { 8c 68 05 9b }
        $sha12 = { 1f 6c 3e 2b }
        $sha13 = { ab d9 83 1f }
        $sha14 = { 6b bd 41 fb }
        $sha15 = { 19 cd e0 5b }
        $sha16 = { 79 21 7e 13 }
        // Count of Drive Strings
        $dr = ":\\" wide
    condition:
        uint16(0) == 0x5A4D and
        all of ($s*) and
        all of ($io*) and
        3 of ($enc*) and
        5 of ($sha*) and
        #dr > 20
}

