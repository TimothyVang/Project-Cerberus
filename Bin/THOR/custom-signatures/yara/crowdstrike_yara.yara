rule CrowdStrike_CSA_231684_01 : solar_marker 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "SolarMarker Compiled Pascal Script"
        reports = "CSA-231684"
        version = "202311170750"
        last_modified = "2023-11-17"
        malware_family = "SolarMarker"
    strings:
        $xor_key = {
        14 00 00 00 // String Type
        20 00 00 00 // String Length (x2)
        ?? [30] ??  // XOR Key String
        }
        $powershell_0 = "-bxor" wide
    condition:
        uint32(0) == 0x53504649 and
        $powershell_0 and
        for any j in (0..#xor_key):(
        for all i in (0..63):(
        (
        uint8(@xor_key[j] + 8 + i) >= 0x30 and
        uint8(@xor_key[j] + 8 + i) <= 0x7a
        ) or
        uint8(@xor_key[j] + 8 + i) == 0x00
        )
        )
}

