        $ = "CryptImportKey"
        $ = "CryptEncrypt"
        $ = "\\recovery" wide
        $ = "\\recycled" wide
        $ = "\\recycler" wide
        $ = "\\system volume information" wide
        $ = "\\windows.old" wide
        $ = "\\windows10upgrade "wide
        $ = "\\windows" wide
        $ = "\\winnt" wide
        $ = "%TEMP%" wide
        $ = "onetoc2" wide
        $ = "wallet" wide
