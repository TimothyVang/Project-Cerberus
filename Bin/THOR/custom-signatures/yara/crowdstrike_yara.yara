rule CrowdStrike_CSIT_23356_01 : loader wailing_crab wiki_loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "WikiLoader sleep code and DLL resolution"
        reports = "CSIT-23356"
        version = "202402090934"
        last_modified = "2024-02-09"
        malware_family = "WikiLoader"
    strings:
        /*
        48:c7c2 80969800         | mov rdx,989680
        48:83ea 01               | sub rdx,1
        48:83fa 00               | cmp rdx,0
        75 f6                    | jne salut.1800107f6
        */
        $delay = {48 c7 c2 80 96 98 00 48 83 ea 01 48 83 fa 00 75 f6 }
        /*
        .text:0000000180010a58 88 47 01       mov     [rdi+1], al
        .text:0000000180010a5b b0 6e          mov     al, 6Eh ; 'n'
        .text:0000000180010a5d 88 47 02       mov     [rdi+2], al
        .text:0000000180010a60 b0 67          mov     al, 67h ; 'g'
        .text:0000000180010a62 88 47 03       mov     [rdi+3], al
        .text:0000000180010a65 b0 6d          mov     al, 6Dh ; 'm'
        .text:0000000180010a67 88 47 04       mov     [rdi+4], al
        .text:0000000180010a6a b0 61          mov     al, 61h ; 'a'
        .text:0000000180010a6c 88 47 05       mov     [rdi+5], al
        .text:0000000180010a6f b0 70          mov     al, 70h ; 'p'
        .text:0000000180010a71 88 47 06       mov     [rdi+6], al
        .text:0000000180010a74 b0 73          mov     al, 73h ; 's'
        .text:0000000180010a76 88 47 07       mov     [rdi+7], al
        */
        $dll_name_composition = {88 ?? 01 b0 6e 88 ?? 02  b0 67 88 ?? 03 b0 6d 88
        ?? 04 b0 61 88 ?? 05 b0  70 88 ?? 06 b0 73 88 ??
        07 }
        /*
        .text:0000000180010d3e 41 81 fd 20 00 00 60                    cmp     r13d, 60000020h
        .text:0000000180010d45 74 09                                   jz      short loc_180010D50
        */
        $section_characteristics_check = {48 81 fd 20 00 00 60 74 }
    condition:
        $delay or $dll_name_composition or $section_characteristics_check
}

