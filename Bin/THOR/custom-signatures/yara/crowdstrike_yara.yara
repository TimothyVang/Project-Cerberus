rule CrowdStrike_CSA_250024_02 : android json_packer 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Libraries and methods to decrypt the packed payload and part of the RC4 algorithm"
        reports = "CSA-250024"
        version = "202501101027"
        last_modified = "2025-01-10"
        malware_family = "JsonPacker"
    strings:
        $dex   = {  64 65 (78 | 79) 0A 30 ?? ?? 00 }
        $lib01 = "Ljava/io/FileOutputStream;"
        $lib02 = "Ljava/io/InputStream;"
        $lib03 = "Ljava/io/BufferedInputStream;"
        $lib04 = "Ljava/io/FileInputStream;"
        $lib05 = "Ljava/util/zip/ZipInputStream;"
        $lib06 = "Ljava/util/zip/ZipEntry;"
        $lib07 = "Ljava/lang/ClassLoader;"
        $classLoader01 = "makeDexElements" fullword
        $classLoader02 = "makePathElements" fullword
        $classLoader03 = "dexElementsSuppressedExceptions" fullword
        $classLoader11 = "Ldalvik/system/DexClassLoader;"
        $classLoader12 = "Ljava/lang/StrictMath;"
        $xor_algorithm = {
        D4 ?? 00 01             // rem-int/lit16       v5, v5, 0x0100
        44 0? 0? 0?             // aget                v4, v4, v5
        [0-100]
        48 0? 0? 0?             // aget-byte           v5, p1, v0
        B7 ??                   // xor-int/2addr       v4, v5
        }
    condition:
        $dex at 0 and
        all of ($lib*) and (all of ($classLoader0*) or all of ($classLoader1*)) and $xor_algorithm
}

