        $keys_x86 = { 0f 11 [2-5] 56 0f 28 05 [4] 0f 11 [2-5] 57 0f 28 05 [4] 0f 11 }
        $h_x86 = { 3d bf 03 00 00 (0f 87 ?? ?? ?? ?? | 77 ?? | 75 ??) 03 ?? 89 [2-5] 81 ?? 50 45 00 00 }
        $res_1 = { 6a 02 68 c9 00 00 00 }
        $res_2 = { 6a 02 68 81 00 00 00 }
        $res_3 = { ba 81 00 00 00 48 8b cb } // bitmap resource number 0x81
        $res_4 = { 41 b8 02 00 00 00 ba c9 00 00 00 } // bitmap resource number 0xC9
        $res_5 = { ba c9 00 00 00 41 b8 02 00 00 00 }
        $hash_1 = { 81 ?? 8e 4e 0e ec }
        $hash_2 = { 81 ?? aa fc 0d 7c }
        $hash_3 = { 81 ?? 54 ca af 91 }
        $hash_4 = { 81 ?? 55 9a d0 3b }
