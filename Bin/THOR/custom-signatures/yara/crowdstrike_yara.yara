rule CrowdStrike_CSA_240555_02 : loader packer veiled_loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "VeiledLoader's API hashing algorithm"
        reports = "CSA-240555"
        version = "202405170609"
        last_modified = "2024-05-17"
        malware_family = "VeiledLoader"
    strings:
        /* API hashing code, imul7fhAdd
        0F BE 0A     movsx   ecx, byte ptr [rdx]
        6B DB 7F     imul    ebx, 7Fh
        48 8D 52 01  lea     rdx, [rdx+1]
        03 D9        add     ebx, ecx
        84 C9        test    cl, cl
        75 F0        jnz     short loc_180001BF0
        */
        $code = { 0f be ?? 6b ?? 7f 48 8d ?? 01 03 ?? 84 ?? 75 f0 }
        // API hash values
        $h1 = { 5b403a76 } // OpenProcess
        $h2 = { 03b90f25 } // VirtualAllocEx
        $h3 = { cf5dcffd } // WriteProcessMemory
        $h4 = { e99699ea } // VirtualProtectEx
        $h5 = { d471a7d5 } // CreateRemoteThread
    condition:
        uint16(0) == 0x5A4D and uint32(uint32(0x3c)) == 0x4550 and
        ($code or all of ($h*)) and filesize < 5MB
}

