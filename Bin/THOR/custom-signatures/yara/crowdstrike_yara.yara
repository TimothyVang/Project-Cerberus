rule CrowdStrike_CSIT_19073_02 : pirate_panda rat tsslclientrat 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "TSSLClient RAT used by PIRATE PANDA in targeted attacks"
