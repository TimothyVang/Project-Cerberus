rule CrowdStrike_CSA_221106_02 : solar_marker solarmarker 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "SolarMarker PowerShell Loader"
        reports = "CSA-221106,CSA-230828,CSA-231101,CSA-231684,CSA-240196,CSIT-22226"
        version = "202506061335"
        last_modified = "2025-06-06"
        malware_family = "SolarMarker"
    strings:
        $common_0 = "::Load("
        $common_1 = "::FromBase64String("
        $common_2 = ".Key"
        $common_3 = "IV"
        $less_common_0 = "'+'"
        $less_common_1 = "\"+\""
        $less_common_2 = "@([byte]"
        $less_common_3 = "iex "
        $less_common_4 = "-bxor"
        $unique_0 = "ToFileTimeUTC()"
        $unique_1 = "-join (0..(10..30|Get-Random)|%{ [char]((65..90)+(97..122)|get-random) })"
        $unique_2 = "Start-Sleep"
        $unique_3 = "Start-Process"
        $unique_4 = "-itemtype registrykey -force"
        $unique_5 = "-ItemType RegistryKey -Force"
        $unique_6 = "HWIDPD"
        $unique_7 = "]-join''"
        $execute_0 = /\[\w+\.\w+\]::\w+\(\$/
        $execute_1 = /\[\w+\]::\w+\(\d+/
        $heuristic_0 = { 0d 0a }  // Windows New Lines
        $heuristic_1 = "return" // Returns
        $exclude_0 = "&((" ascii wide
        $exclude_1 = "&amp;((" ascii wide
        $exclude_2 = "client32.exe" ascii wide
    condition:
        filesize < 10MB
        and (
        // Typical Starting Characters
        uint8(0) == 0x66    // f (function)
        or uint8(0) == 0x5b // [ (Dotnet Bracket)
        or uint8(0) == 0x24 // $ (variable)
        or uint8(0) == 0x53 // S (Start-Sleep)
        )
        and (
        not (
        // Exclude these Magic Values
        uint16(0) == 0x5a4d // MZ (PE)
        or uint16(0) == 0x7b5b // [{ (Likely JSON)
        or uint16(0) == 0x0d5b // Likely JSON
        or uint16(0) == 0x0a5b // Likely JSON
        or (uint8(0) >= 0x61 and uint8(0) <= 0x7a) // Lowercase Letter
        or (uint8(0) >= 0x41 and uint8(0) <= 0x5a) // Uppercase Letter
        )
        or (
        uint8(0) == 0x66    // f
        or uint8(0) == 0x46 // F
        or uint8(0) == 0x73 // s
        or uint8(0) == 0x53 // S
        )
        )
        and #heuristic_0 >= 0
        and #heuristic_0 < 128
        and #heuristic_1 < 4
        and 2 of ($common_*)
        and 1 of ($less_common_*)
        and 1 of ($execute_*)
        and 1 of ($unique_*)
        and not 1 of ($exclude_*)
}

