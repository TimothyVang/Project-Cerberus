rule CrowdStrike_CSA_211015_01 : downloader labyrinth_chollima winwebdown 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects format strings and XOR-decoding loops in WinWebDown downloader."
        reports = "CSA-211015,CSIT-22011"
        version = "202411121658"
        last_modified = "2024-11-12"
        actor = "LABYRINTH CHOLLIMA"
        malware_family = "WinWebDown"
    strings:
        $format_string_0 = "%c=%s&%c=%s&%c=%s&%c=" ascii fullword
        $format_string_1 = "%s\\%s(%d).%s" wide fullword
        /* Series of XOR decoding loops processing 3 bytes of a buffer per iteration, e.g.,
        80 71 FF 34          xor     byte ptr [rcx-1], 34h
        80 31 34             xor     byte ptr [rcx], 34h
        80 71 01 34          xor     byte ptr [rcx+1], 34h
        48 83 C1 03          add     rcx, 3
        */
        $xor_34 = { 80 71 ff 34 80 31 34 80 71 01 34 48 83 c1 03 }
        $xor_37 = { 80 70 ff 37 80 30 37 80 70 01 37 48 83 c0 03 }
        $xor_95 = { 41 80 73 ff 95 41 80 33 95 41 80 73 01 95 49 83 c3 03 }
    condition:
        uint16(0) == 0x5a4d
        and 2 of them
        and filesize < 300KB
}

