rule CrowdStrike_CSIT_24225_02 : ecrime fog_ransomware ransomware 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings observed in Fog ransomware for Windows"
        reports = "CSA-250485,CSIT-24225"
        version = "202504221739"
        last_modified = "2025-04-22"
        malware_family = "FogRansomware"
    strings:
        $s1 = "[-] CreateProcessA(vssadmin) error, code %d" fullword ascii
        $s2 = "[-] Init error - config signature not found." fullword ascii
        $s3 = "[-] Error parsing and loading config - exiting." fullword ascii
        $s4 = "[-] call OpenProcess(%s) failed, code %d" fullword ascii
        $s5 = "[-] Exiting by mutext check" fullword ascii
        $s6 = "[+] Defined mutex name: %s" fullword ascii
        $s7 = "%s%s\\vssadmin.exe delete shadows /all /quiet" fullword ascii
        $s8 = "[!] Skip mutex check by -nomutex param." fullword ascii
        $s9 = "[-] IsWow64Process() call error, code %d" fullword ascii
        $s10 = "[!] Process PID %d possibly lock file, try terminate" fullword ascii
        $s11 = "[-] call Process32First() failed, code %d" fullword ascii
        $s12 = "[-] Error call CommandLineToArgvW, code: %d" fullword ascii
        $s13 = "[-] CryptImportKey(Public) error, code: %d" fullword ascii
        $s14 = "[-] Error create Note file %s, error code %d" fullword ascii
        $s15 = "[-] CryptEncrypt() error, code: %d" fullword ascii
        $s16 = "[-] GetFileSizeEx(%ws) error, code %d" fullword ascii
        $s17 = "[!] File %ws is locked by another process. Try unlock" fullword ascii
        $s18 = "<requestedExecutionLevel level='asInvoker' uiAccess='false' />" fullword ascii
        $s19 = "he maximum number of processes has been reached!" fullword ascii
        $s20 = "[-] call ControlService(%s) failed, error %d" fullword ascii
