rule CrowdStrike_CSA_250896_01 : demon_spider downloader ecrime matanbuchus 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Constants and data operations in Matanbuchus version 3.0 downloaders"
        reports = "CSA-250896"
        version = "202508080938"
        last_modified = "2025-08-08"
        actor = "DEMON SPIDER"
        malware_family = "Matanbuchus"
    strings:
        // CreateMutexW is not dynamically resolved and must be present
        $createmutex = "CreateMutexW" ascii
        // murmurhash3 constants
        $murmur_const_0 = {51 2d 9e cc}
        $murmur_const_1 = {93 35 87 1b}
        // Modification constant used with murmurhash3
        $murmur_mod = {a4 da 92 00}
        // ChaCha20 initialization constant components
        $chacha_0 = {65 78 70 61}
        $chacha_1 = {6e 64 20 33}
        $chacha_2 = {32 2d 62 79}
        $chacha_3 = {74 65 20 6b}
        // API resolution wrapper
        $api_wrapper = { 83 3d [4] 00 75 ?? 68 [4] a1 [4] 50 e8 [4] 83 c4 ?? a3 }
        // Parse the nonce from an encrypted message structure
        $nonce_assembly = { 8b ?5 ?? 83 c? 20 8b 0? [4-8] 8b ?? 04 [4-8] 8b ?? 08 89 }
        // Copy 32-byte ChaCha20 key in string decrypt function
        $copy_key = { b9 08 00 00 00 be [4] 8d 7d ?? f3 a5 }
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550
        and $createmutex
        and (all of ($murmur_*) or all of ($chacha_*))
        and #api_wrapper > 3
        and 1 of ($nonce_assembly,$copy_key)
}

