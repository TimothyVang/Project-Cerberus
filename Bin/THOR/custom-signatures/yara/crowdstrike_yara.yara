rule CrowdStrike_CSA_221066_01 : apolog ecrime loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique code sequences and dummy Windows API calls used by the Apolog Loader"
        reports = "CSA-221066,CSIT-22248"
        version = "202212090951"
        last_modified = "2022-12-09"
        malware_family = "Apolog"
    strings:
        /* Base64 decoding code with '=' padding character check */
        $base64_pad_char = { 83 fa 3d 75 }
        /* Base64 decoding implemented using the Windows CryptStringToBinaryA function with function name string built on the stack */
        $base64_cryptstringtobinarya = {
        74 53 74 72 c7 44 ?? c8  43 72 79 70 [4-20] c7 44 ??
        c8 69 6e 67 54 [4-20] c7 44  ?? c8 61 72 79 41
        }
        /* Setup loop to iterate over alphabet for in-lined Base64 decoding of the encrypted shellcode loader */
        $base64_init_alphabet = {
        83 fa 40 7d ?? 0f be ??  ?? 0f be
        }
        /* Multiple asm permutations of the custom decoding algorithm used by Apolog to decode the custom shellcode and encrypted payload */
        $deobfuscate_shellcode_0 = {
        b9 04 00 00 00 d1 e1
        }
        $deobfuscate_shellcode_1 = {
        b9 04 00 00 00 c1 e1 00
        }
        $deobfuscate_shellcode_2 = {
        c1 ?? 06 8b [1-4] 8b [1-4] c1 ?? 08
        }
        $deobfuscate_shellcode_var = {
        b9 04 00 00 00 ?? e1 [0-4]  ba
        }
        /* DLL file name pattern observed in multiple samples */
        $dll_name = /fork[0-9]{1,2}.dll/
        /* Multiple unusual Windows API functions imported as part of numerous "dummy" API calls with no parameters and unused results */
        $dummy_winapi_import_1 = "GetTapePosition" wide ascii
        $dummy_winapi_import_2 = "SetTapePosition" wide ascii
        $dummy_winapi_import_3 = "EraseTape" wide ascii
        $dummy_winapi_import_4 = "SetCurrentConsoleFontEx" wide ascii
        $dummy_winapi_import_5 = "FoldStringA" wide ascii
        $dummy_winapi_import_6 = "FileTimeToDosDateTime" wide ascii
        $dummy_winapi_import_7 = "DosDateTimeToFileTime" wide ascii
        $dummy_winapi_import_8 = "GetCurrencyFormatA" wide ascii
        $dummy_winapi_import_9 = "GetCurrencyFormatEx" wide ascii
        $dummy_winapi_import_10 = "OutputDebugStringA" wide ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550
        and 1 of ($base64_*) and 1 of ($deobfuscate_shellcode_*)
        and (2 of ($dummy_*) or $dll_name)
        and filesize < 1MB
}

