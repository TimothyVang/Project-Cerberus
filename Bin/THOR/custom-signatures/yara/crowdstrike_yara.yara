rule CrowdStrike_CSIT_21241_01 : loader nemesis_kitten powerless 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects NEMESIS KITTEN PowerLessCLR Executable Through Code Signature"
        reports = "CSIT-21241"
        version = "202203251724"
        last_modified = "2022-03-25"
        actor = "NEMESIS KITTEN"
        malware_family = "PowerLess"
    strings:
        $str1 = "ConsoleWindowClass"
        $str2 = "v4.0.30319" wide
        // load args, call dll, clean up
        $code = {
        48 8B 4C 24 50        // mov     rcx, [rsp+38h+arg_10]
        4C 8D 4C 24 58        // lea     r9, [rsp+38h+arg_18]
        4C 8D 05 ?? ?? ?? ??  // lea     r8, unk_140002338
        48 8D 15 ?? ?? ?? ??  // lea     rdx, aV4030319  ; "v4.0.30319"
        48 8B 01              // mov     rax, [rcx]
        FF 50 18              // call    qword ptr [rax+18h]
        48 8B 4C 24 58        // mov     rcx, [rsp+38h+arg_18]
        4C 8D 4C 24 48        // lea     r9, [rsp+38h+arg_8]
        4C 8D 05 ?? ?? ?? ??  // lea     r8, unk_140002308
        48 8D 15 ?? ?? ?? ??  // lea     rdx, unk_140002318
        48 8B 01              // mov     rax, [rcx]
        FF 50 48              // call    qword ptr [rax+48h]
        48 8B 4C 24 48        // mov     rcx, [rsp+38h+arg_8]
        48 8B 01              // mov     rax, [rcx]
        FF 50 18              // call    qword ptr [rax+18h]
        48 8B 4C 24 48        // mov     rcx, [rsp+38h+arg_8]
        48 8D 54 24 40        // lea     rdx, [rsp+38h+arg_0]
        48 89 54 24 28        // mov     [rsp+38h+var_10], rdx
        4C 8D 0D ?? ?? ?? ??  // lea     r9, aMni        ; "mni"
        48 8D 15 ?? ?? ?? ??  // lea     rdx, aCUsersPublicMw ; "C:\\Users\\Public\\mwt"
        48 89 54 24 20        // mov     [rsp+38h+var_18], rdx
        4C 8D 05 ?? ?? ?? ??  // lea     r8, aUolknProgram ; "UOLKN.Program"
        48 8B 01              // mov     rax, [rcx]
        48 8D 15 ?? ?? ?? ??  // lea     rdx, aCUsersPublicUo ; "C:\\Users\\Public\\UOLKN.dll"
        FF 50 58              // call    qword ptr [rax+58h]
        48 8B 4C 24 50        // mov     rcx, [rsp+38h+arg_10]
        48 8B 01              // mov     rax, [rcx]
        FF 50 10              // call    qword ptr [rax+10h]
        48 8B 4C 24 58        // mov     rcx, [rsp+38h+arg_18]
        48 8B 01              // mov     rax, [rcx]
        FF 50 10              // call    qword ptr [rax+10h]
        48 8B 4C 24 48        // mov     rcx, [rsp+48h]
        48 8B 01              // mov     rax, [rcx]
        FF 50 10              // call    qword ptr [rax+10h]
        33 C0                 // xor     eax, eax
        }
    condition:
        uint16(0) == 0x5A4D and
        uint32(uint32(0x3C)) == 0x00004550 and
        ($code and all of ($str*))
}

