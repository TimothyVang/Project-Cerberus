        $ = "%1[a-z] %2[A-Z] %3[.] ~ $%1.prototype.%2=function(){%3}"
        $ = "%1[a-z]{1,16} ~ throw Error(\"%1\")"
        $ = "%1[a-z] %2[a-z] ~ var %1=_.%2"
        $ = "%1[a-z]{2} %2[a-z]{2} %3[a-z]{2} ~ var %1=%2[%3]"
        $ = "%1[A-Za-z]{1,4} %2[A-Za-z]{1,4} ~ var %1,%2"
        $ = "%1[A-Za-z]{1,4} %2[A-Za-z]{1,4} %3[A-Za-z]{1,4} %4[A-Za-z]{1,4} ~ var %1,%2,%3,%4"
        $ = "%1[A-Za-z]{1,4} %2[A-Za-z]{1,4} %3[A-Za-z]{1,4} %4[A-Za-z]{1,4} %5[A-Za-z]{1,4} %6[A-Za-z]{1,4} ~ var %1,%2,%3,%4,%5,%6"
        $ = "%1[a-z]{2} %2[a-z]{2} ~ %1 in %2||(%2[%1]={})"
        $ = "%1[A-Za-z]{1,2} ~ _.%1=window"
        $ = "%1[A-Za-z]{1,2} ~ _.%1=window.document"
        $ = "%1[A-Za-z]{1,2} %2[A-Za-z]{1,2} ~ _.%1=_.%2.location"
        $ = "%1[a-z] ~ %1=%1.split(\".\")"
        $ = "%1[a-z] ~ %1=%1.split(\"/\")"
        $ = "%1[a-z] %2[0-9] %3[a-z] ~ %1[%2]in %3||!%3.execScript||%3.execScript(\"var \"+%1[%2])"
        $ = "%1[a-z]{2} %2[.] ~ _.%1=function(){%2}"
        $ = "%1[a-z]{2} %2[a-z] %3[a-z] %4[a-z] %5[.] ~ _.%1=function(%2,%3,%4){%5}"
        $ = "%1[a-z]{2} %2[a-z] %3[a-z] %4[a-z] %5[a-z]{3} %6[a-z]{2} ~ _.%1(%2,%3,%4,\"%5\"\"%6\")"
        $ = "%1[a-z] ~ if(!%1)throw Error()"
        $ = "%1[a-z] %2[A-Za-z]{2} %3[.] ~ if((%1=Object.create)&&_.%2.test(%1))%1=%1(null);else{%3}"
        $ = "%1[a-z] %2[a-z] %3[a-z] %4[a-z] %5[a-z] ~ if(%1[%2+\"EventListener\"])%1[%2+\"EventListener\"](%3,%4,!1);else if(%1[%5+\"tachEvent\"])%1[%5+\"tachEvent\"](\"on\"+%3,%4)"
        $ = "%1[a-z] %2[a-z]{3} %3[a-z] ~ %1.%2=!%3&&%1.%2||{}"
        $ = "%1[a-z] %2[a-z]{2} ~ if(!%1)return %2()"
        $ = "%1[a-z] %2[a-z]{2} %3[a-z] %4[a-z] %5[a-z] ~ for(var %1=%2(),%3=0,%4=%5.length;%1&&\"object\"===typeof %1&&%3<%4;++%3)%1=%1[%5[%3]]"
        $ = "%1[a-z] %2[a-z] %3[a-z] %4[a-z] %5[a-z] ~ for(var %1=0,%2=%3.length;%1<%2-1;++%1)var %4={},%5=%5[%3[%1]]=%4"
        $ = "%1[a-z]{2} ~ %1&&%1()"
        $ = "%1[a-z]{2} ~ %1()"
