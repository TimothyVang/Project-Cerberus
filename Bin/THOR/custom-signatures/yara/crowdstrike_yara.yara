        $variant_3 = { be 02 00 00 00 8d ?? 3c 8d [2] 00 00 00 00 e8 [4] 99 f7 ?? 83 ?? 1a 7d ?? 8d ?? 61 eb ?? 8d ?? 27 83 ?? 34 7c ?? 8d ?? fc 8b ?? 83 ?? 02 66 [4] 83 ?? 12 }
