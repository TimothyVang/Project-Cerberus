rule CrowdStrike_BlackMoon_Software_Development_Framework
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Binaries which use a software development framework / library called BlackMoon (https://github.com/zhongjianhua163/BlackMoonKernelStaticLib), popular among Chinese developers. The library is meant to be used with the Easy Programming Language (a.k.a. EPL, YiYuYan, or 易语言), as a replacement for EPL's standard library. Some open sources mistakenly identify BlackMoon as a family of malware, rather than a generic library that is sometimes used in malware."
        version = "202503111353"
        last_modified = "2025-03-11"
    strings:
        $BM_1 = "BlackMoon RunTime Error:"
        $BM_2 = "Mozilla/4.0 (compatible;"
        // The GB2312-encoded Chinese language string
        // "不支持系统功能函数%d. 请将此信息反馈给作者"
        // ("The system function with number %d is not supported. Please send this message to the author.")
        $BM_3 = { b2 bb d6 a7 b3 d6 cf b5 cd b3 b9 a6 c4 dc ba af ca fd 25 64 2e 20 c7 eb bd ab b4 cb d0 c5 cf a2 b7 b4 c0 a1 b8 f8 d7 f7 d5 df }
        /* Jump table present in the compiled `BlackMoonFuncForeLibNotifySys` function.
        3D01050080                    cmp eax, 0x80000501
        771F                          ja 0x4031a8
        7428                          je 0x4031b3
        3D01030080                    cmp eax, 0x80000301
        7421                          je 0x4031b3
        3D01040080                    cmp eax, 0x80000401
        741A                          je 0x4031b3
        */
        $BM_4 = {
        3D 01 05 00 80
        77 ??
        74 ??
        3D 01 03 00 80
        74 ??
        3D 01 04 00 80
        74 ??
        }
        /* Error message box with the string "blackmoon",
        present in the compiled `BlackMoonFuncForeLibNotifySys` function.
        50                 push    eax
        8D442430           lea     eax, [esp+0x30 {ErrorString}]
        6810E70010         push    0x1000e710
        50                 push    eax {ErrorString}
        FF1568C10010       call    dword [wsprintfA]
        83C40C             add     esp, 0xc
        8D4C242C           lea     ecx, [esp+0x2c {ErrorString}]
        6A10               push    0x10 {var_530}
        6804E70010         push    data_1000e704  {"blackmoon"}
        51                 push    ecx {ErrorString}
        6A00               push    0x0
        FF156CC10010       call    dword [MessageBoxA]
        33C0               xor     eax, eax
        */
        $BM_5 = {
        50
        8D 44 24 ??
        68 ?? ?? ?? ??
        50
        FF 15 ?? ?? ?? ??
        83 C4 0C
        8D 4C 24 ??
        6A 10
        68 ?? ?? ?? ??
        51
        6A 00
        FF 15 ?? ?? ?? ??
        33 C0
        }
    condition:
        uint16be(0) == 0x4D5A and 4 of them
}

