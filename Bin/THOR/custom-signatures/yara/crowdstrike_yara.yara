        $frmt1 = "%s%s_%c.vmx"
        $frmt2 = ".part%d.rar"
        $frmt3 = "%s\\%se%s.e%s"
        $frmt4 = "cmd.exe /c %s a -r -ad -v2G -y -hp%s %s"
        $ext1 = "%c:\\*.hw"
        $ext2 = "%c:\\*.doc*"
        $ext3 = "%c:\\*.xls*"
        $ext4 = "%c:\\*.pdf"
        $ext5 = "%c:\\*.amr"
        $ext6 = "%c:\\*.aac"
        $ext7 = "%c:\\*.ac3"
        $ext8 = "%c:\\*.m4a"
    condition:
        (2 of ($frmt*)) or (4 of ($ext*))
}

