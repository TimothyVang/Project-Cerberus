rule CrowdStrike_CSIT_22110_01 : bitwise_spider ecrime linux lock_bit_ransomware_linux_decryptor lockbit lockbit_ransomware_linux_decryptor ransomware unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings and code sequences used in the 64-bit (x64) build of the decryption tool for LockBit Linux ESXi ransomware developed by BITWISE SPIDER"
        reports = "CSIT-22110,CSIT-23303"
        version = "202309192217"
        last_modified = "2023-09-19"
        actor = "BITWISE SPIDER"
        malware_family = "LockBitRansomwareLinuxDecryptor"
    strings:
        /* String artifacts from static linking to Libsodium cryptographic
        library
        */
        $str_libsodium_0 = "LibsodiumDRG" wide ascii
        $str_libsodium_1 = "LibsodiumDRGsodium/core.c" wide ascii
        $str_prng_name = "randombytes_sysrandom_implementation" wide ascii
        $str_blake_hash = "blake2b" wide ascii
        /* Pass arguments to seek64() to find the beginning of
        the encrypted file footer in older versions or the file
        metadata in newer versions
        */
        $find_file_footer = {
        ba 02 00 00 00 48 c7 c6  (ac|ab) fe ff ff 89 [0-25] e8
        }
        $find_file_metadata = {
        ba 02 00 00 00 48 c7 c6  97 ff ff ff [2] e8
        }
        // Rename decrypted file to remove '.lockbit' file extension
        $rename_decrypted_file = {
        48 8d 50 f8 48 89 ee 48  89 df e8 [4] 48 89 de 48
        89 ef e8
        }
        /* _sprintf call sequence repeated to print the first 16
        bytes of the Curve25519 public and private keys from the
        configuration to the log
        */
        $sprintf_key_byte = {
        0f b6 15 [4] 48 8d [2] be  [4] 31 c0 e8
        }
        /* XOR decoding loop for individual encoded strings at
        initialization
        */
        $xor_decode_init = {
        89 ca 32 10 88 10 48 83  c0 01 84 d2 75 ?? b8 [4]
        0f 1f 44 00 00 89 ca 32  10 88 10 48 83 c0 01 84 d2 75
        }
        /* XOR decoding pattern repeated for multiple chunks of
        encoded strings
        */
        $xor_decode_string = {
        89 c1 32 0a 88 0a 48 83  c2 01 84 c9 75
        }
    condition:
        uint32(0) == 0x464c457f and
        (2 of ($str*) and 1 of ($xor*) and (1 of ($find_file_footer,$rename_decrypted_file) or (#sprintf_key_byte > 12))) or
        (#xor_decode_string > 5 and 1 of ($find_file_*))
}

