rule CrowdStrike_Dropper_Nitol : bot dropper nitol 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects a backdoored lpk.dll that drops a second stage Nitol payload from its resources. The matched strings are format strings used to infect archives and the backdoored exported functions"
        version = "202203040835"
        last_modified = "2022-03-04"
        malware_family = "Nitol"
    strings:
        $list_archive_files="cmd /c %s vb \"%s\" lpk.dll|find /i \"lpk.dll\"" wide
        $extract_archive="\"%s\" x \"%s\" *.exe \"%s\\\"" wide
        $infect_archive="\"%s\" a -r -ep1\"%s\" \"%s\" \"%s\\lpk.dll\"" wide
        $delete_temp_directory="cmd /c RD /s /q \"%s\""wide
    condition:
        all of them and uint16(0)==0x5a4d and pe.is_dll() and pe.number_of_resources>=2
        and pe.exports("LpkTabbedTextOut")
        and pe.exports("LpkDllInitialize")
        and pe.exports("LpkDrawTextEx")
        and pe.exports("LpkEditControl")
        and pe.exports("LpkExtTextOut")
        and pe.exports("LpkGetCharacterPlacement")
        and pe.exports("LpkGetTextExtentExPoint")
        and pe.exports("LpkInitialize")
        and pe.exports("LpkPSMTextOut")
        and pe.exports("LpkUseGDIWidthCache")
        and pe.exports("ftsWordBreak")
}

