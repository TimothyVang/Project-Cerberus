        $fmtstr15 = "Build ID: {0}\nDate: {1}\nFile Location: {2}\nUsername: {3}\nMachine Name: {4}\n"
        $fmtstr16 = "OS: {0}\nLanguage: {1}\nKeyboard Layout: {2}\nIs Evelated: {3}\n"
        $fmtstr17 = "CPU: {0}\nGPU: {1}\nGraphical Adapter: {2}\nScreen Resolution: {3}\nHWID: {4}\nClipboard Text: {5}\n"
        $fmtstr18 = "Host: {0}:{1}\x0d\nLogin: {2}\x0d\nPassword: {3}\x0d\n=====================================\x0d\n"
        $sysinfo01 = "SELECT * FROM Win32_Processor"
        $sysinfo02 = "SELECT * FROM Win32_VideoController"
        $sysinfo03 = "SELECT * FROM Win32_OperatingSystem"
        $sysinfo04 = "SOFTWARE\\Microsoft\\Cryptography"
