        $reconstruct = { e8 [4] (41 b8 ?? ?? ?? 00 48 8d 15 [4] 48 8d ?? ?? ?? ?? ?? | 48 8d [5] 48 8d 15 [4] 41 b8 ?? ?? ?? 00) e8}
        $aes = { ff ?? 48 8b [2-5] 41 ff ?? 48 8b [2-5] 33 d2 41 ff }
