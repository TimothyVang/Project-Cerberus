        0a 2d 2d 2d 2d 2d 45 4e 44 20 52 53 41 20 50 52
        49 56 41 54 45 20 4b 45 59 2d 2d 2d 2d 2d 0a }
    condition:
        uint16(0) == 0x5a4d and (
