        last_modified = "2023-01-06"
        actor = "MUMMY SPIDER"
        malware_family = "Emotet"
    strings:
        /*
        .text:00000001400087B7 66 83 38 53             cmp     word ptr [rax], 53h ; 'S'
        .text:00000001400087BB 75 1C                   jnz     short loc_1400087D9
        .text:00000001400087BD 66 83 78 02 4D          cmp     word ptr [rax+2], 4Dh ; 'M'
        .text:00000001400087C2 75 15                   jnz     short loc_1400087D9
        .text:00000001400087C4 66 83 78 04 54          cmp     word ptr [rax+4], 54h ; 'T'
        .text:00000001400087C9 75 0E                   jnz     short loc_1400087D9
        .text:00000001400087CB 66 83 78 06 50          cmp     word ptr [rax+6], 50h ; 'P'
        .text:00000001400087D0 75 07                   jnz     short loc_1400087D9
        .text:00000001400087D2 66 83 78 08 3A          cmp     word ptr [rax+8], 3Ah ; ':'
        .text:00000001400087D7 74 06                   jz      short loc_1400087DF
        */
        $proto_check = { 66 83 ?? 53 75 1c 66 83 ?? 02 4d 75 15 66 83 ?? 04 54 75 0e 66 83 ?? 06 50 75 07 66 83 ?? 08 3a 74 06 }
        /*
        .text:0000000140005AD1 D3 E2                   shl     edx, cl
        .text:0000000140005AD3 41 8B CB                mov     ecx, r11d
        .text:0000000140005AD6 D3 E0                   shl     eax, cl
        .text:0000000140005AD8 03 D0                   add     edx, eax
        .text:0000000140005ADA 41 0F BE C2             movsx   eax, r10b
        .text:0000000140005ADE 03 D0                   add     edx, eax
        .text:0000000140005AE0 41 2B D0                sub     edx, r8d
        .text:0000000140005AE3 49 FF C1                inc     r9
        */
        $hash_string = { d3 e2 41 8b cb d3 e0 03 d0 41 0f be c2 03 d0 41 2b d0 49 ff c1 }
    condition:
        uint16(0) == 0x5A4D and uint32(uint32(0x3C)) == 0x00004550 and
        $proto_check and $hash_string and filesize < 1MB
}

