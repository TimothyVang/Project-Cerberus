rule CrowdStrike_CSA_231356_01 : autoit dark_gate loader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Payload decryption bytes characteristic to AutoIt version of DarkGate Loader"
        reports = "CSA-231356"
        version = "202507032018"
        last_modified = "2025-07-03"
        malware_family = "DarkGate"
    strings:
        $au3 = "AU3!EA06"
        $key = /\|[a-zA-Z0-9+=]{64}\|/
    condition:
        $au3 and
        $key and
        // Ensure no repetition in the b64 alphabet
        for all i in (1..63): (
        for all j in (i + 1..64): (
        uint8(@key + i) != uint8(@key + j)
        )
        )
}

