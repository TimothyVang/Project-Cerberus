    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "This rule detects the keylogger component used by Vermin RAT."
        reports = "CSIT-18086"
        version = "201806010817"
        last_modified = "2018-06-01"
        malware_family = "Vermin"
    strings:
        $ = "Projects\\Vermin\\"
        $ = "Development\\Vermin\\"
        $ = "HtkSvcUtility.pdb"
        $ = "CenterServiceLib.pdb"
        $ = "VerminClientLib"
    condition:
        any of them
}

