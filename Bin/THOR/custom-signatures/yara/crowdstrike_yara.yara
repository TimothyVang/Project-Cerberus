rule CrowdStrike_UnnamedDelphiBasedDownloader_01 : delphi downloader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects a Delphi-based downloader that was distributed via a fake Microsoft Teams installer"
        version = "202302151559"
        last_modified = "2023-02-15"
    strings:
        /*
        mov   eax, dword ptr [ebp + 8]  ; 8B 45 08           .E.
        add   eax, 0xffffff00           ; 05 00 FF FF FF     .....
        lea   esi, [ebp - 0x109]        ; 8D B5 F7 FE FF FF  ......
        movzx edx, byte ptr [eax]       ; 0F B6 10           ...
        movzx ecx, dl                   ; 0F B6 CA           ...
        add   ecx, dword ptr [ebp - 8]  ; 03 4D F8           .M.
        */
        $rc4_sbox_offset = {
        8b 45 08
        05 00 ff ff ff
        8d b5 (f7 | f8) fe ff ff
        0f b6 10
        0f b6 (ca | da)
        03 (4d | 5d) f8
        }
        $ = "ThDownFile"
        $ = "ThCheck"
    condition:
        all of them
}

