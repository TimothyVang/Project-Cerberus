rule CrowdStrike_CSA_241297_01 : ecrime golang loader uuloader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings and code sequences used by an intermediate loader written in Go that deploys UULoader"
        reports = "CSA-241297,CSIT-24303"
        version = "202411222230"
        last_modified = "2024-11-22"
        malware_family = "UULoader"
    strings:
        // Connectivity test addresses
        $domain_0 = "www.baidu.com" ascii
        $domain_1 = "www.taobao.com" ascii
        $domain_2 = "im.qq.cominittrace" ascii
        // Command-line options used to validate proper flags
        $cmd_line_0 = "file" ascii
        $cmd_line_1 = "flag" ascii
        $cmd_line_2 = "mode" ascii
        $cmd_line_3 = "number" ascii
        // x86 cmp instructions using immediate values for the command-line flags being checked
        $flag_check_0 = { 81 39 66 69 6c 65 }
        $flag_check_1 = { 81 39 6d 6f 64 65 }
        $flag_check_2 = { 81 39 66 6c 61 67 }
        // Go function names for main namespace
        $func_0 = "main.main" ascii
        $func_1 = "main.ParseOptions" ascii
        $func_2 = "main.(*Options).validateOptions" ascii
        // Regex for pseudorandomly-generated function names
        $regex_func = /main\.[A-Za-z]{15,20}/ ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        (2 of ($func_*) or #regex_func > 1) and
        ((5 of ($cmd_line_*,$flag_check_*) and 1 of ($domain_*)) or (6 of ($cmd_line_*,$flag_check_*))) and
        filesize < 5MB
}

