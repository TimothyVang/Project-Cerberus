rule CrowdStrike_CSA_210872_01 : defray777 loader pyxie sprite_spider vatet 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects decoding loops and stage 2 path used by Vatet loaders compiled in trojanized builds of open-source Rufus bootable USB software"
        reports = "CSA-210872,CSA-211149,CSA-220202,CSA-220240"
        version = "202410151245"
        last_modified = "2024-10-15"
        actor = "SPRITE SPIDER"
        malware_family = "Vatet"
    strings:
        // decode loop using xmm registers to add and XOR 16 byte segments of the payload
        $xmm_decode_1 = {
        0f 10 [2-4] 66 0f ef c1 66  0f fc c2 66 0f ef c1 66
        0f fc c3 0f 11 [2-4] 83 ??  10 3b [1-2] 72
        }
        // decode loop using xmm registers to add and XOR 16 byte segments of the payload (December 2021)
        $xmm_decode_2 = {
        0f 10 [2-4] 66 0f f8 c1 66  0f ef c2 66 0f f8 c1 0f
        11 [2-4] 83 ?? 10 3b [1-2]  72
        }
        // single-byte XOR decode loop observed in samples in September 2021
        $xor_decode_1 = {
        8a [2-4] 80 ?? 53 80 ?? 0e  80 ?? 53 80 ?? 59 88 [2-4]
        4? 3b [1-2] 72
        }
        // single-byte XOR decode loop observed in samples from December 2021
        $xor_decode_2 = {
        8a [2-4] (2c 1c | 80 ?? 1c)  (34 93 | 80 f? 93) (2c 1c | 80 ?? 1c)
        88 [2-4] 4? 3b [1-2] 72
        }
        // single-byte XOR operation in decode loop observed in samples from March/April 2022
        $xor_decode_3 = {
        8b (0d | 15 | 3d | 35) [4] 03 [2-4]  0f b6 (01 | 02 | 06 | 07) 83 f0
        [1-4] 8b
        }
        // single-byte arithmetic operations in decode loop observed in samples from March/April 2022
        $arithmetic_1 = {
        8b (0d | 15 | 3d | 35) [4] 03 [2-4]  0f b6 (01 | 02 | 06 | 07)
        (83 e8 | 05) [1-4] 8b
        }
        // regex matching on the stage 2 payload file path
        $stage_2_path_regex = /c:\\windows\\[A-Za-z.\s_-]{3,}\\(rufus|options).(dat|ini)/ wide ascii
    condition:
        (1 of ($xmm_decode*) and 1 of ($xor_decode*)) or
        (1 of ($xor_decode*) and #arithmetic_1 > 1) or
        $stage_2_path_regex
}

