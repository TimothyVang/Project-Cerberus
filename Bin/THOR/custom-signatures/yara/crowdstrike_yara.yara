        a6 03 f9 57 76 57 4e 51 9c 53 5b 38 ff 00 e9 51
        3d ec ff 00 11 1a 98 06 af ae bf fa 4b 3f ff d9
        }
    condition:
        // 0x22f0 == size of decoy image; filesize must exceed this
        $jpeg_header at 0 and
