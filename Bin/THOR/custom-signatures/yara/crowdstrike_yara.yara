rule CrowdStrike_CSA_220242_02 : citriloader downloader labyrinth_chollima 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Detects byte sequences used to decode strings and C2 responses"
        reports = "CSA-220242,CSIT-22093"
        version = "202411121658"
        last_modified = "2024-11-12"
        actor = "LABYRINTH CHOLLIMA"
        malware_family = "CitriLoader"
    strings:
        /*
        66 0F 6F D8          movdqa  xmm3, xmm0
        66 0F DF DC          pandn   xmm3, xmm4
        66 0F 6F F4          movdqa  xmm6, xmm4
        66 41 0F DB C5       pand    xmm0, xmm13
        66 0F EB C3          por     xmm0, xmm3
        66 41 0F EF C7       pxor    xmm0, xmm15
        66 0F EB C2          por     xmm0, xmm2
        */
        $decode_sequence_0 = { 66 0f 6f d8 66 0f df dc 66 0f 6f f4 66 41 0f db c5 66 0f eb c3 66 41 0f ef c7 66 0f eb c2 }
        $embedded_openssl = "SSLv3 part of OpenSSL 1.0.2p-dev" ascii
        /*
        48 69 DB 67 66 66 66 imul    rbx, 66666667h
        48 89 DE             mov     rsi, rbx
        48 C1 EE 3F          shr     rsi, 3Fh
        48 C1 FB 22          sar     rbx, 22h
        */
        $decode_loop = { 48 69 db 67 66 66 66 48 89 de 48 c1 ee 3f 48 c1 fb 22 }
        /*
        45 31 F6             xor     r14d, r14d
        3D 90 CC 03 00       cmp     eax, 3CC90h
        41 0F 94 C6          setz    r14b
        */
        $c2_response_cmp = { 45 31 f6 3d 90 cc 03 00 41 0f 94 c6 }
    condition:
        uint16(0) == 0x5a4d and 2 of them and filesize > 1MB and filesize < 5MB
}

