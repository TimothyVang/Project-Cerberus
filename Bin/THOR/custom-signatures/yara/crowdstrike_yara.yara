        version = "202505020702"
        last_modified = "2025-05-02"
        actor = "LIGHTNING SPIDER"
        malware_family = "Apolog"
    strings:
        /* Script names involved in DLL search-order hijacking */
        $bat_0 = "logd.bat" ascii
        $bat_1 = "unlo.bat" ascii
        /* Application names bundled with MSI */
        $app_0 = "launcher.exe" ascii
        $app_1 = "coolplayer.exe" ascii
        /* Search-order hijack application names */
        $hijack_app_0 = "mksSandbox.exe" ascii
