rule CrowdStrike_CSA_231829_01 : b1ack_sniffer b1acksniffer b_1ack_sniffer formjacking 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Patterns found in B1ackSniffer"
        reports = "CSA-231829,CSA-240002,CSA-240445,CSA-250598,CSIT-24033,CSIT-24043"
        version = "202505211505"
        last_modified = "2025-05-21"
        malware_family = "B1ackSniffer"
    strings:
        $url_0_0       = "\"aHR0cH"
        $url_0_1       = "'aHR0cH"
        $url_0_2       = "#gateLink#"
        $url_1_0       = "`WyJ3c3M6"
        $url_1_1       = "'WyJ3c3M6"
        $url_1_2       = "\"WyJ3c3M6"
        $count_0       = "Math.random()"
        $cc_0          = "card"
        $cc_1          = "expiry"
        $cc_2          = "cvc"
        $cc_3          = "cvv"
        $html_base64_0 = "PCFET0NUWVBFIGh0bWw+"
        $messaging_0   = "setname | "
        $param_0_0     = "loc=\""
        $param_0_1     = "loc='"
        $param_0_2     = "loc=http"
        $param_1_0     = "data=\""
        $param_1_1     = "data='"
        $param_2_0     = "?link="
        $img_0         = "new Image"
        $img_1         = "IMG"
        $websocket_0   = "WebSocket("
        $v4_uniq_0 = "_handler"
        $v4_uniq_1 = "_card"
        $v4_uniq_2 = "_data"
        $v4_uniq_3 = "_Socket"
        $v4_uniq_4 = "token="
        $v4_uniq_5= "_otp"
        $v4_formjack_0 = "insertBefore"
        $v4_formjack_1 = "innerHTML"
        $v4_formjack_2 = "MutationObserver"
        $v4_formjack_3 = "querySelector"
        $v4_c2_0 = "SET_BANK_LOGO"
        $v4_c2_1 = "SET_CARD_LOGO"
        $v4_c2_2 = "OPEN_MODAL"
        $v4_c2_3 = "ALERT"
    condition:
        // b1ackSniffer Alpha
        (
        filesize < 256KB
        and 1 of ($url_0_*)
        and #count_0 == 1
        and $html_base64_0
        and (
        $html_base64_0
        or $messaging_0
        )
        and 3 of ($cc_*)
        )
        or (
        filesize < 256KB
        // b1ackSniffer V2.0
        and 1 of ($url_0_*)
        and 1 of ($param_0_*)
        and 1 of ($param_1_*)
        and 1 of ($img_*)
        )
        or (
        // b1ackSniffer V3.0
        filesize < 256KB
        and 1 of ($url_1_*) and
        1 of ($websocket_*) and
        1 of ($param_2_*)
        )
        // b1ackSniffer V4.0
        or (
        filesize < 512KB
        and 3 of ($cc_*)
        and 3 of ($v4_uniq_*)
        and 2 of ($v4_formjack_*)
        and 2 of ($v4_c2_*)
        )
}

