        // mov     cl, [eax]
        // inc     eax
        // test    cl, cl
        // jnz     strlen_loop
        // sub     eax, esi
        // lea     ecx, [eax-0Dh]
        // cmp     ecx, 6
        // ja      loc_40A465
        $luhn_len = {
        8A08 40 84C9 75F9 2BC6 8D48F3 83F906 0F87
        }
        // mov     eax, 66666667h
        // imul    ebx
        // sar     edx, 2
        // mov     eax, edx
