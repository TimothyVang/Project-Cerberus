        /*
        movsx   ecx, ax
        mov     eax, 66666667h
        imul    ebx
        sar     edx, 2
        mov     eax, edx
        mov     ebx, 4Eh ; 'N'
        shr     eax, 1Fh
        add     edx, eax
        mov     eax, esi
        sub     ecx, edx
        jo      loc_4118EB
        imul    eax, 3
        jo      loc_4118EB
        cdq
        idiv    ebx
        mov     eax, 92492493h
        */
        $string_decrypt = { 0f bf c8 b8 67 66 66 66 f7 eb c1 fa 02 8b c2 bb 4e 00 00 00 c1 e8 1f 03 d0 8b c6 2b ca 0f 80 58 02 00 00 6b c0 03 0f 80 4f 02 00 00 99 f7 fb b8 93 24 49 92 }
