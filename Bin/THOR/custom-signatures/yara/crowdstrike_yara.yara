        $decrypt_fn = { 8a 1c 07 2a d9 80 eb 0a 41 }
        $commands_1 = "RUN_STARTUP"
        $commands_2 = "RUN_REBOOT"
        $commands_3 = "RUN_DIRECT"
        $commands_4 = "UNINSTALL"
        $commands_5 = "UPLOAD"
        $c2_beacon = "%s?hostid=%s&hostname=%s&hostip=%s&filename=%s&filestart=%u&filetext="
