rule CrowdStrike_CSA_241297_02 : downloader ecrime unpacked uuloader 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings used by the main module UULoader DLL"
        reports = "CSA-241297,CSIT-24303"
        version = "202501132149"
        last_modified = "2025-01-13"
        malware_family = "UULoader"
    strings:
        /* Debug messages for UULoader scheduled task registration */
        $sch_dbg_0 = "Add Serice Success" wide
        $sch_dbg_1 = "SchRpcRegisterTask Error Code: %ld" wide
        /* RPC binding parameters to register scheduled task */
        $rpc_0 = "ncacn_np" wide
        $rpc_1 = "\\pipe\\atsvc" wide
        /* Scheduled task folder */
        $sch_folder_0 = "\\Microsoft\\Windows\\Mobile Broadbands Accounts" wide
        $sch_folder_1 = "\\Microsoft\\Windows\\Mobile AccountsUAC Broadband" wide
        $sch_folder_2 = "\\Microsoft\\Windows\\Mobile AccountsUAC Broadband2" wide
        $sch_folder_3 = "\\Microsoft\\Windows\\Shell\\MicrosoftEdgeUpTaskMachine" wide
        $sch_folder_4 = "Preference_shell" wide
        /* Custom named pipes */
        $pipe_0 = "\\\\.\\pipe\\vSDsGRFs62ghf" ascii
        $pipe_1 = "\\\\.\\pipe\\vsVSDDTGHGSy54" ascii
        /* Regular expression for concurrency pipe names */
        $pipe_2 = /\\\\.\\pipe\\[A-Za-z0-9]{20,24}/ ascii
        /* 360 Safeguard and Defender check names */
        $check_name_0 = "ZhuDongFangYu.exe" ascii
        $check_name_1 = "WinDefend" ascii
        /* Initialized strings that are not all used */
        $init_str_0 = "C:\\Program Files\\Windows Defenderr" ascii
        $init_str_1 = "miniobsmicrosvr.dll" ascii
        $init_str_2 = "fupol.tnk" ascii
        $init_str_3 = "404 Not F" ascii
        /* PDB path (represented in hexadecimal for non-english characters) */
        $pdb = {
        44 3a 5c e6 ba 90 e7 a0  81 5c 55 55 5c 52 65 6c
        65 61 73 65 5c 6c 69 62  2e 70 64 62 00
        }
        /* Exported function name */
        $export_0 = "fuckyou" ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        ($pdb and 2 of ($sch_dbg_*,$rpc_*) and (2 of ($pipe_*) or $pipe_2) and 5 of ($sch_folder_*,$check_name_*,$init_str_*,$export_*)) or
        (3 of ($sch_dbg_*,$rpc_*) and (2 of ($pipe_*) or $pipe_2) and 5 of ($sch_folder_*,$check_name_*,$init_str_*,$export_*))
}

