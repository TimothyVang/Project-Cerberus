        jb      short loc_405D50
        lea     eax, [edx+1]
        mov     [esi+10h], eax
        mov     eax, esi
        cmp     ebx, 10h
        jb      short loc_405D46
        mov     eax, [esi]
        mov     [eax+edx], cl
        mov     byte ptr [eax+edx+1], 0
        jmp     short loc_405D66
        push    1; size_t
        lea     eax, [ebp+var_11]
        mov     byte ptr [ebp+var_20], 0
        push    eax; int
        push    [ebp+var_20]; int
        mov     ecx, esi; Src
        push    1; int
        call    sub_405A30
        */
    strings:
        $hex_string = { 8b ?? ??
        8b c3
        8a ??
        8b ?? ??
        80 e9 05
        2b c2
        88 ?? ??
        83 f8 01
        72 ??
        8d ?? ??
        89 ?? ??
        8b c6
        83 fb 10
        72 ??
        8b ??
        88 ?? ??
        c6 ?? ?? ?? ??
        eb ??
        6a 01
        8d ?? ??
        c6 ?? ?? ??
        50
        ff ?? ??
        8b ce
        6a 01
        e8 ?? ?? ?? ?? }
    condition:
        $hex_string
}

