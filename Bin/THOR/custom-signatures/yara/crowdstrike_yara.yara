rule CrowdStrike_CSIT_24151_01 : dark_angels_locker ransomware rtm_ransomware unpacked 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings in ransomware based on Read the Manual (RTM) source code and used by Dark Angels Team"
        reports = "CSIT-24151"
        version = "202406141038"
        last_modified = "2024-06-14"
        malware_family = "DarkAngelsLocker"
    strings:
        /*
        Fake critical error message displayed for
        privilege escalation re-launch
        */
        $str_critical_error = "/c ECHO \"You must restart the program to resolve a critical error\" && start \"\" \"" ascii
        /* Batch delete command */
        $str_delete = "/c PING -n 5 127.0.0.1 > NUL && del \"" ascii
        /* Encryption constants */
        $str_chacha20_constant_0 = "expand 32-byte k" ascii
        $str_chacha20_constant_1 = "expand 16-byte k" ascii
        /*
        Log messages written to the console when the
        '-debug' flag is passed as a command line argument
        */
        $str_log_0 = "Calling GetSystemInfo..." wide
        $str_log_1 = "Loading hidden drives..." wide
        $str_log_2 = "Checking SSSE2..." wide
        $str_log_3 = "Making threads..." wide
        $str_log_4 = "Crypting files..." wide
        /* Log messages specific to DarkAngelsLocker variant */
        $str_mod_0 = "Win32_ShadowCopy.ID=" wide
        $str_mod_1 = " - example command line options" ascii
        $str_mod_2 = "nohyper Don't shutdown virtual mashines" ascii
        $str_mod_3 = "backup Don't rename crypted files and create note" ascii
        $str_mod_4 = "list Input file with folder/files for crypt" ascii
    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3c)) == 0x00004550 and
        3 of ($str_critical_error,$str_delete,$str_chacha20_constant_0,$str_chacha20_constant_1) and
        3 of ($str_log_*) and
        3 of ($str_mod_*)
}

