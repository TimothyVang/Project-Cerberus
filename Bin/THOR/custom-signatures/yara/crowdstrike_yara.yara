rule CrowdStrike_CSA_231125_01 : apolog ecrime installer msi 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Unique strings and MSI file format header from installers used to execute Apolog loader DLLs"
        reports = "CSA-231125"
        version = "202503111353"
        last_modified = "2025-03-11"
        malware_family = "Apolog"
    strings:
        /* Exported DLL name masquerading as legitimate
        OpenSSL toolkit library
        */
        $str_openssl = "ssleay32.dll" ascii
        /* DLL names used for Apolog DLL in the MSI
        CustomAction table
        */
        $str_dll_name_0 = "tool.dll" ascii
        $str_dll_name_1 = "updater.dll" ascii
        /* Exported function names called by MSI
        installer when loading the Apolog loader
        DLL
        */
        $str_exported_function_name_0 = "Riaoscxcivsjgihsdasf" ascii
        $str_exported_function_name_1 = "kksuifdgsiugsuigsehug" ascii
        $str_exported_function_name_2 = "Ijadifhaiughhauegae" ascii
        /* The MSI must contain at least one valid
        MZ header as the Apolog DLL is the minimum
        included payload
        */
        $mz_header = { 4d 5a }
    condition:
        uint32(0) == 0xe011cfd0 and uint32(0x4) == 0xe11ab1a1 and
        ((1 of ($str_dll_name_*) and $str_openssl) or any of ($str_exported_function_name_*)) and
        $mz_header and
        filesize < 2MB
}

