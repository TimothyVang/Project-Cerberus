rule CrowdStrike_CSIT_25075_01 : android spark_cat 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Bytecode instructions of the string descryption algorithm"
        reports = "CSIT-25075"
        version = "202503211132"
        last_modified = "2025-03-21"
        malware_family = "SparkCat"
    strings:
        $dex   = {  64 65 (78 | 79) 0A 30 ?? ?? 00 }
        $decryption_xor = {
        12 00                   // const/4             v0, 0
        21 41                   // array-length        v1, p0
        35 10 13 00             // if-ge               v0, v1, :2A
        48 01 04 00             // aget-byte           v1, p0, v0
        DC 02 00 10             // rem-int/lit8        v2, v0, 16
        1A 03 ?? ??             // const-string        v3, "0oO0@09322xIi1lL"
        6E 20 ?? ?? 23 00       // invoke-virtual      String->charAt(I)C, v3, v2
        0A 02                   // move-result         v2
        B7 21                   // xor-int/2addr       v1, v2
        8D 11                   // int-to-byte         v1, v1
        4F 01 04 00             // aput-byte           v1, p0, v0
        D8 00 00 01             // add-int/lit8        v0, v0, 1
        28 ??                   // goto
        }
    condition:
        $dex at 0 and
        $decryption_xor
}

