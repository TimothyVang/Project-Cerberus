        $string_2 = "MCC="
        $string_4 = "MNC="
        $string_5 = "BSSS="
        $string_6 = "(System)"
        $string_9 = "echo root"
        $string_10 = "yyyy-MM-dd HH:mm:ss"
        $string_11 = "version:"
        $string_12 = "wifi list:"
        $string_13 = "package:"
        $string_14 = "netgate:"
        $string_16 = "LD_LIBRARY_PATH=/vendor/lib:/system/lib pm install "
        $base64_1 = "DQpCcm93c2VyIGhpc3Rvcnk6DQo="  // "\r\nBrowser history:"
        $base64_2 = "ICAgIE1DQz0="                  // "    MCC="
        $base64_4 = "ICAgIE1OQz0="                  // "    MNC="
        $base64_5 = "ICAgIEJTU1M9"                  // "    BSSS="
        $base64_6 = "KFN5c3RlbSkNCg=="              // "(System)\r\n"
        $base64_7 = "L3N5c3RlbS9iaW4vc2g="          // "/system/bin/sh"
        $base64_8 = "Y29udGVudDovL3Ntcy"            // "content://sms[.*]"
        $base64_9 = "ZWNobyByb290"                  // "echo root"
        $base64_10 = "eXl5eS1NTS1kZCBISDptbTpzcw==" // "yyyy-MM-dd HH:mm:ss"
        $base64_11 = "dmVyc2lvbjo="                 // "version:"
        $base64_12 = "d2lmaSBsaXN0Og=="             // "wifi list:"
        $base64_13 = "cGFja2FnZTo="                 // "package:"
        $base64_14 = "bmV0Z2F0ZTo="                 // "netgate:"
        $base64_15 = "ZmlsZTovLw=="                 // "file://"
    condition:
        $dex_header at 0 and ((1 of ($uninstall_*)) or (8 of ($string_*) or 8 of ($base64_*)))
}

