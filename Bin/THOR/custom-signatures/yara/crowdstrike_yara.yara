rule CrowdStrike_CSIT_23233_01 : ecrime elf linux ransomware 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Ransomnote strings, directories, and seed generation instructions in IceFire ransomware"
        reports = "CSIT-23233"
        version = "202308160840"
        last_modified = "2023-08-16"
        malware_family = "IceFire"
    strings:
        $note_01 = "********************Your network has been infected!!!********************\n"
        $note_02 = "IMPORTANT : DO NOT DELETE THIS FILE UNTIL ALL YOUR DATA HAVE BEEN RECOVERED!!!\n"
        $note_03 = "All your important files have been encrypted."
        $note_04 = "Any attempts to restore your files with thrid-party software will be fatal for your files!"
        $note_05 = "Restore your data posible only buying private key from us."
        $note_06 = "We have also downloaded a lot of private data from your network."
        $note_07 = "If you do not contact us in a 5 days, we will post information about your breach on our public news webs.\n"
        $note_08 = "You should get more information on our page, which is located in a Tor hidden network.\n"
        $note_09 = "1.Download Tor browser - https://www.torproject.org/\n"
        $note_10 = "2.Install Tor browser\n"
        $note_11 = "3.Open link in Tor browser : "
        $note_12 = "4.Follow the instructions on this page\n"
        $note_13 = "Your account on our website\n"
        $note_14 = "*************************************************************************\n"
        $note_15 = "\nusername:\t"
        $note_16 = "\npassword:\t"
        $note_17 = "ATTENTION:\n"
        $note_18 = "1.Do not try to recover files yourself, this process can damage your data and recovery will become impossible.\n"
        $note_19 = "2.Do not waste time trying to find the solution on the internet. The longer you wait, the higher will become the decryption key price.\n"
        $note_20 = "3.Tor Browser may be blocked in your country or corporate network. Use Tor Browser over VPN."
        $dir_01 = "./boot"
        $dir_02 = "./dev"
        $dir_03 = "./etc"
        $dir_04 = "./lib"
        $dir_05 = "./proc"
        $dir_06 = "./srv"
        $dir_07 = "./sys"
        $dir_08 = "./usr"
        $dir_09 = "./var"
        $dir_10 = "./run"
        $rsa_key_01 = "-----BEGIN RSA PUBLIC KEY-----"
        $rsa_key_02 = "-----END RSA PUBLIC KEY-----"
        $random_seed_1_0  = { 48 83 c0 0f 0f b6 00 0f b6 c0 }
        $random_seed_1_8  = { 48 83 c0 0b 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 08 }
        $random_seed_1_16 = { 48 83 c0 07 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 10 }
        $random_seed_1_24 = { 48 83 c0 03 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 18 }
        $random_seed_2_0  = { 48 83 c0 1f 0f b6 00 0f b6 c0 }
        $random_seed_2_8  = { 48 83 c0 1b 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 08 }
        $random_seed_2_16 = { 48 83 c0 17 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 10 }
        $random_seed_2_24 = { 48 83 c0 13 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 18 }
        $random_seed_3_0  = { 48 83 c0 1d 0f b6 00 0f b6 c0 }
        $random_seed_3_8  = { 48 83 c0 15 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 08 }
        $random_seed_3_16 = { 48 83 c0 0d 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 10 }
        $random_seed_3_24 = { 48 83 c0 05 0f b6 00 0f b6 c0 (c1 e0|89 c2 c1 e2) 18 }
    condition:
        uint32(0) == 0x464c457f
        and all of ($rsa_key_*)
        and (
        15 of ($note_*)
        or 9 of ($dir_*)
        or all of ($random_seed_*)
        )
        and filesize < 4MB
}

