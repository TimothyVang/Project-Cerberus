        version = "202204080829"
        last_modified = "2022-04-08"
        malware_family = "Prorock"
    strings:
        // C:\USERS\PUBLIC\
        $ = { 43003a005c00550053004500520053005c005000550042004c00490043005c00 }
        // https://cld.pt/dl/download/
        $ = { 680074007400700073003a002f002f0063006c0064002e00700074002f0064006c002f0064006f0077006e006c006f00610064002f00 }
        $ = { 72 [4] 72 [4] 16 28 [4] 1f 0a 28 [4] 6f [4] 00 1f 6e 28 [4] 00 72 }
