rule CrowdStrike_CSA_240403_02 : stonestop 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "STONESTOP distinctive log strings, device names and IOCTL codes"
        reports = "CSA-240403,CSA-241476,CSIT-24270"
        version = "202507092256"
        last_modified = "2025-07-09"
        malware_family = "STONESTOP"
    strings:
        $auth_code_1 = "ED AD FG HG GF TR SY UT GH NG GT" wide
        $auth_code_2 = "HG GF TR SY UT GH NG GT" wide
        $auth_code_3 = "AC DY LR UI KD MU YD VX ER TY UI OP AS DF GH JK" wide
        $auth_code_4 = "7N6bCAoECbItsUR5-h4Rp2nkQxybfKb0F-wgbJGHGh20pWUuN1-ZxfXdiOYps6HTp0X" wide
        $failure_1 = "Failed to connect kernel driver!"
        $failure_2 = "Failed to connect driver!"
        $log = "System Error"
        $device_name_1 = "\\\\.\\kdHelperDriverLink"
        $device_name_2 = "\\\\.\\KApcHelperLink1"
        $device_name_3 = "\\\\.\\Pu2h9rH7G5"
        $ioctl_code_kill_proc = { 94 20 22 00 e8 }
        $ioctl_code_kill_drv = { 84 21 22 00 e8 }
        $ioctl_code_copy_file = { 8c 21 22 00 e8 }
        $ioctl_code_auth = { 88 20 22 00 e8 }
        $log_string_1 = "[*] Destroy driver all system thread [%ws]:" wide
        $log_string_2 = "[*] Destroy driver dispatch func [%ws]:" wide
        $log_string_3 = "[*] Destroy driver ability [%ws]:" wide
        $log_string_4 = "[*] Copy file [%ws] to [%ws]:" wide
        $log_string_5 = "[*] Kill process [%ws]:" wide
        $log_string_6 = "[*] Delete file [%ws]:" wide
    condition:
        uint16(0) == 0x5A4D and (
        3 of ($ioctl_code*) or
        any of ($auth_code*) or
        ($log and any of ($failure*)) or
        any of ($device_name*) or
        3 of ($log_string*)
        )
}

