    condition:
        uint16(0) == 0x5A4D and uint32(uint32(0x3C)) == 0x00004550 and
        ((uint16(uint32(0x3c)+24) == 0x010b and int32(uint32(0x3c)+232) > 0) or // Mono/.NET 64bit
        (uint16(uint32(0x3c)+24) == 0x020b and int32(uint32(0x3c)+248) > 0)) and // Mono/.NET 64bit
