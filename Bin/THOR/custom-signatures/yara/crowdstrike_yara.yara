rule CrowdStrike_CSIT_23026_01 : ransomware royal royal_ransomware royal_spider 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Patterns found in Royal Ransomware"
        reports = "CSA-230891,CSA-240350,CSIT-23026"
        version = "202505220631"
        last_modified = "2025-05-22"
        actor = "ROYAL SPIDER"
        malware_family = "RoyalRansomware"
    strings:
        $esxi_id            = "-id"                             ascii wide
        $esxi_ext           = ".royal"                          ascii wide
        $esxi_arg_0         = "-stopvm"                         ascii wide
        $esxi_arg_1         = "-vmonly"                         ascii wide
        $windows_name       = "royal"                           ascii wide
        $windows_const_0    = {b9 07 a2 25}                     // WSAID_CONNECTEX
        $windows_const_1    = {f3 dd 60 46}                     // WSAID_CONNECTEX
        $windows_const_2    = {8e e9 76 e5}                     // WSAID_CONNECTEX
        $windows_const_3    = {8c 74 06 3e}                     // WSAID_CONNECTEX
        $windows_const_4    = {06 00 00 c8}                     // SIO_GET_EXTENSION_FUNCTION_POINTER
        $common_private_key = "-----BEGIN RSA PRIVATE KEY-----" ascii wide
        $common_pub_key_0   = "-----BEGIN PUBLIC KEY-----"      ascii wide
        $common_pub_key_1   = "-----BEGIN RSA PUBLIC KEY-----"  ascii wide
        $windows_exclude_0 = "HOLA_TRAY_CONTEXT"                ascii wide
    condition:
        filesize < 5MB
        and (
        // Windows
        uint16(0) == 0x5a4d
        and uint32(uint32(0x3c)) == 0x00004550
        and $windows_name
        and all of ($windows_const_*)
        and 1 of ($common_pub_key_*)
        and not $common_private_key
        and not $windows_exclude_0
        ) or
        (
        // ESXI
        uint32(0) == 0x464c457f
        and $esxi_id
        and $esxi_ext
        and 1 of ($esxi_arg_*)
        and not $common_private_key
        )
}

