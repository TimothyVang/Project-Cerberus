rule CrowdStrike_CSIT_25082_09 : blossom_spy panda 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Formatstrings used for JSON payloads and log messages in the BlossomSpy monitoring tool"
        reports = "CSIT-25082"
        version = "202503280920"
        last_modified = "2025-03-28"
        malware_family = "BlossomSpy"
    strings:
        $json_fmt_01 = "{\"ip\":\"%s\",\"mac\":\"%02X:%02X:%02X:%02X:%02X:%02X\",\"cpu\":\"%s,%u\",\"totalMem\":%u,\"freeMem\":%u,\"dirPath\":\"%s,%s\",\"uname\":\"%s\"}"
        $json_fmt_02 = "{\"ip\":\"%s\",\"mac\":\"%02X:%02X:%02X:%02X:%02X:%02X\"}"
        $json_fmt_03 = "{\"ip\":\"%s\",\"mac\":\"%02X:%02X:%02X:%02X:%02X:%02X\",\"fileMd5\":\"%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X\",\"fileName\":\"%s\",\"processName\":\"%s\",\"processParams\":\"%s\",\"selfDelete\":%d}"
        $usage = "Usage: %s [-d] [-n] [-h SERVER_IP] [-p SERVER_PORT][-m MONITOR_INTERVAL(s)][-b BOOT_TIME(s)]"
        $log_01 = "server ip: %s\n"
        $log_02 = "server port: %s\n"
        $log_03 = "monitor interval: %s(s)\n"
        $log_04 = "Invalid monitor interval '%s'\n"
        $log_05 = "boot time: %s(s)\n"
        $log_06 = "Invalid boot time '%s'\n"
        $log_07 = "log level: %s\n"
        $log_08 = "log type: %s\n"
        $log_09 = "log path: %s\n"
    condition:
        uint32(0) == 0x464c457f and (all of ($json_fmt*) or 7 of ($log_*, $usage))
}

