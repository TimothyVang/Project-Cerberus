rule CrowdStrike_CSIT_25121_01 : android scan_spy 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Identify strings from the modified internal service class that was forked from the ScanSpy malware family"
        reports = "CSIT-25121"
        version = "202506061538"
        last_modified = "2025-06-06"
        malware_family = "ScanSpy"
    strings:
        $dex   = {  64 65 (78 | 79) 0A 30 ?? ?? 00 }
        $method1 = "createVictimIntoClient"
        $method2 = "getDeviceInfo"
        $method3 = "getPhoneContact"
        $method4 = "scanDirectories"
        $method5 = "processFile"
        $method6 = "getScanPaths"
        $method7 = "disableSSLVerification"
        $method8 = "processFilesInDirectory"
        $method9 = "scanDirectory"
        $method10 = "getScanPaths"
        $scan_dir1 = "DIRECTORY_RECORDINGS"
        $scan_dir2 = "DIRECTORY_DCIM"
        $scan_dir3 = "DIRECTORY_DOWNLOADS"
        $scan_dir4 = "DIRECTORY_PICTURES"
        $scan_dir5 = "DIRECTORY_SCREENSHOTS"
        $scan_dir6 = "DIRECTORY_DOCUMENTS"
        $extension1 = ".pdf"
        $extension2 = ".doc"
        $extension3 = ".docx"
        $extension4 = ".xls"
        $extension4x = ".xlsx"
        $extension5 = ".ppt"
        $extension6 = ".xlsx"
        $extension7 = ".txt"
        $extension8 = ".jpg"
        $extension9 = ".jpeg"
        $extension10 = ".png"
        $extension11 = ".pptx"
        $extension12 = ".aac"
        $extension13 = ".amr"
        $uri = "SERVER_URI" fullword
        $log_string = "upload_file_nm" fullword
        $end_path = "public/commands.php"
    condition:
        $dex at 0
        and
        (   (
        4 of ($method*) and
        4 of ($scan_dir*)
        )
        or
        (
        2 of ($uri, $end_path, $log_string)
        )
        )
        and (8 of ($extension*)
        ) // condition to exclude RafelRat variantss
}

