        $dex = { 64 65 (78 | 79) 0A 30 ?? ?? 00 }
        $decrypt_routine = {
        // Key v6 = (Key)Someclass.someFunc();
        71 00 ?? ?? 00 00 0C ?? 1F ?? ?? ?? [0-1024]
        // Cipher v8 = SomeClasss2.someFunc2(virtual "AES/CBC/NoPadding")
        22 ?? ?? ?? 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 13 ?? ?? 00 02 00 ?? 00 23 00 ?? ?? 08 ?? 00 00 26 ?? ?? ?? 00 00 13 ?? 11 00 77 02 ?? ?? ?? 00 0C ?? 76 ?? ?? ?? ?? 00 (71 | 77) ?? ?? ?? ?? 00 0C ?? [0-1024]
        // new ByteArrayInputStream
        22 ?? ?? ?? 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 76 02 ?? ?? ?? 00 [0-1024]
        // new CipherInputStream
        22 ?? ?? ?? 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 76 03 ?? ?? ?? 00 [0-1024]
        // New DataInputStream
        22 ?? ?? ?? 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 08 ?? ?? 00 76 02 ?? ?? ?? 00
        }
