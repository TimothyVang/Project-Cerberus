        $regdem = "reg delete"
        $k1 = "Software\\Microsoft\\Windows Defender\\Features" nocase
        $k2 = "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System" nocase
        $k3 = "System\\CurrentControlSet\\Control\\WMI\\Autologger" nocase
        $k4 = "Software\\Policies\\Microsoft\\Windows Defender\\" nocase
        $f1 = "DisableAntiSpyware"
        $f2 = "DisableAntiVirus"
        $f3 = "MpEnablePus"
        $f4 = "DisableBehaviorMonitoring"
        $f5 = "DisableIOAVProtection"
        $f6 = "DisableOnAccessProtection"
        $f7 = "DisableRealtimeMonitoring"
        $f8 = "DisableScanOnRealtimeEnable"
        $f9 = "DisableEnhancedNotifications"
        $f10 = "DisableBlockAtFirstSeen"
        $f11 = "SpynetReporting"
        $f12 = "SubmitSamplesConsent"
        $f13 = "TamperProtection"
        $f14 = "ConsentPromptBehaviorAdmin"
        $st1 = "ExploitGuard\\ExploitGuard MDM policy Refresh"
        $st2 = "Windows Defender\\Windows Defender Cache Maintenance"
        $st3 = "Windows Defender\\Windows Defender Cleanup"
        $st4 = "Windows Defender\\Windows Defender Scheduled Scan"
        $st5 = "Windows Defender\\Windows Defender Verification"
        $lg1 = "WMI\\Autologger\\DefenderApiLogger"
        $lg2 = "WMI\\Autologger\\DefenderAuditLogger"
        $sc1 = "Services\\WdBoot"
        $sc2 = "Services\\WdFilter"
        $sc3 = "Services\\WdNisDrv"
