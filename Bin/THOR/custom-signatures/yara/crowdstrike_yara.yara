        $s6 = "WARNING: Wipe incomplete for %s: %d of %d files wiped (%.2f%%)\n"
        $s7 = "System will restart even though %d drives were not fully wiped. See %s for details.\n"
        $s8 = "\n\nOperation completed in: %v\n"
    condition:
        uint16(0) == 0x5a4d and
        (
        all of ($s*) or
        7 of ($f*) or
        (4 of ($s*) and 4 of ($f*))
        ) and
        filesize > 2MB
}

