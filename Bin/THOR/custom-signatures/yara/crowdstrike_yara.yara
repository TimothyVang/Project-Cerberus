        $u3 = "desktop-ajk2cbn" ascii
        $u4 = "desktop-lcm5qsr" ascii
        $p3 = "C:\\Users\\test.SERVER\\Desktop\\" wide
        $t1 = { e7 dd ac d5 01 }
