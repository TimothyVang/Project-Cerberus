rule CrowdStrike_CSA_250245_01 : ecrime friezer_crypto_stealer friezercryptostealer lightning_spider powershell 
{
    meta:
        copyright = "(c) 2025 CrowdStrike Inc."
        description = "Strings, cmdlets, and byte arrays included in the deobfuscated final stage PowerShell installer script"
        reports = "CSA-250245"
        version = "202502280944"
        last_modified = "2025-02-28"
        actor = "LIGHTNING SPIDER"
        malware_family = "FriezerCryptoStealer"
    strings:
        /* PowerShell cmdlets and functions */
        $ps_hmacsha256 = "System.Security.Cryptography.HMACSHA256" wide
        $ps_base64 = "[System.Convert]::FromBase64String(" wide
        $ps_dirname = "[System.IO.Path]::GetDirectoryName(" wide
        $ps_json = "| ConvertFrom-Json" wide
        $ps_text = "[System.Text.Encoding]::UTF8.GetString(" wide
        /* Error flags for process iteration */
        $err_flags_0 = "-ErrorAction SilentlyContinue" wide
        $err_flags_1 = "-MemberType Property -ErrorAction SilentlyContinue" wide
        /* Browser process restart commands */
        $browser_start_0 = "Start-Sleep -Seconds 3" wide
        $browser_start_1 = "Start-Process -FilePath" wide
        /* Pseudorandom directory name length constraint */
        $dirname_len = "Get-Random -Minimum 8 -Maximum 17" wide
        /* %LOCALAPPDATA% environment specifier */
        $env_localappdata = "$Env:LOCALAPPDATA -ChildPath" wide
        /* Byte arrays for browser profile paths */
        $profile_path_chrome = "( 71, 111, 111, 103, 108, 101, 92, 67, 104, 114, 111, 109, 101, 92, 85, 115, 101, 114, 32, 68, 97, 116, 97 )" wide
        $profile_path_brave = "( 66, 114, 97, 118, 101, 83, 111, 102, 116, 119, 97, 114, 101, 92, 66, 114, 97, 118, 101, 45, 66, 114, 111, 119, 115, 101, 114, 92, 85, 115, 101, 114, 32, 68, 97, 116, 97 )" wide
        $profile_path_edge = "( 77, 105, 99, 114, 111, 115, 111, 102, 116, 92, 69, 100, 103, 101, 92, 85, 115, 101, 114, 32, 68, 97, 116, 97 )" wide
        $profile_path_opera = "( 79, 112, 101, 114, 97, 32, 83, 111, 102, 116, 119, 97, 114, 101, 92, 79, 112, 101, 114, 97, 32, 83, 116, 97, 98, 108, 101 )" wide
    condition:
        all of ($ps_*,$err_flags_*,$browser_start_*,$dirname_len,$env_localappdata)
        and 2 of ($profile_path_*)
        and filesize < 3MB
}

